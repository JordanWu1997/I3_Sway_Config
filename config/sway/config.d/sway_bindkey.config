# ~/.config/sway/config.d/sway_bindkey.config
# vim: ft=swayconfig ff=unix
# ======================================================================================
# All About Bindkeys
# ======================================================================================
# This is to save all bindkeys of programs

# Reload this configuration file
bindsym Mod4+r reload
# [SWAY] sway has no in-place 'restart' (i3 re-exec). 'reload' re-reads the config and
#        re-runs every exec_always line, which is the closest equivalent.
bindsym Mod4+Shift+r reload

# Common program shortcut
# 1 - Text Editor: neovim [Installation: dnf install neovim]
bindsym Ctrl+Mod1+1       exec $SWAY_SCRIPT/sway_run.sh $terminal -- nvim
bindsym Ctrl+Mod1+Shift+1 exec $SWAY_SCRIPT/sway_terminal_operator.sh attach_to_tmux_session nvim floating
# 2 - File Manager (TUI): ranger [Installation: dnf install ranger]
bindsym Ctrl+Mod1+2       exec $SWAY_SCRIPT/sway_run.sh $terminal -- ranger
bindsym Ctrl+Mod1+Shift+2 exec $SWAY_SCRIPT/sway_terminal_operator.sh attach_to_tmux_session ranger floating
# 3 - Media: pulsemixer [Installation: pip install pulsemixer]
bindsym Ctrl+Mod1+3       exec $SWAY_SCRIPT/sway_run.sh $terminal -- pulsemixer
bindsym Ctrl+Mod1+Shift+3 exec $SWAY_SCRIPT/sway_run.sh $terminal --class floating_terminal -- pulsemixer
# 4 - System Monitor: htop [Installation: dnf install htop]
bindsym Ctrl+Mod1+4       exec $SWAY_SCRIPT/sway_run.sh $terminal -- htop
bindsym Ctrl+Mod1+Shift+4 exec $SWAY_SCRIPT/sway_run.sh $terminal --class floating_terminal -- htop
# 5 - Networkmanager TUI: nmtui [Bundled with NetworkManager]
bindsym Ctrl+Mod1+5       exec $SWAY_SCRIPT/sway_run.sh $terminal -- nmtui
bindsym Ctrl+Mod1+Shift+5 exec $SWAY_SCRIPT/sway_run.sh $terminal --class floating_terminal -- nmtui
# 6 - Visualizer: cava [Installation: dnf install cava]
bindsym Ctrl+Mod1+6       exec $SWAY_SCRIPT/sway_run.sh $terminal -- cava
bindsym Ctrl+Mod1+Shift+6 exec $SWAY_SCRIPT/sway_run.sh $terminal --class floating_terminal -- cava
# 7 - Music Steamer (TUI): spt (spotify TUI front-end)
#bindsym Ctrl+Mod1+7       exec $SWAY_SCRIPT/sway_run.sh $terminal -- spotify_tui.sh
#bindsym Ctrl+Mod1+Shift+7 exec $SWAY_SCRIPT/sway_run.sh $terminal --class floating_terminal -- spotify_tui.sh
# 7 - Nvidia GPU Monitor: nvtop [Installation: dnf install nvtop]
bindsym Ctrl+Mod1+7       exec $SWAY_SCRIPT/sway_run.sh $terminal -- nvtop
bindsym Ctrl+Mod1+Shift+7 exec $SWAY_SCRIPT/sway_run.sh $terminal --class floating_terminal -- nvtop
# 8 - PDF Viewer: zathura [Installation: dnf install zathura]
bindsym Ctrl+Mod1+8 exec zathura
# 9 - Bluetooth Manager: blueman [Installation: dnf install blueman]
bindsym Ctrl+Mod1+9 exec blueman-manager
# 0 - File Manager (GUI): neutilus [Installation: dnf install nautilus]
bindsym Ctrl+Mod1+0 exec nautilus
# - (minus) - Web Browser: brave-browser (google-chromium based)
bindsym Ctrl+Mod1+minus exec brave-browser
# = (equal) - Web Browser: firefox
bindsym Ctrl+Mod1+equal exec firefox

# Use pactl to adjust volume in PulseAudio.
# -- For advanced modification, check pulsemixer or alsamixer
bindsym XF86AudioMicMute          exec pactl set-source-mute @DEFAULT_SOURCE@ toggle && $I3_SCRIPT/i3_pulseaudio_notification.sh source
bindsym XF86AudioMute             exec pactl set-sink-mute @DEFAULT_SINK@ toggle && $I3_SCRIPT/i3_pulseaudio_notification.sh
bindsym Ctrl+XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +1% && $I3_SCRIPT/i3_pulseaudio_notification.sh
bindsym Ctrl+XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -1% && $I3_SCRIPT/i3_pulseaudio_notification.sh
bindsym XF86AudioRaiseVolume      exec pactl set-sink-volume @DEFAULT_SINK@ +5% && $I3_SCRIPT/i3_pulseaudio_notification.sh
bindsym XF86AudioLowerVolume      exec pactl set-sink-volume @DEFAULT_SINK@ -5% && $I3_SCRIPT/i3_pulseaudio_notification.sh
bindsym Mod1+XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +10% && $I3_SCRIPT/i3_pulseaudio_notification.sh
bindsym Mod1+XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -10% && $I3_SCRIPT/i3_pulseaudio_notification.sh

# Media player control
bindsym XF86AudioPlay        exec playerctl play-pause && $I3_SCRIPT/i3_MPRIS_notification.sh
bindsym XF86AudioPause       exec playerctl play-pause && $I3_SCRIPT/i3_MPRIS_notification.sh
bindsym Shift+XF86AudioPause exec playerctl stop
bindsym XF86AudioStop        exec playerctl stop
bindsym XF86AudioNext        exec playerctl next && $I3_SCRIPT/i3_MPRIS_notification.sh
bindsym XF86AudioPrev        exec playerctl previous && $I3_SCRIPT/i3_MPRIS_notification.sh
## Media player control for spt (spotify TUI front-end)
#bindsym Ctrl+XF86AudioPlay  exec playerctl -p $(spt playback -f %d) play-pause
#bindsym Ctrl+XF86AudioPause exec playerctl -p $(spt playback -f %d) play-pause
#bindsym Ctrl+XF86AudioStop  exec playerctl -p $(spt playback -f %d) stop
#bindsym Ctrl+XF86AudioNext  exec playerctl -p $(spt playback -f %d) next
#bindsym Ctrl+XF86AudioPrev  exec playerctl -p $(spt playback -f %d) previous
# Media player control for vlc
bindsym Mod1+XF86AudioPlay  exec playerctl -p vlc play-pause
bindsym Mod1+XF86AudioPause exec playerctl -p vlc play-pause
bindsym Mod1+XF86AudioStop  exec playerctl -p vlc stop
bindsym Mod1+XF86AudioNext  exec playerctl -p vlc next
bindsym Mod1+XF86AudioPrev  exec playerctl -p vlc previous
# Media player control for all players
bindsym Ctrl+Mod1+XF86AudioPlay       exec playerctl -a play-pause
bindsym Ctrl+Mod1+Shift+XF86AudioPlay exec playerctl -a stop
bindsym Ctrl+Mod1+XF86AudioStop       exec playerctl -a stop

# Screen backlight control (xbacklight -> brightnessctl inside sway_backlight_operator.sh;
# subcommand names keep the historical *_xbacklight spelling)
# -- https://github.com/alberto-santini/i3-configuration-x1
# -- https://askubuntu.com/questions/715306/xbacklight-no-outputs-have-backlight-property-no-sys-class-backlight-folder
bindsym Ctrl+XF86MonBrightnessDown exec $SWAY_SCRIPT/sway_backlight_operator.sh dec_xbacklight 1
bindsym Ctrl+XF86MonBrightnessUp   exec $SWAY_SCRIPT/sway_backlight_operator.sh inc_xbacklight 1
bindsym XF86MonBrightnessDown      exec $SWAY_SCRIPT/sway_backlight_operator.sh dec_xbacklight 5
bindsym XF86MonBrightnessUp        exec $SWAY_SCRIPT/sway_backlight_operator.sh inc_xbacklight 5
bindsym Mod1+XF86MonBrightnessDown exec $SWAY_SCRIPT/sway_backlight_operator.sh dec_xbacklight 10
bindsym Mod1+XF86MonBrightnessUp   exec $SWAY_SCRIPT/sway_backlight_operator.sh inc_xbacklight 10

# Rofi selector [can be configured in $HOME/.config/rofi/*]
# Application/Executable selector
bindsym Mod4+d       exec $SWAY_SCRIPT/sway_run.sh rofi -show drun -terminal $terminal
bindsym Mod4+Shift+d exec $SWAY_SCRIPT/sway_run.sh rofi -show run -terminal $terminal
# Window selector (window, GNOME application selector keybinding compatibility)
# [SWAY] rofi's X11 'window'/'windowcd' modi read X window lists, which only show XWayland
#        windows under sway. sway_window_switcher.sh builds the list from 'swaymsg -t get_tree'
#        (native + XWayland windows). Window thumbnails are not available on Wayland.
bindsym Mod1+Tab       exec $SWAY_SCRIPT/sway_window_switcher.sh all
bindsym Mod1+Shift+Tab exec $SWAY_SCRIPT/sway_window_switcher.sh all
# Window selector (windowcd: windows of the same application as the focused one)
bindsym Mod1+q       exec $SWAY_SCRIPT/sway_window_switcher.sh same_app
bindsym Mod1+Shift+q exec $SWAY_SCRIPT/sway_window_switcher.sh same_app
# Scratchpad selector
bindsym Ctrl+Mod1+Tab exec $SWAY_SCRIPT/sway_scratchpad_operator.sh select
bindsym Ctrl+Mod1+z   exec $SWAY_SCRIPT/sway_scratchpad_operator.sh select
# File browser
bindsym Ctrl+Mod1+d exec $SWAY_SCRIPT/sway_run.sh rofi -modi filebrowser -show filebrowser -auto-select -terminal $terminal
# Omni-search w/ rofi
bindsym Mod4+backslash exec $SWAY_SCRIPT/sway_rofi_omnisearch.sh
# Keybinding help (Super+?): omnisearch Keybindings page
bindsym Mod4+Shift+slash exec $SWAY_SCRIPT/sway_rofi_omnisearch.sh --keybindings
# Rofi bindkey hinter
bindsym Ctrl+Mod1+Shift+slash exec $SWAY_SCRIPT/sway_run.sh rofi -modi keys -show keys -config "$HOME/.config/rofi/config_singlecol.rasi" -i -terminal $terminal

# Vim clipboard Manager, requires following vim plug-in
# -- https://github.com/vim-scripts/YankRing.vim
# -- https://github.com/szw/vim-maximizer
bindsym Ctrl+Mod1+slash exec $SWAY_SCRIPT/sway_run.sh $terminal --class floating_terminal -- nvim -c :YRShow -c :Maximize

# Interactive python Shell for handful calculator
bindsym Ctrl+Mod1+backslash exec $SWAY_SCRIPT/sway_run.sh $terminal --class floating_terminal -- ipython3

# Extra miscellaneous keybindings for X window system (mostly special keys on laptop)
bindsym XF86Tools      exec $SWAY_SCRIPT/sway_run.sh $terminal
bindsym XF86Display    exec wdisplays
bindsym XF86Favorites  exec nautilus
bindsym XF86Calculator exec gnome-calculator
bindsym XF86Mail       exec mailspring
bindsym XF86Explorer   exec brave-browser
bindsym XF86Search     exec $SWAY_SCRIPT/sway_run.sh rofi -show drun -terminal $terminal

# Start a terminal
bindsym Mod4+Return exec $SWAY_SCRIPT/sway_run.sh $terminal

# Start a floating terminal (requires terminal that supports --class flag)
bindsym Mod4+Shift+Return exec $SWAY_SCRIPT/sway_run.sh $terminal --class floating_terminal

# Start terminal (default is set to kitty terminal emulator) and connect to tmux session
bindsym Ctrl+Mod1+Return       exec $SWAY_SCRIPT/sway_terminal_operator.sh attach_to_selected_tmux_session tiling
bindsym Ctrl+Mod1+Shift+Return exec $SWAY_SCRIPT/sway_terminal_operator.sh attach_to_selected_tmux_session floating

# Kill focused window
bindsym Mod4+Shift+q kill

# Kill focused window and copy tmux cmd
bindsym Ctrl+Mod4+Shift+q exec $SWAY_SCRIPT/sway_terminal_operator.sh close_terminal_and_capture_tmux_cmd

# Exit sway (i3-nagbar -> swaynag, i3-msg exit -> swaymsg exit)
bindsym Ctrl+Mod1+q exec swaynag -f '$default_font $default_i3bar_fontsize' -t warning \
                            -m 'Do you really want to exit sway? This will end your Wayland session.' \
                            -B 'Yes, exit sway' 'swaymsg exit'

# Focus the parent/child container
bindsym Mod4+a       focus parent
bindsym Mod4+Shift+a focus child

# Open empty window/container
# [SWAY] NOT AVAILABLE: sway has no 'open' command (no empty placeholder containers).
#bindsym Mod4+o exec i3-msg open

# Vim-key: change focus
bindsym Mod4+h focus left, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window
bindsym Mod4+j focus down, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window
bindsym Mod4+k focus up, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window
bindsym Mod4+l focus right, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window
# Vim-key: move focused window (px for floating window)
bindsym Mod4+Shift+h move left 50 px, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window
bindsym Mod4+Shift+j move down 50 px, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window
bindsym Mod4+Shift+k move up 50 px, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window
bindsym Mod4+Shift+l move right 50 px, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window
# Vim-key: move focused window (smaller step for floating window)
bindsym Mod4+Ctrl+Shift+h move left, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window
bindsym Mod4+Ctrl+Shift+j move down, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window
bindsym Mod4+Ctrl+Shift+k move up, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window
bindsym Mod4+Ctrl+Shift+l move right, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window

## Arrow-key: change focus (DISABLED for remote desktop window tiling function)
#bindsym Mod4+Left  focus left
#bindsym Mod4+Down  focus down
#bindsym Mod4+Up    focus up
#bindsym Mod4+Right focus right
## Arrow-key: move focused window
#bindsym Mod4+Shift+Left  move left
#bindsym Mod4+Shift+Down  move down
#bindsym Mod4+Shift+Up    move up
#bindsym Mod4+Shift+Right move right

# Full screen mode
# Toggle full screen
bindsym Mod4+f       fullscreen toggle
bindsym Mod4+Shift+f fullscreen toggle global
# Make window float and resize to fulfill current workspace
bindsym Ctrl+Mod1+f       exec $SWAY_SCRIPT/sway_window_operator.sh float_then_fulfill_workspace
bindsym Ctrl+Mod1+Shift+f exec $SWAY_SCRIPT/sway_window_operator.sh float_then_fulfill_workspace with_placeholder

# Floating mode
# Change focus between tiling/floating windows
bindsym Mod4+space focus mode_toggle
# Toggle tiling/floating
bindsym Mod4+Shift+space floating toggle
# Toggle stickiness of floating window (window stick to current display, a.k.a always on-the-top)
bindsym Mod4+Shift+s exec $SWAY_SCRIPT/sway_window_operator.sh toggle_sticky_current; exec "pgrep flashfocus && flash_window"

# Tiling mode
# Change container layout (stacking, tabbed, splitv, splith)
bindsym Mod4+Shift+e layout toggle splitv splith tabbed stacking; exec "pgrep flashfocus && flash_window"
# Change container layout (stacking, tabbed, toggle split)
bindsym Mod4+s layout stacking; exec "pgrep flashfocus && flash_window"
bindsym Mod4+w layout tabbed; exec "pgrep flashfocus && flash_window"
bindsym Mod4+e layout toggle splitv splith; exec "pgrep flashfocus && flash_window"
# Change split direction (vertical, horizontal)
bindsym Mod4+v       split vertical; exec "pgrep flashfocus && flash_window"
bindsym Mod4+Shift+v split horizontal; exec "pgrep flashfocus && flash_window"
# Change container split direction (vertical, horizontal)
bindsym Mod4+q split toggle; exec "pgrep flashfocus && flash_window"

# Title bar toggle
bindsym Mod4+t border toggle $default_border_width

# Mark mode [use rofi as input]
# Mark current window with input character
bindsym Mod4+m exec $SWAY_SCRIPT/sway_mark_operator.sh mark rofi none title_on
# Unmark window with input character
bindsym Mod4+u       exec $SWAY_SCRIPT/sway_mark_operator.sh unmark rofi none title_on
bindsym Mod4+Shift+u exec $SWAY_SCRIPT/sway_mark_operator.sh unmark_all_automark_and_remark none none title_off
bindsym Ctrl+Mod1+u  exec $SWAY_SCRIPT/sway_mark_operator.sh unmark_all rofi none title_off
# Go to the window with input mark character
bindsym Mod4+apostrophe       exec $SWAY_SCRIPT/sway_mark_operator.sh goto rofi none title_on
bindsym Mod4+Shift+apostrophe exec $SWAY_SCRIPT/sway_mark_operator.sh goto rofi none title_off
bindsym Ctrl+Mod1+apostrophe  exec $SWAY_SCRIPT/sway_mark_operator.sh show_then_goto rofi none title_off
# Swap current window with input mark character (but focus stays)
bindsym Mod4+semicolon       exec $SWAY_SCRIPT/sway_mark_operator.sh swap rofi stay title_on
bindsym Mod4+Shift+semicolon exec $SWAY_SCRIPT/sway_mark_operator.sh swap rofi stay title_off
bindsym Ctrl+Mod1+semicolon  exec $SWAY_SCRIPT/sway_mark_operator.sh show_then_swap rofi stay title_off

# Cycle window focus with automarks (increasingly/decreasingly)
bindsym Mod4+n exec $SWAY_SCRIPT/sway_automark_operator.sh cycle_focus_inc
bindsym Mod4+i exec $SWAY_SCRIPT/sway_automark_operator.sh cycle_focus_dec
# Swap window with automarks (increasingly/decreasingly)
bindsym Mod4+Shift+n exec $SWAY_SCRIPT/sway_automark_operator.sh cycle_swap_inc
bindsym Mod4+Shift+i exec $SWAY_SCRIPT/sway_automark_operator.sh cycle_swap_dec

# Scratchpad (i3 background workspace)
# Scratchpad: hide/show window (minus is "-" key but plus is actually "=" key.)
bindsym Mod4+minus move scratchpad
bindsym Mod4+equal  scratchpad show
# Scratchpad: send all floating windows to the scratchpad and vice versa
bindsym Mod4+Shift+minus [floating] move scratchpad
bindsym Mod4+Shift+equal  [all] scratchpad show

# Scratchpad (i3 background workspace)
# Scratchpad: hide/show window
bindsym Mod4+z move scratchpad
bindsym Mod4+g scratchpad show
# Scratchpad: send all floating windows to the scratchpad and vice versa
bindsym Mod4+Shift+z [floating] move scratchpad
bindsym Mod4+Shift+g [all] scratchpad show

# Resize window with hotkey (px/ppt for floating/tiling window)
bindsym Ctrl+Mod1+h resize shrink width 50 px or 5 ppt, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window
bindsym Ctrl+Mod1+j resize grow height 50 px or 5 ppt, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window
bindsym Ctrl+Mod1+k resize shrink height 50 px or 5 ppt, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window
bindsym Ctrl+Mod1+l resize grow width 50 px or 5 ppt, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window

# Change window geometry (size/location)
bindsym Mod4+x     exec $SWAY_SCRIPT/sway_window_operator.sh move_floating_to_input
bindsym Mod4+c     exec $SWAY_SCRIPT/sway_window_operator.sh resize_to_input
bindsym Mod4+slash exec $SWAY_SCRIPT/sway_window_operator.sh resize_to_input_and_move_floating_to_input_in_one

# Dunst shortcuts
bindsym Ctrl+space            exec dunstctl close
bindsym Ctrl+Shift+space      exec dunstctl history-pop
bindsym Mod1+space            exec dunstctl close
bindsym Mod1+Shift+space      exec dunstctl history-pop
bindsym Ctrl+Mod1+Shift+space exec dunstctl action

# Input method (ibus)
# Change ibus engine
# [SWAY] ibus: i3_languagechanger.sh (us <-> chewing); fcitx5: fcitx5-remote -t
bindsym Ctrl+Mod1+space exec $SWAY_SCRIPT/sway_input_method.sh toggle
# Disable full character mode of ibus-chewing by default
bindsym Shift+space exec notify-send -u low "ibus-chewing Input Method" "Full character keybind is disabled\nUse system tray or i3 insert mode\nto enable full character usage"

# Screenshot tools (flameshot/gnome-screenshot -> grim + slurp + swappy)
bindsym --release Print  exec $SWAY_SCRIPT/sway_screenshot_operator.sh GUI keep
bindsym Mod4+Print       exec $SWAY_SCRIPT/sway_screenshot_operator.sh active_window keep
bindsym Mod4+Shift+Print exec $SWAY_SCRIPT/sway_screenshot_operator.sh select_window keep

# Disable default mouse button keybindings in i3 (e.g. button3 is mapped for resizing by default)
bindsym button2 nop
bindsym button3 nop

# Mouse middle button (touchpad 3-finger tap) over a titlebar kills the window
# The middle button and a modifier over any part of the window kills the window
bindsym --release button2           kill
bindsym --whole-window Mod4+button2 kill

# Mouse right button (touchpad 2-finger tap) toggles window floating
bindsym --release button3           floating toggle
bindsym --whole-window Mod4+button3 floating toggle

# Mouse wheel scroll up/down (touchpad 2-finger swipe down/up) toggles window titlebar
bindsym --border button4 border normal $default_border_width
bindsym --border button5 border pixel $default_border_width

# Mouse thumb button up/down (button8/button9): cursor auto-hiding on/off
# [SWAY] unclutter (X11) -> native 'seat * hide_cursor <ms>' (0 disables)
bindsym Ctrl+button8 seat * hide_cursor 3000
bindsym Ctrl+button9 seat * hide_cursor 0

# Mouse emulator: Warpd (NOTE: warpd must be built with PLATFORM=wayland for sway)
# -- https://github.com/rvaiya/warpd/?tab=readme-ov-file
bindsym Mod1+m exec warpd --normal --config $HOME/.config/warpd/config
