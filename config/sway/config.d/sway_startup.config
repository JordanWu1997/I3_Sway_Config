# ~/.config/sway/config.d/sway_startup.config
# vim: ft=swayconfig ff=unix
# ======================================================================================
# All About Sway Startup Commands/Programs
# ======================================================================================
# Following commands/programs will run after sway starts
#
# exec        runs once at login. Use it for daemons that survive a reload (Mod+Shift+r);
#             exec_always would start a second copy each time.
# exec_always runs at login and on every `reload`. Use it only for idempotent commands,
#             or ones that replace/kill the previous instance first.
# [SWAY] `--no-startup-id` is dropped: sway has no startup-notification cursor and only
#        logs a warning for it.
# Duplicates show up as "running xN" in the status view (Ctrl+Alt+S, then s).

# --------------------------------------------------------------------------------------
# Session plumbing (sway-only, MUST stay first)
# --------------------------------------------------------------------------------------
# Export the Wayland session variables to systemd --user and D-Bus activated services.
# Required for xdg-desktop-portal(-wlr) (screen sharing, file pickers), gnome-keyring,
# flatpak apps, and anything D-Bus starts (dunst, kdeconnectd ...).
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY SWAYSOCK I3SOCK XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XCURSOR_THEME XCURSOR_SIZE GTK_IM_MODULE QT_IM_MODULE XMODIFIERS GLFW_IM_MODULE PATH
exec systemctl --user import-environment WAYLAND_DISPLAY DISPLAY SWAYSOCK I3SOCK XDG_CURRENT_DESKTOP XDG_SESSION_TYPE

# Track sway inherited $PATH (was /tmp/i3-path)
exec_always echo "$PATH" > /tmp/sway-path

# Memory monitor (pure shell, shared with i3)
exec $I3_SCRIPT/i3_memory_notifier.sh

# Set output layout automatically (xrandr -> swaymsg output, see sway_display_operator.sh).
# For more options, check the display mode in this configuration.
# [SWAY] If you use kanshi for automatic profiles, replace this line with: exec kanshi
exec $SWAY_SCRIPT/sway_display_operator.sh auto $default_conky_startup

# Xsettings daemon (provides settings to XWayland applications only).
# Native GTK apps on Wayland read gsettings instead; import GTK settings once:
exec_always xsettingsd
exec_always $SWAY_SCRIPT/sway_import_gsettings.sh

# Initialize workspace name list for rofi selector
exec $SWAY_SCRIPT/sway_genereate_workspace_name_list.sh

# Gnome authentication (GUI application root authentication support)
# -- Installation: sudo apt install policykit-1-gnome  |  sudo dnf install polkit-gnome
# -- [SWAY] path differs between Ubuntu (/usr/lib/...) and Fedora (/usr/libexec/...)
exec "test -x /usr/libexec/polkit-gnome-authentication-agent-1 && exec /usr/libexec/polkit-gnome-authentication-agent-1 || exec /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1"

# NetworkManager tray GUI. [SWAY] swaybar's tray is StatusNotifierItem-only, so nm-applet
# must run with --indicator (AppIndicator) or its icon will not appear.
exec nm-applet --indicator

# Bluetooth Manager system tray GUI (blueman-applet publishes an SNI icon)
exec blueman-applet

# [SWAY] numlockx       -> `xkb_numlock enabled` in sway_input_output.config
# [SWAY] imwheel -b 45  -> `scroll_factor` in sway_input_output.config
# [SWAY] xset m 2/1 4   -> `accel_profile`/`pointer_accel` in sway_input_output.config

# Keyboard defaults (repeat rate, Caps->Ctrl are in sway_input_output.config; this applies
# the remaining xmodmap-style tweaks such as Shift+Escape -> ~)
exec_always $SWAY_SCRIPT/sway_keyboard_operator.sh default

## Caffeine (inhibit idle/lock: xset s off -dpms -> stop swayidle timeouts)
exec $SWAY_SCRIPT/sway_toolkit_operator.sh enable_caffeine

## Volume (set to zero, requires pulsemixer support)
#exec pulsemixer --set-volume 0

# [SWAY] Trackpad gestures: libinput-gestures -> native `bindgesture` in
#        sway_input_output.config (no daemon, no `input` group, no xdotool).

# Input method: $default_input_method in ~/.config/sway/config (ibus or fcitx5)
# [SWAY] sway_input_method.sh starts the chosen framework and keeps
#        ~/.config/environment.d/60-sway-input-method.conf (GTK_IM_MODULE, XMODIFIERS ...)
#        so applications get the variables even when sway was not started by sway-session.
#        ibus: XWayland apps, kitty (forced to X11), GTK/Qt modules; tray via KDE mode.
#        fcitx5: the same plus native Wayland apps (input-method-v2) and a working tray.
#        Switch: sway_input_method.sh use fcitx5   (then log out and back in)
exec_always $SWAY_SCRIPT/sway_input_method.sh start

# Clipboard manager: parcellite (X11 only) -> cliphist (history) via wl-paste watchers
exec_always $SWAY_SCRIPT/sway_toolkit_operator.sh reload_parcellite

# Flashfocus (flash window when focus changes) [https://github.com/fennerm/flashfocus]
# [SWAY] flashfocus talks to sway IPC directly (opacity command), no picom needed.
exec $SWAY_SCRIPT/sway_flashfocus_operator.sh start

# Dunst (notification daemon; dunst >= 1.6 runs natively on Wayland via layer-shell)
exec dunst

# Notification logger (for dunst)
exec $I3_SCRIPT/i3_notify_logger.sh $HOME/.config/dunst/log.txt

## KDE Connect should startup automatically, this is to start KDE Connect manually
#exec /usr/libexec/kdeconnectd

# KDE Connect indicator on system tray (SNI, shows in swaybar)
exec kdeconnect-indicator

## Mailspring (email manager) in background
#exec mailspring --background

## Slack
#exec flatpak run com.slack.Slack -u

## Discord
#exec flatpak run com.discordapp.Discord --start-minimized

## Steam
#exec flatpak run com.valvesoftware.Steam -silent

# [SWAY] Flameshot daemon removed: screenshots use grim/slurp/swappy on demand
#        (sway_screenshot_operator.sh), nothing needs to run in the background.

# Neofetch initialization at startup
exec_always rm -fr $HOME/.cache/thumbnails/neofetch

# Screenshot daemon: flameshot tray icon only when `set $default_screenshot_tool flameshot`
# -- [SWAY] default is grim (grim + slurp + satty/swappy): flameshot did not show its
#    capture overlay on sway in test_v3. swaybar < 1.11 cannot open tray menus.
exec $SWAY_SCRIPT/sway_screenshot_operator.sh start_daemon

# [SWAY] unclutter -> `seat * hide_cursor 3000` in sway_input_output.config

# Battery warning [https://github.com/rjekker/i3-battery-popup] (i3-nagbar -> swaynag)
exec $SWAY_SCRIPT/sway_battery-popup.sh -N -L 30

# Opacity rules (picom replacement). On every reload, re-apply the default opacity mode,
# like i3_picom_operator.sh after_i3_restart did for picom after an i3 restart.
exec_always $SWAY_SCRIPT/sway_opacity_operator.sh after_i3_restart

# Automark windows [https://github.com/lincheney/i3-automark]
# Modified to mark all windows with lowercase instead of original uppercase.
# [SWAY] Ported: the i3 daemon finds its socket via X11 (i3 --get-socketpath) and skips
#        native Wayland windows (node.window is null); the sway version uses $SWAYSOCK.
exec $SWAY_SCRIPT/sway_automark_daemon.py

# Dwindling layout (autotiling) [https://github.com/nwg-piotr/autotiling]
# -- Installation: pip install autotiling  (supports sway natively)
# Start only if not running: keeps the current mode (e.g. master-stack) across a reload.
# [SWAY] sway_run.sh adds ~/.local/bin (pip --user) to PATH even if ~/.profile was not loaded
exec_always pgrep -u "$USER" -x autotiling >/dev/null || $SWAY_SCRIPT/sway_run.sh autotiling

# Screen lock / idle (xss-lock + i3lock -> swayidle + swaylock).
# swayidle handles `loginctl lock-session` (lock event), before-sleep locking,
# lock-after-timeout and output power-off.
exec_always $SWAY_SCRIPT/sway_idle_operator.sh current_desktop

# Login summary: one notification listing session states that may surprise you
# (volume, caffeine/auto-lock, autotiling, bar mode, Caps Lock); delayed so the
# programs above have started. Full view: Ctrl+Alt+S, then s
exec sleep 8 && $SWAY_SCRIPT/sway_system_status.sh login

# [SWAY] Warn if sway was started without sway-session (~/.profile not loaded) or if
#        bumblebee-status/autotiling are missing
exec sleep 3 && $SWAY_SCRIPT/sway_session_check.sh
