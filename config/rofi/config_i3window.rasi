/* Shared centered layout for i3 window placement and sizing. */

configuration {

    /*Font*/
    font: "Operator-caska 18";

    /*Show icons*/
    show-icons: false;

    /*Icon theme*/
    icon-theme: "Papirus";

    /*Border width*/
    bw: 0;

    /*Row height (unit: character)*/
    eh: 1;

    /*Margin between rows*/
    line-margin: 2;

    /*Separator between input and options*/
    separator-style: "dash";

    /* Show when the longer preset list has more choices below. */
    hide-scrollbar: false;

    /*Auto-select mode*/
    auto-select: false;

    /*Unmap default rofi shortcut*/
    kb-mode-complete: "";
    kb-row-select: "";

    /*Key shortcut*/
    kb-remove-char-back: "BackSpace,Shift+BackSpace,Control+Shift+h";
    kb-remove-to-eol: "Control+Shift+k";
    kb-accept-entry: "!Alt+ISO_Left_Tab,!Alt-Tab,Return,KP_Enter,Alt+space,Control+space";
    kb-row-up: "Alt+ISO_Left_Tab,Up,Alt+k,Control+k,Control+p";
    kb-row-down: "Alt+Tab,Down,Alt+j,Control+j,Control+n";
    kb-row-left: "Alt+h,Control+h";
    kb-row-right: "Alt+l,Control+l";

}

@import "~/.cache/wal/colors-rofi-dark.rasi"

#listview {

    /* Keep the palette readable and stable while filtering. */
    lines: 8;
    fixed-height: false;
    dynamic: false;

    /*Number of columns*/
    columns: 1;
    scrollbar: true;

}

#inputbar {

    /*Inputbar component*/
    children: [prompt,textbox-prompt-colon,entry];

}

#window {

    /* Keep the compact chooser centered without filling the screen. */
    location: center;
    anchor: center;
    width: 760px;
    padding: 1em;

    /*Border width*/
    border: 5;

    /*Border color*/
    border-color: @selected-active-background;

}

#entry {

    /* Read typed dimensions from left to right like the menu labels. */
    horizontal-align: 0.0;
    expand: true;
    text-color: @foreground;

}

#prompt {

    /* Keep the prompt from taking the input field's space. */
    expand: false;

}

#scrollbar {

    /* Make overflow visible on the long preset page. */
    handle-width: 4px;

}

#element-text {

    /* Align every action label to one scanning edge. */
    horizontal-align: 0.0;

}
