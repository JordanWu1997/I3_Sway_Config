# ~/.config/sway/config.d/sway_custom.config
# vim: ft=swayconfig ff=unix
# ======================================================================================
# All About Customization
# ======================================================================================
# Customization includes wallpaper, theme, and visual effects (e.g. blur/animation)
# [SWAY] picom is replaced by sway's built-in compositor (opacity). Blur, shadows, rounded
#        corners and dim_inactive need SwayFX (a drop-in sway fork).

# Customization mode (wrapper for wallpaper_mode, theme mode, and picom_mode)
# $mode_customization: label defined in sway_mode_name.config
bindsym Mod4+Shift+c mode "$mode_customization"
mode "$mode_customization" {
    bindsym b mode "$mode_border"
    bindsym c mode "$mode_conky"
    bindsym d mode "$mode_dunst_option"
    bindsym p mode "$mode_picom"
    bindsym f mode "$mode_flashfocus"
    bindsym t mode "$mode_theme"
    bindsym w mode "$mode_wallpaper"
    bindsym v mode "$mode_variety"
    bindsym r mode "$mode_custom_reload"
    # Font mode
    bindsym Shift+f mode "$mode_font"
    # Exit mode: "Enter", "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Return           mode "default"
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# NOTE: Wallpaper mode (local wallpaper support)
# [Important]: Wallpaper directory (Add below lines in .profile)
#              Please change to directories where you store wallpaper.
#              Feel free to modify these wallpaper directories as you want.
# --------------------------------------------------------------------------------------
#export WALLPAPERI3="$HOME/.config/i3/share"
#export WALLPAPERV="$HOME/Pictures/VARIETY_SAVED"
#export WALLPAPERD="$HOME/Pictures/WALLPAPERS"
#export WALLPAPERF="$WALLPAPERD/FAVORITES"
#export WALLPAPER1="$WALLPAPERD/I3WM"
#export WALLPAPER2="$WALLPAPERD/FEDORA"
#export WALLPAPER3="$WALLPAPERD/ALMA"
#export WALLPAPER4="$WALLPAPERD/CATS"
#export WALLPAPER5="$WALLPAPERD/LINUX"
#export WALLPAPER6="$WALLPAPERD/THINKPAD"
#export WALLPAPER7="$WALLPAPERD/WINDOWS11"
#export WALLPAPER8="$WALLPAPERD/DT_WALLPAPERS"
#export WALLPAPER9="$WALLPAPERD/MISCELLANEOUS"
# --------------------------------------------------------------------------------------

# Wallpaper mode (within customization mode)
# $mode_wallpaper: label defined in sway_mode_name.config
mode "$mode_wallpaper" {
    # Show current wallpaper information
    bindsym i exec $SWAY_SCRIPT/sway_wallpaper_operator.sh feh show_current
    # Select random wallpapers from $WALLPAPER#, default, favorite and all
    bindsym 1 exec $SWAY_SCRIPT/sway_wallpaper_operator.sh feh random $WALLPAPER1
    bindsym 2 exec $SWAY_SCRIPT/sway_wallpaper_operator.sh feh random $WALLPAPER2
    bindsym 3 exec $SWAY_SCRIPT/sway_wallpaper_operator.sh feh random $WALLPAPER3
    bindsym 4 exec $SWAY_SCRIPT/sway_wallpaper_operator.sh feh random $WALLPAPER4
    bindsym 5 exec $SWAY_SCRIPT/sway_wallpaper_operator.sh feh random $WALLPAPER5
    bindsym 6 exec $SWAY_SCRIPT/sway_wallpaper_operator.sh feh random $WALLPAPER6
    bindsym 7 exec $SWAY_SCRIPT/sway_wallpaper_operator.sh feh random $WALLPAPER7
    bindsym 8 exec $SWAY_SCRIPT/sway_wallpaper_operator.sh feh random $WALLPAPER8
    bindsym 9 exec $SWAY_SCRIPT/sway_wallpaper_operator.sh feh random $WALLPAPER9
    bindsym d exec $SWAY_SCRIPT/sway_wallpaper_operator.sh feh random $WALLPAPERI3
    bindsym f exec $SWAY_SCRIPT/sway_wallpaper_operator.sh feh random $WALLPAPERF
    bindsym a exec $SWAY_SCRIPT/sway_wallpaper_operator.sh feh random $WALLPAPERD
    # Select wallpaper from $WALLPAPER#, default, favorite and all
    bindsym Shift+1 exec $SWAY_SCRIPT/sway_wallpaper_operator.sh feh select $WALLPAPER1
    bindsym Shift+2 exec $SWAY_SCRIPT/sway_wallpaper_operator.sh feh select $WALLPAPER2
    bindsym Shift+3 exec $SWAY_SCRIPT/sway_wallpaper_operator.sh feh select $WALLPAPER3
    bindsym Shift+4 exec $SWAY_SCRIPT/sway_wallpaper_operator.sh feh select $WALLPAPER4
    bindsym Shift+5 exec $SWAY_SCRIPT/sway_wallpaper_operator.sh feh select $WALLPAPER5
    bindsym Shift+6 exec $SWAY_SCRIPT/sway_wallpaper_operator.sh feh select $WALLPAPER6
    bindsym Shift+7 exec $SWAY_SCRIPT/sway_wallpaper_operator.sh feh select $WALLPAPER7
    bindsym Shift+8 exec $SWAY_SCRIPT/sway_wallpaper_operator.sh feh select $WALLPAPER8
    bindsym Shift+9 exec $SWAY_SCRIPT/sway_wallpaper_operator.sh feh select $WALLPAPER9
    bindsym Shift+d exec $SWAY_SCRIPT/sway_wallpaper_operator.sh feh select $WALLPAPERI3
    bindsym Shift+f exec $SWAY_SCRIPT/sway_wallpaper_operator.sh feh select $WALLPAPERF
    bindsym Shift+a exec $SWAY_SCRIPT/sway_wallpaper_operator.sh feh select $WALLPAPERD
    # Wallpaper options
    bindsym r      exec $SWAY_SCRIPT/sway_wallpaper_operator.sh feh restore_default
    bindsym Ctrl+s exec $SWAY_SCRIPT/sway_wallpaper_operator.sh feh save_current
    bindsym Ctrl+d exec $SWAY_SCRIPT/sway_wallpaper_operator.sh feh set_default
    # Theme mode
    bindsym t mode "$mode_theme"
    # Back to customization mode: "Enter"
    bindsym Return mode "$mode_customization"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Variety mode (within customization mode)
# $mode_variety: label defined in sway_mode_name.config
mode "$mode_variety" {
    # Show current Variety info
    bindsym i exec $SWAY_SCRIPT/sway_wallpaper_operator.sh variety show_current
    # Previous/Next Variety
    bindsym p exec $SWAY_SCRIPT/sway_wallpaper_operator.sh variety previous
    bindsym n exec $SWAY_SCRIPT/sway_wallpaper_operator.sh variety next
    # Random/Select Variety favriote
    bindsym f       exec $SWAY_SCRIPT/sway_wallpaper_operator.sh variety random $WALLPAPERV
    bindsym Shift+f exec $SWAY_SCRIPT/sway_wallpaper_operator.sh variety select $WALLPAPERV
    # Random/Select Variety downloaded
    bindsym a       exec $SWAY_SCRIPT/sway_wallpaper_operator.sh variety random $HOME/.config/variety/Downloaded
    bindsym Shift+a exec $SWAY_SCRIPT/sway_wallpaper_operator.sh variety select $HOME/.config/variety/Downloaded
    # Variety options
    bindsym Shift+p exec $SWAY_SCRIPT/sway_wallpaper_operator.sh variety pause
    bindsym Shift+r exec $SWAY_SCRIPT/sway_wallpaper_operator.sh variety resume
    bindsym Ctrl+s  exec $SWAY_SCRIPT/sway_wallpaper_operator.sh variety save_current
    bindsym Ctrl+d  exec $SWAY_SCRIPT/sway_wallpaper_operator.sh variety set_default
    bindsym q       exec $SWAY_SCRIPT/sway_wallpaper_operator.sh variety quit
    # Theme mode
    bindsym t mode "$mode_theme"
    # Back to customization mode: "Enter"
    bindsym Return mode "$mode_customization"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Border mode (within customization mode)
# $mode_border: label defined in sway_mode_name.config
mode "$mode_border" {
    bindsym 1 mode "$mode_border_width"
    bindsym 2 mode "$mode_border_option"
    bindsym 3 mode "$mode_border_colorscheme"
    # Back to customization mode: "Enter"
    bindsym Return mode "$mode_customization"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Border width mode (within border mode)
# $mode_border_width: label defined in sway_mode_name.config
mode "$mode_border_width" {
    bindsym 1 border pixel 1
    bindsym 2 border pixel 2
    bindsym 3 border pixel 3
    bindsym 4 border pixel 4
    bindsym 5 border pixel 5
    bindsym 9 border pixel 10
    bindsym 0 border none
    bindsym r border $default_titlebar_style $default_border_width
    bindsym s mode "$mode_set_border"
    # i3 keybindings compatibility: change focus and move cursor to the center of focus window
    bindsym Mod4+h focus left, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window
    bindsym Mod4+j focus down, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window
    bindsym Mod4+k focus up, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window
    bindsym Mod4+l focus right, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window
    # i3 keybindings compatibility: change focus between tiling/floating windows
    bindsym Mod4+space focus mode_toggle
    # Back to border mode: "Enter"
    bindsym Return mode "$mode_border"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Set default border width mode (within border width mode)
# $mode_set_border: label defined in sway_mode_name.config
mode "$mode_set_border" {
    bindsym 1 exec $SWAY_SCRIPT/sway_default_valuechanger.sh border_width 1; mode "default"
    bindsym 2 exec $SWAY_SCRIPT/sway_default_valuechanger.sh border_width 2; mode "default"
    bindsym 3 exec $SWAY_SCRIPT/sway_default_valuechanger.sh border_width 3; mode "default"
    bindsym 4 exec $SWAY_SCRIPT/sway_default_valuechanger.sh border_width 4; mode "default"
    bindsym 5 exec $SWAY_SCRIPT/sway_default_valuechanger.sh border_width 5; mode "default"
    bindsym 9 exec $SWAY_SCRIPT/sway_default_valuechanger.sh border_width 10; mode "default"
    bindsym 0 exec $SWAY_SCRIPT/sway_default_valuechanger.sh border_width 0; mode "default"
    bindsym i exec $SWAY_SCRIPT/sway_default_valuechanger.sh border_width input; mode "default"
    # Back to border mode: "Enter"
    bindsym Return mode "$mode_border_width"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Set border option (within border mode)
# $mode_border_option: label defined in sway_mode_name.config
mode "$mode_border_option" {
    bindsym 1 exec $SWAY_SCRIPT/sway_border_operator.sh show_both_edge; mode "default"
    bindsym 2 exec $SWAY_SCRIPT/sway_border_operator.sh hide_both_edge; mode "default"
    bindsym 3 exec $SWAY_SCRIPT/sway_border_operator.sh hide_horizontal_edge; mode "default"
    bindsym 4 exec $SWAY_SCRIPT/sway_border_operator.sh hide_vertical_edge; mode "default"
    bindsym 5 exec $SWAY_SCRIPT/sway_border_operator.sh hide_both_edge_if_only_one; mode "default"
    bindsym 6 exec $SWAY_SCRIPT/sway_border_operator.sh hide_both_edge_if_no_outer_gaps; mode "default"
    # Back to border mode: "Enter"
    bindsym Return mode "$mode_border"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Border colorscheme mode (within border mode)
# $mode_border_colorscheme: label defined in sway_mode_name.config
mode "$mode_border_colorscheme" {
    bindsym 1 exec $SWAY_SCRIPT/sway_window_decoractor.sh monochromic
    bindsym 2 exec $SWAY_SCRIPT/sway_window_decoractor.sh dirchromatic
    bindsym 3 exec $SWAY_SCRIPT/sway_window_decoractor.sh monochromic_inversed
    bindsym 4 exec $SWAY_SCRIPT/sway_window_decoractor.sh default
    # Back to border mode: "Enter"
    bindsym Return mode "$mode_border"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}


# Dunst option mode(within dunst mode)
# $mode_dunst_option: label defined in sway_mode_name.config
mode "$mode_dunst_option" {
    bindsym 1 mode "$mode_dunst_position"
    bindsym 2 mode "$mode_dunst_xoffset"
    bindsym 3 mode "$mode_dunst_yoffset"
    bindsym 4 mode "$mode_dunst_alignment"
    bindsym 5 mode "$mode_dunst_fontsize"
    bindsym 6 mode "$mode_dunst_icon_position"
    # Reload mode
    bindsym r mode "$mode_custom_reload"
    # Back to dunst mode: "Enter"
    bindsym Return mode "$mode_customization"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Dunst position mode (within dunst option mode)
# $mode_dunst_position: label defined in sway_mode_name.config
mode "$mode_dunst_position" {
    bindsym 1 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_position top-left; mode "default"
    bindsym 2 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_position top-center; mode "default"
    bindsym 3 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_position top-right; mode "default"
    bindsym 4 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_position left-center; mode "default"
    bindsym 5 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_position center; mode "default"
    bindsym 6 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_position right-center; mode "default"
    bindsym 7 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_position bottom-left; mode "default"
    bindsym 8 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_position bottom-center; mode "default"
    bindsym 9 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_position bottom-right; mode "default"
    # Back to dunst mode: "Enter"
    bindsym Return mode "$mode_dunst_option"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Dunst xoffset mode (within dunst option mode)
# $mode_dunst_xoffset: label defined in sway_mode_name.config
mode "$mode_dunst_xoffset" {
    bindsym 1 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_xoffset 10; mode "default"
    bindsym 2 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_xoffset 15; mode "default"
    bindsym 3 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_xoffset 20; mode "default"
    bindsym 4 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_xoffset 25; mode "default"
    bindsym 5 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_xoffset 30; mode "default"
    bindsym 6 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_xoffset 35; mode "default"
    bindsym 7 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_xoffset 40; mode "default"
    bindsym 8 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_xoffset 45; mode "default"
    bindsym 9 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_xoffset 50; mode "default"
    bindsym 0 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_xoffset 0; mode "default"
    bindsym i exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_xoffset input; mode "default"
    # Back to dunst mode: "Enter"
    bindsym Return mode "$mode_dunst_option"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Dunst yoffset mode (within dunst option mode)
# $mode_dunst_yoffset: label defined in sway_mode_name.config
mode "$mode_dunst_yoffset" {
    bindsym 1 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_yoffset 10; mode "default"
    bindsym 2 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_yoffset 15; mode "default"
    bindsym 3 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_yoffset 20; mode "default"
    bindsym 4 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_yoffset 25; mode "default"
    bindsym 5 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_yoffset 30; mode "default"
    bindsym 6 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_yoffset 35; mode "default"
    bindsym 7 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_yoffset 40; mode "default"
    bindsym 8 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_yoffset 45; mode "default"
    bindsym 9 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_yoffset 50; mode "default"
    bindsym 0 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_yoffset 0; mode "default"
    bindsym i exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_yoffset input; mode "default"
    # Back to dunst mode: "Enter"
    bindsym Return mode "$mode_dunst_option"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Dunst alignment mode (within dunst option mode)
# $mode_dunst_alignment: label defined in sway_mode_name.config
mode "$mode_dunst_alignment" {
    bindsym 1 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_alignment left; mode "default"
    bindsym 2 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_alignment center; mode "default"
    bindsym 3 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_alignment right; mode "default"
    # Back to dunst mode: "Enter"
    bindsym Return mode "$mode_dunst_option"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Dunst fontsize mode (within dunst option mode)
# $mode_dunst_fontsize: label defined in sway_mode_name.config
mode "$mode_dunst_fontsize" {
    bindsym 1 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_fontsize 8; mode "default"
    bindsym 2 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_fontsize 9; mode "default"
    bindsym 3 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_fontsize 10; mode "default"
    bindsym 4 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_fontsize 11; mode "default"
    bindsym 5 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_fontsize 12; mode "default"
    bindsym 6 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_fontsize 13; mode "default"
    bindsym 7 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_fontsize 14; mode "default"
    bindsym 8 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_fontsize 15; mode "default"
    bindsym 9 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_fontsize 16; mode "default"
    bindsym i exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_fontsize input; mode "default"
    # Back to dunst mode: "Enter"
    bindsym Return mode "$mode_dunst_option"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}
# Dunst icon position mode (within dunst option mode)
# $mode_dunst_icon_position: label defined in sway_mode_name.config
mode "$mode_dunst_icon_position" {
    bindsym 1 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_icon_position left; mode "default"
    bindsym 2 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_icon_position top; mode "default"
    bindsym 3 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_icon_position right; mode "default"
    bindsym 0 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_icon_position off; mode "default"
    # Back to dunst mode: "Enter"
    bindsym Return mode "$mode_dunst_option"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Conky mode (within customization mode, including system monitor and bindkey sheet)
# $mode_conky: label defined in sway_mode_name.config
mode "$mode_conky" {
    bindsym 1 mode "$mode_conky_bindkey"
    bindsym 2 mode "$mode_conky_system"
    bindsym 3 exec $SWAY_SCRIPT/sway_conky_monitor_display.sh default
    bindsym 4 exec $SWAY_SCRIPT/sway_conky_monitor_display.sh primary
    bindsym 5 exec $SWAY_SCRIPT/sway_conky_monitor_display.sh all
    bindsym 0 exec killall conky
    # Conky style mode
    bindsym s mode "$mode_set_conky_style"
    # Conky startup mode
    bindsym c mode "$mode_set_conky_startup"
    # Reload mode
    bindsym r mode "$mode_custom_reload"
    # Back to customization mode: "Enter"
    bindsym Return mode "$mode_customization"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Bindkey sheet mode (within conky mode)
# $mode_conky_bindkey: label defined in sway_mode_name.config
mode "$mode_conky_bindkey" {
    # [SWAY] Runs a Wayland-patched copy (out_to_wayland) of the conky config
    bindsym e exec $SWAY_SCRIPT/sway_conky_monitor_display.sh bindkey_on
    bindsym d exec $SWAY_SCRIPT/sway_conky_monitor_display.sh bindkey_off
    bindsym 1 mode "$mode_conky_palette_bindkey_title"
    bindsym 2 mode "$mode_conky_palette_bindkey_item"
    bindsym 3 mode "$mode_conky_bindkey_opacity"
    bindsym 4 mode "$mode_conky_bindkey_position"
    # Back to conky mode: "Enter"
    bindsym Return mode "$mode_conky"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# System monitor mode (within conky mode)
# $mode_conky_system: label defined in sway_mode_name.config
mode "$mode_conky_system" {
    # [SWAY] Runs a Wayland-patched copy (out_to_wayland) of the conky config
    bindsym e exec $SWAY_SCRIPT/sway_conky_monitor_display.sh system_on
    bindsym d exec $SWAY_SCRIPT/sway_conky_monitor_display.sh system_off
    bindsym 1 mode "$mode_conky_palette_system_title"
    bindsym 2 mode "$mode_conky_palette_system_item"
    bindsym 3 mode "$mode_conky_system_opacity"
    bindsym 4 mode "$mode_conky_system_position"
    # Re-generate conky system config for new hardware
    bindsym 5 exec $I3_SCRIPT/i3_genereate_conky_system_config.py > $HOME/.config/conky/full/conky_config_system; mode "default"
    # Back to conky mode: "Enter"
    bindsym Return mode "$mode_conky"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Opacity mode (opacity for conky bindkey, within conky mode)
# $mode_conky_bindkey_opacity: label defined in sway_mode_name.config
mode "$mode_conky_bindkey_opacity" {
    bindsym 1 exec $SWAY_SCRIPT/sway_conky_valuechanger.sh bindkey bg_opacity opac0; mode "$mode_conky_bindkey"
    bindsym 2 exec $SWAY_SCRIPT/sway_conky_valuechanger.sh bindkey bg_opacity opac25; mode "$mode_conky_bindkey"
    bindsym 3 exec $SWAY_SCRIPT/sway_conky_valuechanger.sh bindkey bg_opacity opac50; mode "$mode_conky_bindkey"
    bindsym 4 exec $SWAY_SCRIPT/sway_conky_valuechanger.sh bindkey bg_opacity opac75; mode "$mode_conky_bindkey"
    bindsym 5 exec $SWAY_SCRIPT/sway_conky_valuechanger.sh bindkey bg_opacity opac100; mode "$mode_conky_bindkey"
    # Back to conky_bindkey mode: "Enter"
    bindsym Return mode "$mode_conky_bindkey"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Opacity mode (opacity for conky system, within conky mode)
# $mode_conky_system_opacity: label defined in sway_mode_name.config
mode "$mode_conky_system_opacity" {
    bindsym 1 exec $SWAY_SCRIPT/sway_conky_valuechanger.sh system bg_opacity opac0; mode "$mode_conky_system"
    bindsym 2 exec $SWAY_SCRIPT/sway_conky_valuechanger.sh system bg_opacity opac25; mode "$mode_conky_system"
    bindsym 3 exec $SWAY_SCRIPT/sway_conky_valuechanger.sh system bg_opacity opac50; mode "$mode_conky_system"
    bindsym 4 exec $SWAY_SCRIPT/sway_conky_valuechanger.sh system bg_opacity opac75; mode "$mode_conky_system"
    bindsym 5 exec $SWAY_SCRIPT/sway_conky_valuechanger.sh system bg_opacity opac100; mode "$mode_conky_system"
    # Back to conky_system mode: "Enter"
    bindsym Return mode "$mode_conky_system"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

