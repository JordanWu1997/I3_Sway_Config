digraph I3Workflow {
graph [label="i3 workflow: mode and Rofi state machine",labelloc=t,fontsize=30,fontname="DejaVu Sans",rankdir=LR,ranksep=0.9,nodesep=0.28,splines=polyline,pad=0.3];
node [shape=box,style="rounded,filled",fontname="DejaVu Sans",fontsize=14,margin="0.13,0.09",color="#64748b"];
edge [fontname="DejaVu Sans",fontsize=12];
default [label="NORMAL\nDefault i3 bindings",shape=oval,fillcolor="#bfdbfe",penwidth=2];
"insert" [label="Insert (toggle)\nPass application keys through\nSame key or Ctrl+[ returns",fillcolor="#e0e7ff"];
default -> "insert" [label="Ctrl+Alt+I / Super+Ctrl+I",color="#2563eb"];
"vim_keybinding" [label="Vim keys\nH/J/K/L and edit key emulation",fillcolor="#e0e7ff"];
default -> "vim_keybinding" [label="Super+Ctrl+[",color="#2563eb"];
"mouse" [label="Mouse\nPointer, clicks, scrolling; cursor preference",fillcolor="#e0e7ff"];
default -> "mouse" [label="Ctrl+Alt+M",color="#2563eb"];
"system" [label="System\nNetwork, Bluetooth, radio, display, terminal\nStatus, kill, lock, power",fillcolor="#dbeafe"];
default -> "system" [label="Ctrl+Alt+S",color="#2563eb"];
"toolkit" [label="Toolkit\nCapture, screenshot, recording, keyboard, LocalSend\nCaffeine (+ startup default), KDE Connect, reload, misc",fillcolor="#dbeafe"];
default -> "toolkit" [label="Ctrl+Alt+T",color="#2563eb"];
"display" [label="Display\nPresets and interactive output settings",fillcolor="#dbeafe"];
default -> "display" [label="Super+Shift+X",color="#2563eb"];
"backlight" [label="Backlight\nBrightness and redshift adjustments",fillcolor="#dbeafe"];
default -> "backlight" [label="Ctrl+Alt+X",color="#2563eb"];
"dunst" [label="Notifications\nDunst pause, history, logger",fillcolor="#dbeafe"];
default -> "dunst" [label="Ctrl+Alt+N",color="#2563eb"];
"player" [label="Media and audio\nPlayback, Spotify, MPV, audio input/output",fillcolor="#dbeafe"];
default -> "player" [label="Ctrl+Alt+P",color="#2563eb"];
"resize" [label="Resize\nKeyboard resize; jump to window layout",fillcolor="#dcfce7"];
default -> "resize" [label="Ctrl+Alt+R",color="#2563eb"];
"titlebar" [label="Titlebar\nTitles, font size, style",fillcolor="#dcfce7"];
default -> "titlebar" [label="Super+Shift+T",color="#2563eb"];
"mark" [label="Marks\nAdd/remove/go/swap; automark",fillcolor="#dcfce7"];
default -> "mark" [label="Super+Shift+M",color="#2563eb"];
"window_layout" [label="Window layout\nGeometry, floating, hiding, autotiling",fillcolor="#dcfce7"];
default -> "window_layout" [label="Super+Shift+W",color="#2563eb"];
"workspace" [label="Workspace\nSave/restore, rename, move, swap",fillcolor="#dcfce7"];
default -> "workspace" [label="Super+Shift+P",color="#2563eb"];
"swap_workspace" [label="Swap workspace\nDirect 1–40 or interactive swap",fillcolor="#dcfce7"];
default -> "swap_workspace" [label="Super+P",color="#2563eb"];
"open_url" [label="Open URL\nBatch browser launch; AI and research",fillcolor="#fef3c7"];
default -> "open_url" [label="Ctrl+Alt+O",color="#2563eb"];
"customization" [label="Customization\nTheme, wallpaper, border, Conky, Dunst, Picom",fillcolor="#fce7f3"];
default -> "customization" [label="Super+Shift+C",color="#2563eb"];
"gaps" [label="Gaps\nInner/outer/directional gaps and presets",fillcolor="#fce7f3"];
default -> "gaps" [label="Ctrl+Alt+G",color="#2563eb"];
"i3bar" [label="Bar\nMode, position, size, theme",fillcolor="#fce7f3"];
default -> "i3bar" [label="Super+Shift+B",color="#2563eb"];
rofi_search [label="Omnisearch Search\nFlat two-column list with Find / Open / Tool / Go / Help / System prefixes",fillcolor="#e9d5ff"];
rofi_depth [label="Omnisearch deeper screens\nResults, preview, actions, PDF tasks, cache",fillcolor="#f3e8ff"];
rofi_action [label="Action Rofi dialogs\nWindow geometry, marks, workspace, display, status",fillcolor="#f3e8ff"];
keyhelp [label="Keybinding help\nShortcut guide / all keybindings",fillcolor="#e9d5ff"];
default -> keyhelp [label="Super+Shift+/",color="#9333ea"];
keyhelp -> rofi_search [label="Esc",color="#9333ea"];
login [label="Login summary (notification)\nVolume, caffeine, autotiling, bar,\nfocus mode, ⚠ items; help hints",shape=note,fillcolor="#f8fafc"];
login -> default [style=dotted,color="#64748b",label="session start"];
default -> rofi_search [label="Super+Backslash",color="#9333ea"];
rofi_search -> rofi_depth [label="Enter",color="#9333ea"];
rofi_depth -> rofi_search [label="Alt+B",color="#9333ea"];
rofi_depth -> rofi_depth [label="Esc: parent",color="#9333ea"];
rofi_search -> default [label="Esc: close",color="#9333ea",constraint=false];
rofi_depth -> default [label="action / close",color="#9333ea",constraint=false];
default -> rofi_action [label="direct shortcuts",color="#9333ea"];
rofi_action -> default [label="select / Esc: return to caller",color="#9333ea",constraint=false];
// File sharing and file-manager workflow.
ranger [label="Ranger\nFile navigation, open-with, trash",fillcolor="#ccfbf1"];
local_send [label="LocalSend picker\nSelected files; directories archived",fillcolor="#99f6e4"];
local_receive [label="LocalSend receiver\nTemporary destination = current Ranger directory",fillcolor="#99f6e4"];
local_tui [label="LocalSend CLI\nFloating terminal for discovery / receive",fillcolor="#99f6e4"];
default -> ranger [label="Ctrl+Alt+2",color="#0f766e"];
ranger -> local_send [label=",s: send selection",color="#0f766e"];
ranger -> local_receive [label=",r: receive here",color="#0f766e"];
local_send -> ranger [label="CLI ends; redraw",color="#0f766e",constraint=false];
local_receive -> ranger [label="Ctrl+C / CLI ends; redraw",color="#0f766e",constraint=false];
"toolkit" -> local_tui [label="l: open LocalSend",color="#0f766e"];
local_tui -> default [label="close terminal",color="#0f766e",constraint=false];
status [label="System status (s)\nRofi tabs: Devices · Session · Background\n⚠ rows that need attention",fillcolor="#e0f2fe"];
"system" -> status [label="s",color="#0284c7"];
status -> default [label="Enter / Esc",color="#0284c7",constraint=false];
bar [label="Two i3 bars\nBumblebee status + workspace names; mode bar shows key context",fillcolor="#f8fafc"];
default -> bar [style=dotted,color="#64748b",label="persistent UI"];
mode_rules [label="Mode rules\nEnter: parent (root: normal)\nMost modes: Esc / Ctrl+[ → normal\nOne-off action: normal; batch: stay\nInsert: Ctrl+Alt+I / Super+Ctrl+I / Ctrl+[ exit\nVim: Ctrl+[ exits\nMouse: Esc / Enter / Ctrl+Alt+M exits",shape=note,fillcolor="#f8fafc"];
default -> mode_rules [style=invis];
rofi_rules [label="Rofi rules\nOmnisearch: Esc local, Alt+B global\nOther action dialogs: Esc closes\nRofi overlay returns to the caller unless binding exits mode",shape=note,fillcolor="#f8fafc"];
rofi_search -> rofi_rules [style=invis];
}
