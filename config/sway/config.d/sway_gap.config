# ~/.config/sway/config.d/sway_gap.config
# vim: ft=swayconfig ff=unix
# ======================================================================================
# All About i3-gap Gap Setting
# ======================================================================================
# This is setup for gaps in i3 (i3-gaps has been merged to i3 in i3 v4.22)

# Set default gaps size
gaps inner $default_inner_gap
gaps outer $default_outer_gap

# Gaps options
# -- on: ONLY enable outer and inner gaps when there are more than one container
# -- inverse_outer: ONLY enable outer gaps when there is exactly one container
#smart_gaps on

# i3-gap (shortcut for current workspace)
# Outer gaps
bindsym Ctrl+Mod1+Shift+h gaps horizontal current minus 5
bindsym Ctrl+Mod1+Shift+j gaps vertical current minus 5
bindsym Ctrl+Mod1+Shift+k gaps vertical current plus 5
bindsym Ctrl+Mod1+Shift+l gaps horizontal current plus 5
# Inner gaps
bindsym Ctrl+Mod1+Shift+minus gaps inner current minus 5
bindsym Ctrl+Mod1+Shift+equal gaps inner current plus 5
bindsym Ctrl+Mod1+Shift+m     gaps inner current minus 5
bindsym Ctrl+Mod1+Shift+p     gaps inner current plus 5
# Default gaps
bindsym Ctrl+Mod1+Shift+o gaps outer current set $default_outer_gap
bindsym Ctrl+Mod1+Shift+i gaps inner current set $default_inner_gap
bindsym Ctrl+Mod1+Shift+g gaps outer current set $default_outer_gap, gaps inner current set $default_inner_gap
# Disable all gaps
bindsym Ctrl+Mod1+Shift+u gaps inner current set 0, gaps outer current set 0

# i3-gap (modify in mode, works for both current workspace and global workspace)
# -- https://github.com/Airblader/i3/wiki/Example-Configuration
# NOTE: horiz, verti, top, right, bottom, left are all part of outer gaps
# $mode_gaps: label defined in sway_mode_name.config
bindsym Ctrl+Mod1+g mode "$mode_gaps"
mode "$mode_gaps" {
    bindsym o mode "$mode_gaps_outer"
    bindsym i mode "$mode_gaps_inner"
    bindsym h mode "$mode_gaps_horiz"
    bindsym v mode "$mode_gaps_verti"
    bindsym t mode "$mode_gaps_top"
    bindsym r mode "$mode_gaps_right"
    bindsym b mode "$mode_gaps_bottom"
    bindsym l mode "$mode_gaps_left"
    # Set default inner/outer gap
    bindsym s       mode "$mode_set_inner_gap"
    bindsym Shift+s mode "$mode_set_outer_gap"
    # Set gap options
    bindsym g mode "$mode_gap_option"
    # Exit mode: "Enter", "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Return           mode "default"
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Set inner gaps (within gap mode)
# $mode_gaps_inner: label defined in sway_mode_name.config
mode "$mode_gaps_inner" {
    # Local
    bindsym equal  gaps inner current plus 5
    bindsym minus gaps inner current minus 5
    bindsym 0     gaps inner current set 0
    bindsym d     gaps inner current set $default_inner_gap
    # Global
    bindsym Shift+equal  gaps inner all plus 5
    bindsym Shift+minus gaps inner all minus 5
    bindsym Shift+0     gaps inner all set 0
    bindsym Shift+d     gaps inner all set $default_inner_gap
    # Back to gap mode: "Enter"
    bindsym Return mode "$mode_gaps"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Set outer gaps (within gap mode)
# $mode_gaps_outer: label defined in sway_mode_name.config
mode "$mode_gaps_outer" {
    # Local
    bindsym equal  gaps outer current plus 5
    bindsym minus gaps outer current minus 5
    bindsym 0     gaps outer current set 0
    bindsym d     gaps outer current set $default_outer_gap
    # Global
    bindsym Shift+equal  gaps outer all plus 5
    bindsym Shift+minus gaps outer all minus 5
    bindsym Shift+0     gaps outer all set 0
    bindsym Shift+d     gaps outer all set $default_outer_gap
    # Back to gap mode: "Enter"
    bindsym Return mode "$mode_gaps"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Set horizontal (both left and right) gaps (within gap mode)
# $mode_gaps_horiz: label defined in sway_mode_name.config
mode "$mode_gaps_horiz" {
    # Local
    bindsym equal  gaps horizontal current plus 5
    bindsym minus gaps horizontal current minus 5
    bindsym 0     gaps horizontal current set 0
    bindsym d     gaps horizontal current set $default_outer_gap
    # Global
    bindsym Shift+equal  gaps horizontal all plus 5
    bindsym Shift+minus gaps horizontal all minus 5
    bindsym Shift+0     gaps horizontal all set 0
    bindsym Shift+d     gaps horizontal all set $default_outer_gap
    # Back to gap mode: "Enter"
    bindsym Return mode "$mode_gaps"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Set vertical (both top and bottom) gaps (within gap mode)
# $mode_gaps_verti: label defined in sway_mode_name.config
mode "$mode_gaps_verti" {
    # Local
    bindsym equal  gaps vertical current plus 5
    bindsym minus gaps vertical current minus 5
    bindsym 0     gaps vertical current set 0
    bindsym d     gaps vertical current set $default_outer_gap
    # Global
    bindsym Shift+equal  gaps vertical all plus 5
    bindsym Shift+minus gaps vertical all minus 5
    bindsym Shift+0     gaps vertical all set 0
    bindsym Shift+d     gaps vertical all set $default_outer_gap
    # Back to gap mode: "Enter"
    bindsym Return mode "$mode_gaps"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Set top gaps (within gap mode)
# $mode_gaps_top: label defined in sway_mode_name.config
mode "$mode_gaps_top" {
    # Local
    bindsym equal  gaps top current plus 5
    bindsym minus gaps top current minus 5
    bindsym 0     gaps top current set 0
    bindsym d     gaps top current set $default_outer_gap
    # Global
    bindsym Shift+equal  gaps top all plus 5
    bindsym Shift+minus gaps top all minus 5
    bindsym Shift+0     gaps top all set 0
    bindsym Shift+d     gaps top all set $default_outer_gap
    # Back to gap mode: "Enter"
    bindsym Return mode "$mode_gaps"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Set right gaps (within gap mode)
# $mode_gaps_right: label defined in sway_mode_name.config
mode "$mode_gaps_right" {
    # Local
    bindsym equal  gaps right current plus 5
    bindsym minus gaps right current minus 5
    bindsym 0     gaps right current set 0
    bindsym d     gaps right current set $default_outer_gap
    # Global
    bindsym Shift+equal  gaps right all plus 5
    bindsym Shift+minus gaps right all minus 5
    bindsym Shift+0     gaps right all set 0
    bindsym Shift+d     gaps right all set $default_outer_gap
    # Back to gap mode: "Enter"
    bindsym Return mode "$mode_gaps"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Set bottom gaps (within gap mode)
# $mode_gaps_bottom: label defined in sway_mode_name.config
mode "$mode_gaps_bottom" {
    # Local
    bindsym equal  gaps bottom current plus 5
    bindsym minus gaps bottom current minus 5
    bindsym 0     gaps bottom current set 0
    bindsym d     gaps bottom current set $default_outer_gap
    # Global
    bindsym Shift+equal  gaps bottom all plus 5
    bindsym Shift+minus gaps bottom all minus 5
    bindsym Shift+0     gaps bottom all set 0
    bindsym Shift+d     gaps bottom all set $default_outer_gap
    # Back to gap mode: "Enter"
    bindsym Return mode "$mode_gaps"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Set left gaps (within gap mode)
# $mode_gaps_left: label defined in sway_mode_name.config
mode "$mode_gaps_left" {
    # Local
    bindsym equal  gaps left current plus 5
    bindsym minus gaps left current minus 5
    bindsym 0     gaps left current set 0
    bindsym d     gaps left current set $default_outer_gap
    # Global
    bindsym Shift+equal  gaps left all plus 5
    bindsym Shift+minus gaps left all minus 5
    bindsym Shift+0     gaps left all set 0
    bindsym Shift+d     gaps left all set $default_outer_gap
    # Back to gap mode: "Enter"
    bindsym Return mode "$mode_gaps"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Set outer gap (left, top, bottom and right) (within gap mode)
# $mode_set_outer_gap: label defined in sway_mode_name.config
mode "$mode_set_outer_gap" {
    bindsym 1 exec $SWAY_SCRIPT/sway_default_valuechanger.sh outer_gap 5; mode "default"
    bindsym 2 exec $SWAY_SCRIPT/sway_default_valuechanger.sh outer_gap 10; mode "default"
    bindsym 3 exec $SWAY_SCRIPT/sway_default_valuechanger.sh outer_gap 15; mode "default"
    bindsym 4 exec $SWAY_SCRIPT/sway_default_valuechanger.sh outer_gap 20; mode "default"
    bindsym 5 exec $SWAY_SCRIPT/sway_default_valuechanger.sh outer_gap 25; mode "default"
    bindsym 6 exec $SWAY_SCRIPT/sway_default_valuechanger.sh outer_gap 30; mode "default"
    bindsym 7 exec $SWAY_SCRIPT/sway_default_valuechanger.sh outer_gap 35; mode "default"
    bindsym 8 exec $SWAY_SCRIPT/sway_default_valuechanger.sh outer_gap 40; mode "default"
    bindsym 9 exec $SWAY_SCRIPT/sway_default_valuechanger.sh outer_gap 45; mode "default"
    bindsym i exec $SWAY_SCRIPT/sway_default_valuechanger.sh outer_gap input; mode "default"
    # Disable outer gap
    bindsym 0 exec $SWAY_SCRIPT/sway_default_valuechanger.sh outer_gap 0; mode "default"
    # Negative gap size (shrink inside)
    bindsym Shift+1 exec $SWAY_SCRIPT/sway_default_valuechanger.sh outer_gap -5; mode "default"
    bindsym Shift+2 exec $SWAY_SCRIPT/sway_default_valuechanger.sh outer_gap -10; mode "default"
    bindsym Shift+3 exec $SWAY_SCRIPT/sway_default_valuechanger.sh outer_gap -15; mode "default"
    bindsym Shift+4 exec $SWAY_SCRIPT/sway_default_valuechanger.sh outer_gap -20; mode "default"
    bindsym Shift+5 exec $SWAY_SCRIPT/sway_default_valuechanger.sh outer_gap -25; mode "default"
    bindsym Shift+6 exec $SWAY_SCRIPT/sway_default_valuechanger.sh outer_gap -30; mode "default"
    bindsym Shift+7 exec $SWAY_SCRIPT/sway_default_valuechanger.sh outer_gap -35; mode "default"
    bindsym Shift+8 exec $SWAY_SCRIPT/sway_default_valuechanger.sh outer_gap -40; mode "default"
    bindsym Shift+9 exec $SWAY_SCRIPT/sway_default_valuechanger.sh outer_gap -45; mode "default"
    # Back to gap mode: "Enter"
    bindsym Return mode "$mode_gaps"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Set inner gap (left, top, bottom and right) (within gap mode)
# $mode_set_inner_gap: label defined in sway_mode_name.config
mode "$mode_set_inner_gap" {
    bindsym 1 exec $SWAY_SCRIPT/sway_default_valuechanger.sh inner_gap 5; mode "default"
    bindsym 2 exec $SWAY_SCRIPT/sway_default_valuechanger.sh inner_gap 10; mode "default"
    bindsym 3 exec $SWAY_SCRIPT/sway_default_valuechanger.sh inner_gap 15; mode "default"
    bindsym 4 exec $SWAY_SCRIPT/sway_default_valuechanger.sh inner_gap 20; mode "default"
    bindsym 5 exec $SWAY_SCRIPT/sway_default_valuechanger.sh inner_gap 25; mode "default"
    bindsym 6 exec $SWAY_SCRIPT/sway_default_valuechanger.sh inner_gap 30; mode "default"
    bindsym 7 exec $SWAY_SCRIPT/sway_default_valuechanger.sh inner_gap 35; mode "default"
    bindsym 8 exec $SWAY_SCRIPT/sway_default_valuechanger.sh inner_gap 40; mode "default"
    bindsym 9 exec $SWAY_SCRIPT/sway_default_valuechanger.sh inner_gap 45; mode "default"
    bindsym i exec $SWAY_SCRIPT/sway_default_valuechanger.sh inner_gap input; mode "default"
    # Disable inner gap
    bindsym 0 exec $SWAY_SCRIPT/sway_default_valuechanger.sh inner_gap 0; mode "default"
    # Negative gap size (shrink inside)
    bindsym Shift+1 exec $SWAY_SCRIPT/sway_default_valuechanger.sh inner_gap -5; mode "default"
    bindsym Shift+2 exec $SWAY_SCRIPT/sway_default_valuechanger.sh inner_gap -10; mode "default"
    bindsym Shift+3 exec $SWAY_SCRIPT/sway_default_valuechanger.sh inner_gap -15; mode "default"
    bindsym Shift+4 exec $SWAY_SCRIPT/sway_default_valuechanger.sh inner_gap -20; mode "default"
    bindsym Shift+5 exec $SWAY_SCRIPT/sway_default_valuechanger.sh inner_gap -25; mode "default"
    bindsym Shift+6 exec $SWAY_SCRIPT/sway_default_valuechanger.sh inner_gap -30; mode "default"
    bindsym Shift+7 exec $SWAY_SCRIPT/sway_default_valuechanger.sh inner_gap -35; mode "default"
    bindsym Shift+8 exec $SWAY_SCRIPT/sway_default_valuechanger.sh inner_gap -40; mode "default"
    bindsym Shift+9 exec $SWAY_SCRIPT/sway_default_valuechanger.sh inner_gap -45; mode "default"
    # Back to gap mode: "Enter"
    bindsym Return mode "$mode_gaps"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Set smart gap option (within gap mode)
# $mode_gap_option: label defined in sway_mode_name.config
mode "$mode_gap_option" {
    bindsym 1 exec $SWAY_SCRIPT/sway_gap_operator.sh smart_gaps_on; mode "default"
    bindsym 2 exec $SWAY_SCRIPT/sway_gap_operator.sh smart_gaps_inverse_outer; mode "default"
    bindsym 3 exec $SWAY_SCRIPT/sway_gap_operator.sh smart_gaps_off; mode "default"
    # Back to gap mode: "Enter"
    bindsym Return mode "$mode_gaps"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}
