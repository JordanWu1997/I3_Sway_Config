set $mode_customization Customization: [b]order [c]onky [d]unst [p]:opacity (picom) [f]lashfocus [t]heme [w]allpaper [v]ariety [F]ont [r]eload
set $mode_wallpaper Wallpaper: [i]nfo [(Shift)+1/2/3/4/5/6/7/8/9/d/a]:(select)/random from WALLPAPER#/default/all [Ctrl+s/d]:save to_favorite/as_default [r]estore_to_default [t]heme
set $mode_variety Variety: [i]nfo [p]revious [n]ext [Ctrl+s/d]:save to_favoriate/as_default [(Shift)+f/a]:(select)/shuffle favorite/all_downloaded [P]ause [R]esume [q]uit [t]heme
set $mode_border Border: [1]:border_width [2]:border_option [3]:border_colorscheme
set $mode_border_width Border width: [1]:1pix [2]:2pix [3]:3pix [4]:4pix [5]:5pix [9]:10pix [0]:no_border [r]estore_to_default [s]et_default_border_width
set $mode_set_border Set default border width: [1]:1pix [2]:2pix [3]:3pix [4]:4pix [5]:5pix [9]:10pix [0]:no_border [i]nput
set $mode_border_option Border option: [1]:show_both_edge [2]:hide_both_edge [3]:hide_top/bottom_edge [4]:hide_left/right_edge [5]:hide_both_edge_if_only_one [6]:hide_both_edge_if_no_outer_gaps
set $mode_border_colorscheme Border colorscheme: [1]:monochromic [2]:dirchromatic [3]:monochromic_inversed [4]:i3_default
set $mode_dunst_option Dunst option: [1]:position [2]:xoffset [3]:yoffset [4]:text_alignment [5]:fontsize [6]:icon_position [r]eload
set $mode_dunst_position Dunst position: [1/2/3]:top-left/center/right [4/5/6]:center-left/center/right [7/8/9]:bottom-left/center/right
set $mode_dunst_xoffset Dunst xoffset: [1]:10pix [2]:15pix [3]:20pix [4]:25pix [5]:30pix [6]:35pix [7]:40pix [8]:45pix [9]:50px [0]:no_xoffset [i]nput
set $mode_dunst_yoffset Dunst yoffset: [1]:10pix [2]:15pix [3]:20pix [4]:25pix [5]:30pix [6]:35pix [7]:40pix [8]:45pix [9]:50px [0]:no_yoffset [i]nput
set $mode_dunst_alignment Dunst alignment: [1]:left [2]:center [3]:right
set $mode_dunst_fontsize Dunst fontsize: [1]:8pix [2]:9pix [3]:10pix [4]:11pix [5]:12pix [6]:13pix [7]:14pix [8]:15pix [9]:16pix [i]nput
set $mode_dunst_icon_position Dunst icon position: [1]:left [2]:top [3]:right [0]:off
set $mode_conky Conky: [1]:bindkey_sheet [2]:system_monitor [3/4/5]:show_all_conky on default/primary/all display [0]:killall_conky [s]et_conky_style [c]onky_startup [r]eload
set $mode_conky_bindkey Bindkey: [e]nable [d]isable [1]:title_color [2]:item_color [3]:background_opacity [4]:position
set $mode_conky_system System: [e]nable [d]isable [1]:title_color [2]:item_color [3]:background_opacity [4]:position [5]:re-generate_for_new_hardware
set $mode_conky_bindkey_opacity Bindkey opacity: [1]:0% [2]:25% [3]:50% [4]:75% [5]:100%
set $mode_conky_system_opacity System opacity: [1]:0% [2]:25% [3]:50% [4]:75% [5]:100%
set $mode_conky_bindkey_position Bindkey position: [1]:bottom_left [2]:bottom_right
set $mode_conky_system_position System position: [1]:top_left [2]:top_right
set $mode_conky_palette_bindkey_item Color for conky bindkey item: [1/F1]:black [2/F2]:red [3/F3]:green [4/F4]:yellow [5/F5]:blue [6/F6]:magenta [7/F7]:cyan [8/F8]:white
set $mode_conky_palette_bindkey_title Color for conky bindkey title: [1/F1]:black [2/F2]:red [3/F3]:green [4/F4]:yellow [5/F5]:blue [6/F6]:magenta [7/F7]:cyan [8/F8]:white
set $mode_conky_palette_system_item Color for conky system item: [1/F1]:black [2/F2]:red [3/F3]:green [4/F4]:yellow [5/F5]:blue [6/F6]:magenta [7/F7]:cyan [8/F8]:white
set $mode_conky_palette_system_title Color for conky system title: [1/F1]:black [2/F2]:red [3/F3]:green [4/F4]:yellow [5/F5]:blue [6/F6]:magenta [7/F7]:cyan [8/F8]:white
set $mode_set_conky_style Set conky style: [1]:full [2]:light [3]:minimal
set $mode_set_conky_startup Set conky startup: [e]nable_startup_conky [d]isable_startup_conky
set $mode_theme Theme: [e]nable_9-color_pywal ([1~9,0]) [E]nable_16-color_pywal (Shift+[1~9,0]) [d]isable_pywal [D]isable_pywal_and_apply_template [r]eload
set $mode_custom_reload Reload: [r]eload_all (1~5) [1]:conky [2]:swaybar [3]:dunst [4]:zathura [5]:vis [6]:swayidle (xss-lock) [7]:Xresources (XWayland apps)
set $mode_picom Opacity (sway compositor): [1]:default [2]:transparency [3]:blur (SwayFX only) [0]:opaque_all [s]et_default
set $mode_set_default_picom Set default opacity: [1]:transparency [2]:blur (SwayFX only)
set $mode_flashfocus Flashfocus: [e]nable_flashfocus [d]isable_flashfocus [r]efresh_flashfocus [s]et_default_flashfocus
set $mode_set_default_flashfocus Set default flashfocus (opacity): [1]:transparency (0.6) [2]:crystal (0.7) [3]:intermediate (0.8) [4]:blur (0.9) [5]:opaque (1.0) [e]nable_at_startup [d]isable_at_startup
set $mode_font Font: [1]:sway_default_font [2]:bar_fontsize [3]:titlebar_fontsize [4/5]:kitty_font/fontsize [6/7]:rofi_font/fontsize [8/9]:dunst_font/fontsize [0]:all_font

# --------------------------------------------------------------------------------------
# from sway_bar.config
# --------------------------------------------------------------------------------------
set $mode_i3bar i3bar: [1/2]:bar dock/hide [3/4]:bar_hidden_state show/hide [r]eload_bar [b]ar_option
set $mode_i3bar_option i3bar option: [1/2]:bar_mode dock/hide [3/4]:bar_position top/bottom [5]:bar_fontsize [6]:bar_height [7]:bar_theme
set $mode_i3bar_fontsize i3bar fontsize: [1]:8pix [2]:9pix [3]:10pix [4]:11pix [5]:12pix [6]:13pix [7]:14pix [8]:15pix [9]:16pix [i]nput
set $mode_i3bar_height i3bar height: [1]:20pix [2]:25pix [3]:30pix [4]:35pix [i]nput (Please set default mode to hide before any modification)
set $mode_i3bar_theme i3bar theme: [1]:pywal [2]:i3
