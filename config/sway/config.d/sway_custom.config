# Set conky style (within conky mode)
# $mode_set_conky_style: label defined in sway_mode_name.config
mode "$mode_set_conky_style" {
    bindsym 1 exec $SWAY_SCRIPT/sway_default_valuechanger.sh conky_style full; mode "default"
    bindsym 2 exec $SWAY_SCRIPT/sway_default_valuechanger.sh conky_style light; mode "default"
    bindsym 3 exec $SWAY_SCRIPT/sway_default_valuechanger.sh conky_style minimal; mode "default"
    # Back to conky mode: "Enter"
    bindsym Return mode "$mode_conky"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Set conky startup (within conky mode)
# $mode_set_conky_startup: label defined in sway_mode_name.config
mode "$mode_set_conky_startup" {
    bindsym e exec $SWAY_SCRIPT/sway_default_valuechanger.sh conky_startup enable; mode "default"
    bindsym d exec $SWAY_SCRIPT/sway_default_valuechanger.sh conky_startup disable; mode "default"
    # Back to customization mode: "Enter"
    bindsym Return mode "$mode_conky"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Theme mode (pywal color theme support)
# -- Autotune Xcolor corresponding to current wallpaper to get a better theme consistency
# Pywal (https://github.com/dylanaraps/pywal)
# -- Installation: pip install pywal
# $mode_theme: label defined in sway_mode_name.config
mode "$mode_theme" {
    # Disable pywal (and apply theme template)
    bindsym d       exec $SWAY_SCRIPT/sway_wal_operator.sh disable_wal
    bindsym Shift+d exec $SWAY_SCRIPT/sway_wal_operator.sh disable_wal_and_apply_template
    # Wal using 9-color (with saturate; -s, -t options: Skip changing colors in terminal, tty)
    bindsym e exec $SWAY_SCRIPT/sway_wal_operator.sh enable_9_color_wal -s -t
    bindsym 1 exec $SWAY_SCRIPT/sway_wal_operator.sh enable_9_color_wal -s -t --saturate 0.1
    bindsym 2 exec $SWAY_SCRIPT/sway_wal_operator.sh enable_9_color_wal -s -t --saturate 0.2
    bindsym 3 exec $SWAY_SCRIPT/sway_wal_operator.sh enable_9_color_wal -s -t --saturate 0.3
    bindsym 4 exec $SWAY_SCRIPT/sway_wal_operator.sh enable_9_color_wal -s -t --saturate 0.4
    bindsym 5 exec $SWAY_SCRIPT/sway_wal_operator.sh enable_9_color_wal -s -t --saturate 0.5
    bindsym 6 exec $SWAY_SCRIPT/sway_wal_operator.sh enable_9_color_wal -s -t --saturate 0.6
    bindsym 7 exec $SWAY_SCRIPT/sway_wal_operator.sh enable_9_color_wal -s -t --saturate 0.7
    bindsym 8 exec $SWAY_SCRIPT/sway_wal_operator.sh enable_9_color_wal -s -t --saturate 0.8
    bindsym 9 exec $SWAY_SCRIPT/sway_wal_operator.sh enable_9_color_wal -s -t --saturate 0.9
    bindsym 0 exec $SWAY_SCRIPT/sway_wal_operator.sh enable_9_color_wal -s -t --saturate 1.0
    # Wal using 16-color (with saturate; -s, -t options: Skip changing colors in terminal, tty)
    bindsym Shift+e exec $SWAY_SCRIPT/sway_wal_operator.sh enable_16_color_wal -s -t
    bindsym Shift+1 exec $SWAY_SCRIPT/sway_wal_operator.sh enable_16_color_wal -s -t --saturate 0.1
    bindsym Shift+2 exec $SWAY_SCRIPT/sway_wal_operator.sh enable_16_color_wal -s -t --saturate 0.2
    bindsym Shift+3 exec $SWAY_SCRIPT/sway_wal_operator.sh enable_16_color_wal -s -t --saturate 0.3
    bindsym Shift+4 exec $SWAY_SCRIPT/sway_wal_operator.sh enable_16_color_wal -s -t --saturate 0.4
    bindsym Shift+5 exec $SWAY_SCRIPT/sway_wal_operator.sh enable_16_color_wal -s -t --saturate 0.5
    bindsym Shift+6 exec $SWAY_SCRIPT/sway_wal_operator.sh enable_16_color_wal -s -t --saturate 0.6
    bindsym Shift+7 exec $SWAY_SCRIPT/sway_wal_operator.sh enable_16_color_wal -s -t --saturate 0.7
    bindsym Shift+8 exec $SWAY_SCRIPT/sway_wal_operator.sh enable_16_color_wal -s -t --saturate 0.8
    bindsym Shift+9 exec $SWAY_SCRIPT/sway_wal_operator.sh enable_16_color_wal -s -t --saturate 0.9
    bindsym Shift+0 exec $SWAY_SCRIPT/sway_wal_operator.sh enable_16_color_wal -s -t --saturate 1.0
    # Reload mode
    bindsym r mode "$mode_custom_reload"
    # Back to customization mode: "Enter"
    bindsym Return mode "$mode_customization"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Customization reload mode
# $mode_custom_reload: label defined in sway_mode_name.config
mode "$mode_custom_reload" {
    # Reload all
    bindsym r exec $SWAY_SCRIPT/sway_reload_operator.sh all; mode "default"
    # Reload specific program
    bindsym 1 exec $SWAY_SCRIPT/sway_reload_operator.sh conky
    bindsym 2 exec $SWAY_SCRIPT/sway_reload_operator.sh i3bar
    bindsym 3 exec $SWAY_SCRIPT/sway_reload_operator.sh dunst
    # Zathura-pywal need to be installed mannually [https://github.com/mslcarlson/zathura-pywal]
    bindsym 4 exec $SWAY_SCRIPT/sway_reload_operator.sh zathura
    bindsym 5 exec $SWAY_SCRIPT/sway_reload_operator.sh vis
    # Restart swayidle (xss-lock replacement)
    bindsym 6 exec $SWAY_SCRIPT/sway_reload_operator.sh xsslock
    # Reload Xresources (only XWayland applications read it)
    bindsym 7 exec $SWAY_SCRIPT/sway_reload_operator.sh Xresources
    # Back to customization mode: "Enter"
    bindsym Return mode "$mode_customization"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Picom mode (animation, blur, and transparency support)
# [SWAY] sway is its own compositor: modes map to sway 'opacity' (blur requires SwayFX)
# $mode_picom: label defined in sway_mode_name.config
mode "$mode_picom" {
    bindsym 1 exec $SWAY_SCRIPT/sway_opacity_operator.sh default; mode "default"
    bindsym 2 exec $SWAY_SCRIPT/sway_opacity_operator.sh transparency; mode "default"
    bindsym 3 exec $SWAY_SCRIPT/sway_opacity_operator.sh blur; mode "default"
    bindsym 0 exec $SWAY_SCRIPT/sway_opacity_operator.sh off; mode "default"
    bindsym s mode "$mode_set_default_picom"
    # Back to customization mode: "Enter"
    bindsym Return mode "$mode_customization"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Set default picom (within picom mode)
# $mode_set_default_picom: label defined in sway_mode_name.config
mode "$mode_set_default_picom" {
    bindsym 1 exec $SWAY_SCRIPT/sway_default_valuechanger.sh picom transparency; exec $SWAY_SCRIPT/sway_opacity_operator.sh transparency; mode "default"
    bindsym 2 exec $SWAY_SCRIPT/sway_default_valuechanger.sh picom blur; exec $SWAY_SCRIPT/sway_opacity_operator.sh blur; mode "default"
    # Back to picom mode: "Enter"
    bindsym Return mode "$mode_picom"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Flashfocus mode (flash when focus changes; on sway flashfocus uses sway's own opacity IPC)
# $mode_flashfocus: label defined in sway_mode_name.config
mode "$mode_flashfocus" {
    # Flashfocus
    bindsym e exec $SWAY_SCRIPT/sway_flashfocus_operator.sh start; mode "default"
    bindsym d exec $SWAY_SCRIPT/sway_flashfocus_operator.sh stop; mode "default"
    bindsym r exec $SWAY_SCRIPT/sway_flashfocus_operator.sh restart; mode "default"
    bindsym s mode "$mode_set_default_flashfocus"
    # Back to customization mode: "Enter"
    bindsym Return mode "$mode_customization"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Set default flashfocus (within flashfocus mode)
# $mode_set_default_flashfocus: label defined in sway_mode_name.config
mode "$mode_set_default_flashfocus" {
    bindsym 1 exec $SWAY_SCRIPT/sway_default_valuechanger.sh flashfocus transparency; mode "default"
    bindsym 2 exec $SWAY_SCRIPT/sway_default_valuechanger.sh flashfocus crystal; mode "default"
    bindsym 3 exec $SWAY_SCRIPT/sway_default_valuechanger.sh flashfocus intermediate; mode "default"
    bindsym 4 exec $SWAY_SCRIPT/sway_default_valuechanger.sh flashfocus blur; mode "default"
    bindsym 5 exec $SWAY_SCRIPT/sway_default_valuechanger.sh flashfocus opaque; mode "default"
    # Enable flashfocus at startup
    bindsym e exec $SWAY_SCRIPT/sway_default_valuechanger.sh flashfocus_startup enable; mode "default"
    # Disable flashfocus at startup
    bindsym d exec $SWAY_SCRIPT/sway_default_valuechanger.sh flashfocus_startup disable; mode "default"
    # Back to flashfocus mode: "Enter"
    bindsym Return mode "$mode_flashfocus"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Font mode (set font, fontsize etc.)
# $mode_font: label defined in sway_mode_name.config
mode "$mode_font" {
    bindsym 1 exec $SWAY_SCRIPT/sway_default_valuechanger.sh i3_default_font select_from_fc; mode "default"
    bindsym 2 exec $SWAY_SCRIPT/sway_default_valuechanger.sh i3bar_fontsize input; mode "default"
    bindsym 3 exec $SWAY_SCRIPT/sway_default_valuechanger.sh titlebar_fontsize input; mode "default"
    bindsym 4 exec $SWAY_SCRIPT/sway_default_valuechanger.sh kitty_font select_from_fc; mode "default"
    bindsym 5 exec $SWAY_SCRIPT/sway_default_valuechanger.sh kitty_fontsize input; mode "default"
    bindsym 6 exec $SWAY_SCRIPT/sway_default_valuechanger.sh rofi_font select_from_fc; mode "default"
    bindsym 7 exec $SWAY_SCRIPT/sway_default_valuechanger.sh rofi_fontsize input; mode "default"
    bindsym 8 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_font select_from_fc; mode "default"
    bindsym 9 exec $SWAY_SCRIPT/sway_default_valuechanger.sh dunst_fontsize input; mode "default"
    bindsym 0 exec $SWAY_SCRIPT/sway_default_valuechanger.sh all_font select_from_fc; mode "default"
    # Back to customization mode: "Enter"
    bindsym Return mode "$mode_customization"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}
