# ~/.config/sway/config.d/sway_mode.config
# vim: ft=swayconfig ff=unix
# ======================================================================================
# All About Modes
# ======================================================================================
# This is to save all bindkeys of modes

# --------------------------------------------------------------------------------------
# 1. Keybinding-related Modes
# --------------------------------------------------------------------------------------

# Insert mode
# Like vimium/vim insert mode: i3 stops grabbing keys, so every key (Shift+space,
# Ctrl/Alt+space, Ctrl/Alt+F1-F10, ...) reaches the focused app. Use it for VMs,
# remote desktops, games, or app shortcuts that clash with i3 globals.
# The enter key also leaves the mode (toggle). Ctrl+[ leaves too, but i3 grabs it
# here, so in Vim use Escape (not Ctrl+[) while insert mode is on.
# $mode_insert: label defined in sway_mode_name.config
bindsym Ctrl+Mod1+i mode "$mode_insert"
bindsym Mod4+Ctrl+i mode "$mode_insert"
mode "$mode_insert" {
    bindsym Ctrl+Mod1+i mode "default"
    bindsym Mod4+Ctrl+i mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Vim keybinding mode
# [SWAY] xdotool (X11 XTEST) -> wtype (Wayland virtual-keyboard protocol); key names are
#        XKB keysym names. --clearmodifiers has no wtype equivalent: bindings stay --release
#        so the physical modifiers are already up when the synthetic key is sent.
# $mode_vim_keybinding: label defined in sway_mode_name.config
bindsym Mod4+Ctrl+bracketleft mode "$mode_vim_keybinding"
mode "$mode_vim_keybinding" {
    # Navigation keys
    bindsym --release h exec wtype -k Left
    bindsym --release j exec wtype -k Down
    bindsym --release k exec wtype -k Up
    bindsym --release l exec wtype -k Right
    # Special keys
    bindsym --release g       exec wtype -k Home
    bindsym --release Shift+g exec wtype -k End
    bindsym --release d       exec wtype -k Delete
    bindsym --release i       exec wtype -k Insert
    bindsym --release Ctrl+d  exec wtype -k Page_Down
    bindsym --release Ctrl+u  exec wtype -k Page_Up
    # Composed key passthrough: [Ctrl/Alt/Ctrl+Alt] + [Left/Down/Up/Right]
    bindsym --release Mod1+h      exec wtype -M alt -k Left -m alt
    bindsym --release Mod1+j      exec wtype -M alt -k Down -m alt
    bindsym --release Mod1+k      exec wtype -M alt -k Up -m alt
    bindsym --release Mod1+l      exec wtype -M alt -k Right -m alt
    bindsym --release Ctrl+h      exec wtype -M ctrl -k Left -m ctrl
    bindsym --release Ctrl+j      exec wtype -M ctrl -k Down -m ctrl
    bindsym --release Ctrl+k      exec wtype -M ctrl -k Up -m ctrl
    bindsym --release Ctrl+l      exec wtype -M ctrl -k Right -m ctrl
    bindsym --release Ctrl+Mod1+h exec wtype -M ctrl -M alt -k Left -m alt -m ctrl
    bindsym --release Ctrl+Mod1+j exec wtype -M ctrl -M alt -k Down -m alt -m ctrl
    bindsym --release Ctrl+Mod1+k exec wtype -M ctrl -M alt -k Up -m alt -m ctrl
    bindsym --release Ctrl+Mod1+l exec wtype -M ctrl -M alt -k Right -m alt -m ctrl
    # Composed key passthrough: [Ctrl/Alt] + [Shift] + [Left/Down/Up/Right])
    bindsym --release Ctrl+Shift+h exec wtype -M ctrl -M shift -k Left -m shift -m ctrl
    bindsym --release Ctrl+Shift+j exec wtype -M ctrl -M shift -k Down -m shift -m ctrl
    bindsym --release Ctrl+Shift+k exec wtype -M ctrl -M shift -k Up -m shift -m ctrl
    bindsym --release Ctrl+Shift+l exec wtype -M ctrl -M shift -k Right -m shift -m ctrl
    bindsym --release Mod1+Shift+h exec wtype -M alt -M shift -k Left -m shift -m alt
    bindsym --release Mod1+Shift+j exec wtype -M alt -M shift -k Down -m shift -m alt
    bindsym --release Mod1+Shift+k exec wtype -M alt -M shift -k Up -m shift -m alt
    bindsym --release Mod1+Shift+l exec wtype -M alt -M shift -k Right -m shift -m alt
    # i3 keybindings compatibility: move focus between output monitors ([/,/./])
    bindsym Mod4+bracketleft  focus output up
    bindsym Mod4+bracketright focus output down
    bindsym Mod4+period       focus output right
    bindsym Mod4+comma        focus output left
    # i3 keybindings compatibility: change focus and move cursor to the center of focus window
    bindsym Mod4+h focus left, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window
    bindsym Mod4+j focus down, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window
    bindsym Mod4+k focus up, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window
    bindsym Mod4+l focus right, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window
    # i3 keybindings compatibility: change focus between tiling/floating windows
    bindsym Mod4+space focus mode_toggle
    # i3 keybindings compatibility: toggle tiling/floating modes
    bindsym Mod4+Shift+space floating toggle
    # i3 keybindings compatibility: kill focused window
    bindsym Mod4+Shift+q kill
    # Exit mode: "Ctrl"+"[" (vim-like Escape)
    bindsym Ctrl+bracketleft mode "default"
}

# Mouse emulation by keyboard mapping
# -- https://www.reddit.com/r/i3wm/comments/ltjoaa/tip_mouse_emulation_using_hjkl/
# [SWAY] xdotool mousemove/click -> native sway commands, no external tool needed:
#        'seat - cursor move <dx> <dy>' and 'seat - cursor press|release buttonN'
#        (button4-7 are delivered as scroll axis events). Shift+click-and-hold still needs a
#        held Shift key, which uses ydotool (requires ydotoold + /dev/uinput access).
# $mode_mouse: label defined in sway_mode_name.config
bindsym Ctrl+Mod1+m mode "$mode_mouse"
mode "$mode_mouse" {
    # Preference Mode
    bindsym p mode "$mode_cursor_preference"
    # Magnifier: magnus is X11-only (cannot capture Wayland windows) -> woomer if installed
    bindsym m exec "command -v woomer >/dev/null && woomer || notify-send -u normal 'Magnifier' 'magnus/xzoom are X11-only. Install woomer (Wayland zoomer).'"
    # Warp (NOTE: warpd must be installed)
    # -- https://github.com/rvaiya/warpd/?tab=readme-ov-file
    bindsym Mod1+m exec warpd --normal --config $HOME/.config/warpd/config
    # Move inside focus window
    bindsym q exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window 1
    bindsym w exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window 2
    bindsym e exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window 3
    bindsym a exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window 4
    bindsym s exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window 5
    bindsym d exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window 6
    bindsym z exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window 7
    bindsym x exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window 8
    bindsym c exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window 9
    # left down up right -- extra small steps
    bindsym Ctrl+Mod1+h seat - cursor move -1 0
    bindsym Ctrl+Mod1+j seat - cursor move 0 1
    bindsym Ctrl+Mod1+k seat - cursor move 0 -1
    bindsym Ctrl+Mod1+l seat - cursor move 1 0
    # left down up right -- small steps
    bindsym Ctrl+h seat - cursor move -5 0
    bindsym Ctrl+j seat - cursor move 0 5
    bindsym Ctrl+k seat - cursor move 0 -5
    bindsym Ctrl+l seat - cursor move 5 0
    # left down up right -- intermediate steps
    bindsym h seat - cursor move -25 0
    bindsym j seat - cursor move 0 25
    bindsym k seat - cursor move 0 -25
    bindsym l seat - cursor move 25 0
    # left down up right -- large steps
    bindsym Mod1+h seat - cursor move -125 0
    bindsym Mod1+j seat - cursor move 0 125
    bindsym Mod1+k seat - cursor move 0 -125
    bindsym Mod1+l seat - cursor move 125 0
    # click: scroll wheel up/down/left/right
    bindsym Ctrl+period       seat - cursor press button4
    bindsym Ctrl+comma        seat - cursor press button5
    bindsym Ctrl+bracketleft  seat - cursor press button4
    bindsym Ctrl+bracketright seat - cursor press button5
    # click: scroll wheel up/down/left/right -- repeat 2 times
    bindsym period       seat - cursor press button4, seat - cursor press button4
    bindsym comma        seat - cursor press button5, seat - cursor press button5
    bindsym bracketleft  seat - cursor press button6, seat - cursor press button6
    bindsym bracketright seat - cursor press button7, seat - cursor press button7
    # click: scroll wheel up/down/left/right -- repeat 10 times
    bindsym Mod1+period       exec "for i in $(seq 10); do swaymsg seat - cursor press button4; done"
    bindsym Mod1+comma        exec "for i in $(seq 10); do swaymsg seat - cursor press button5; done"
    bindsym Mod1+bracketleft  exec "for i in $(seq 10); do swaymsg seat - cursor press button6; done"
    bindsym Mod1+bracketright exec "for i in $(seq 10); do swaymsg seat - cursor press button7; done"
    # click: scroll wheel up/down/left/right -- repeat 20 times
    bindsym Ctrl+Mod1+period       exec "for i in $(seq 20); do swaymsg seat - cursor press button4; done"
    bindsym Ctrl+Mod1+comma        exec "for i in $(seq 20); do swaymsg seat - cursor press button5; done"
    bindsym Ctrl+Mod1+bracketleft  exec "for i in $(seq 20); do swaymsg seat - cursor press button6; done"
    bindsym Ctrl+Mod1+bracketright exec "for i in $(seq 20); do swaymsg seat - cursor press button7; done"
    # click-and-hold: left mid right
    bindsym Ctrl+u seat - cursor press button1
    bindsym Ctrl+i seat - cursor press button2
    bindsym Ctrl+o seat - cursor press button3
    # click: left mid right
    bindsym u seat - cursor press button1, seat - cursor release button1
    bindsym i seat - cursor press button2, seat - cursor release button2
    bindsym o seat - cursor press button3, seat - cursor release button3
    # release: left mid right
    bindsym Mod1+u seat - cursor release button1
    bindsym Mod1+i seat - cursor release button2
    bindsym Mod1+o seat - cursor release button3
    # click-and-hold: Shift+left/mid/right
    bindsym --release Ctrl+Shift+u exec ydotool key 42:1 && swaymsg seat - cursor press button1
    bindsym --release Ctrl+Shift+i exec ydotool key 42:1 && swaymsg seat - cursor press button2
    bindsym --release Ctrl+Shift+o exec ydotool key 42:1 && swaymsg seat - cursor press button3
    # release: Shift+left/mid/right
    bindsym --release Mod1+Shift+u exec swaymsg seat - cursor release button1 && ydotool key 42:0
    bindsym --release Mod1+Shift+i exec swaymsg seat - cursor release button2 && ydotool key 42:0
    bindsym --release Mod1+Shift+o exec swaymsg seat - cursor release button3 && ydotool key 42:0
    # click: thumb button 1/2
    bindsym g seat - cursor press button8, seat - cursor release button8
    bindsym y seat - cursor press button9, seat - cursor release button9
    # Dunst compatibility: notification actions
    bindsym Ctrl+space            exec dunstctl close
    bindsym Ctrl+Shift+space      exec dunstctl history-pop
    bindsym Mod1+space            exec dunstctl close
    bindsym Mod1+Shift+space      exec dunstctl history-pop
    bindsym Ctrl+Mod1+Shift+space exec dunstctl action
    # i3 keybindings compatibility: title bar toggle
    bindsym Mod4+t border toggle $default_border_width
    # i3 keybindings compatibility: toggle stickiness of floating window
    bindsym Mod4+Shift+s exec $SWAY_SCRIPT/sway_window_operator.sh toggle_sticky_current
    # i3 keybindings compatibility: fullscreen
    bindsym Mod4+f       fullscreen toggle
    bindsym Mod4+Shift+f fullscreen toggle global
    bindsym Ctrl+Mod1+f exec $SWAY_SCRIPT/sway_window_operator.sh float_then_fulfill_workspace
    # i3 keybindings compatibility: cycle window focus with automarks
    bindsym Mod4+n exec $SWAY_SCRIPT/sway_automark_operator.sh cycle_focus_inc
    bindsym Mod4+i exec $SWAY_SCRIPT/sway_automark_operator.sh cycle_focus_dec
    # i3 keybindings compatibility: swap window with automarks
    bindsym Mod4+Shift+n exec $SWAY_SCRIPT/sway_automark_operator.sh cycle_swap_inc
    bindsym Mod4+Shift+i exec $SWAY_SCRIPT/sway_automark_operator.sh cycle_swap_dec
    # i3 keybindings compatibility: mouse button actions
    bindsym Mod4+o floating toggle
    # i3 keybindings compatibility: change focus and move cursor to the center of focus window
    bindsym Mod4+h focus left, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window
    bindsym Mod4+j focus down, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window
    bindsym Mod4+k focus up, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window
    bindsym Mod4+l focus right, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window
    # i3 keybindings compatibility: move focused window
    bindsym Mod4+Shift+h move left, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window
    bindsym Mod4+Shift+j move down, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window
    bindsym Mod4+Shift+k move up, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window
    bindsym Mod4+Shift+l move right, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window
    # i3 keybindings compatibility: move focus between output monitors (,/[/]/.)
    bindsym Mod4+comma        focus output left
    bindsym Mod4+bracketleft  focus output down
    bindsym Mod4+bracketright focus output up
    bindsym Mod4+period       focus output right
    # i3 keybindings compatibility: move window and focus between output monitors (</{/}/>)
    bindsym Mod4+Shift+comma        move container to output left; focus output left
    bindsym Mod4+Shift+bracketleft  move container to output down; focus output down
    bindsym Mod4+Shift+bracketright move container to output up; focus output up
    bindsym Mod4+Shift+period       move container to output right; focus output right
    # i3 keybindings compatibility: scratchpad
    bindsym Mod4+minus move scratchpad
    bindsym Mod4+equal  scratchpad show
    # i3 keybindings compatibility: scratchpad
    bindsym Mod4+z move scratchpad
    bindsym Mod4+g scratchpad show
    # i3 keybindings compatibility: change focus between tiling/floating windows
    bindsym Mod4+space focus mode_toggle
    # i3 keybindings compatibility: toggle tiling/floating
    bindsym Mod4+Shift+space floating toggle
    # i3 keybindings compatibility: kill focused window
    bindsym Mod4+Shift+q kill
    # Exit mode: "Enter", "Escape", or "Ctrl+Alt+m" (mode bindkey), or "Alt+m" (for HHKB)
    bindsym Return      mode "default"
    bindsym Escape      mode "default"
    bindsym Ctrl+Mod1+m mode "default"
}

# Cursor preference mode (within mouse mode)
# NOTE: unclutter must be installed
# $mode_cursor_preference: label defined in sway_mode_name.config
mode "$mode_cursor_preference" {
    # Cursor autohide [unclutter-xfixes need to be installed]
    bindsym 1 exec $SWAY_SCRIPT/sway_cursor_operator.sh enable_unclutter; mode "default"
    bindsym 2 exec $SWAY_SCRIPT/sway_cursor_operator.sh disable_unclutter; mode "default"
    bindsym 3 exec $SWAY_SCRIPT/sway_cursor_operator.sh set_unclutter_as_default; mode "default"
    bindsym 4 exec $SWAY_SCRIPT/sway_cursor_operator.sh set_no_unclutter_as_default; mode "default"
    bindsym 5 exec $SWAY_SCRIPT/sway_cursor_operator.sh enable_focus_follows_mouse; mode "default"
    bindsym 6 exec $SWAY_SCRIPT/sway_cursor_operator.sh disable_focus_follows_mouse; mode "default"
    bindsym 7 exec $SWAY_SCRIPT/sway_cursor_operator.sh enable_mouse_follows_focus; mode "default"
    bindsym 8 exec $SWAY_SCRIPT/sway_cursor_operator.sh disable_mouse_follows_focus; mode "default"
    # Back to mouse mode: "Enter"
    bindsym Return mode "$mode_mouse"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# --------------------------------------------------------------------------------------
# 2. System-related Modes
# --------------------------------------------------------------------------------------

# System mode
# $mode_system: label defined in sway_mode_name.config
bindsym Ctrl+Mod1+s      mode "$mode_system"
bindsym Ctrl+Mod1+Delete mode "$mode_system"
mode "$mode_system" {
    # Bluetooth mode
    bindsym b mode "$mode_bluetooth"
    # Network mode
    bindsym n mode "$mode_network"
    # RF device mode
    bindsym r mode "$mode_RF_device"
    # Display mode
    bindsym d mode "$mode_display"
    # Terminal mode
    bindsym t mode "$mode_terminal"
    # Kill process (one-off action)
    bindsym k exec $SWAY_SCRIPT/sway_toolkit_operator.sh kill_process; mode "default"
    # Kill process (batch-kill mode)
    bindsym Shift+k exec $SWAY_SCRIPT/sway_toolkit_operator.sh kill_process
    # One status view: devices, session toggles and background components
    bindsym s exec $SWAY_SCRIPT/sway_system_status.sh show; mode "default"
    # System
    bindsym Shift+r exec systemctl reboot; mode "default"
    bindsym Shift+p exec systemctl poweroff; mode "default"
    # NOTE: Here use no-fork i3lock to bypass xss-lock to prevent that you need to unlock i3lock before system suspends
    bindsym Shift+s exec $SWAY_SCRIPT/sway_lock_operator.sh mannual_suspend; mode "default"
    bindsym Shift+h exec systemctl hibernate; mode "default"
    bindsym Shift+e exit; mode "default"
    # Lock (xss-lock -> swayidle 'lock' event handler, see sway_idle_operator.sh)
    bindsym l       exec loginctl lock-session; mode "default"
    # [SWAY] 'xset dpms force off' -> 'output * power off'. Unlike X DPMS, sway does not wake
    #        outputs on input by itself, so a one-shot swayidle powers them back on at resume.
    bindsym Shift+l exec loginctl lock-session && sleep 1 && swayidle -w timeout 1 'swaymsg "output * power off"' resume 'swaymsg "output * power on"; pkill -n swayidle'; mode "default"
    # Exit mode: "Enter", "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Return           mode "default"
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# RF mode (within system mode)
# $mode_RF_device: label defined in sway_mode_name.config
mode "$mode_RF_device" {
    # RF device control
    bindsym 1 exec $I3_SCRIPT/i3_RF_device_operator.sh enable_RF_device; mode "default"
    bindsym 2 exec $I3_SCRIPT/i3_RF_device_operator.sh disable_RF_device; mode "default"
    # Back to system mode: "Enter"
    bindsym Return mode "$mode_system"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Network mode (within system mode)
# $mode_network: label defined in sway_mode_name.config
mode "$mode_network" {
    # Network connection control
    bindsym 1 exec $I3_SCRIPT/i3_network_operator.sh connection_up; mode "default"
    bindsym 2 exec $I3_SCRIPT/i3_network_operator.sh connection_down; mode "default"
    bindsym 3 exec $I3_SCRIPT/i3_network_operator.sh enable_wifi; mode "default"
    bindsym 4 exec $I3_SCRIPT/i3_network_operator.sh disable_wifi; mode "default"
    bindsym 5 exec $I3_SCRIPT/i3_network_operator.sh enable_networking; mode "default"
    bindsym 6 exec $I3_SCRIPT/i3_network_operator.sh disable_networking; mode "default"
    # Reload nm-applet (NetworkManager in system tray)
    bindsym r exec "killall nm-applet; nm-applet --indicator"; mode "default"
    # Back to system mode: "Enter"
    bindsym Return mode "$mode_system"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Bluetooth mode (within system mode)
# $mode_bluetooth: label defined in sway_mode_name.config
mode "$mode_bluetooth" {
    # Bluetooth device control
    bindsym 1 exec $I3_SCRIPT/i3_bluetooth_operator.sh connect_bluetooth_device; mode "default"
    bindsym 2 exec $I3_SCRIPT/i3_bluetooth_operator.sh disconnect_bluetooth_device; mode "default"
    bindsym 3 exec $I3_SCRIPT/i3_bluetooth_operator.sh reconnect_bluetooth_device; mode "default"
    # Bluetooth discoverability
    bindsym 4 exec $I3_SCRIPT/i3_bluetooth_operator.sh enable_bluetooth_discoverability; mode "default"
    bindsym 5 exec $I3_SCRIPT/i3_bluetooth_operator.sh disable_bluetooth_discoverability; mode "default"
    bindsym 6 exec $I3_SCRIPT/i3_bluetooth_operator.sh enable_bluetooth; mode "default"
    bindsym 7 exec $I3_SCRIPT/i3_bluetooth_operator.sh disable_bluetooth; mode "default"
    # Bluetooth GUI
    bindsym 0 exec blueman-manager; mode "default"
    # Back to system mode: "Enter"
    bindsym Return mode "$mode_system"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Terminal mode (within system mode)
# $mode_terminal: label defined in sway_mode_name.config
mode "$mode_terminal" {
    # Open terminal
    bindsym 1 exec gnome-terminal;mode "default"
    bindsym 2 exec kitty;mode "default"
    bindsym 3 exec alacritty;mode "default"
    bindsym 4 exec urxvt; mode "default"
    bindsym 5 exec xterm;mode "default"
    bindsym 6 exec foot; mode "default"
    bindsym 0 exec i3-sensible-terminal ;mode "default"
    # Set default terminal
    bindsym s exec $SWAY_SCRIPT/sway_terminal_operator.sh set_default_terminal; mode "default"
    # Back to system mode: "Enter"
    bindsym Return mode "$mode_system"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Toolkit mode (for desktop environment)
# $mode_toolkit: label defined in sway_mode_name.config
bindsym Mod1+Ctrl+t mode "$mode_toolkit"
mode "$mode_toolkit" {
    # Capture mode
    bindsym c mode "$mode_capture"
    # Screenshot mode
    bindsym s mode "$mode_screenshot"
    # Recording mode
    bindsym r mode "$mode_recording"
    # Keyboard mode
    bindsym k mode "$mode_keyboard"
    # Open LocalSend in a floating terminal for receiving and device discovery
    bindsym l exec $SWAY_SCRIPT/sway_run.sh $terminal --class floating_terminal -- localsend-cli; mode "default"
    # Caffeine mode
    bindsym Shift+c mode "$mode_caffeine"
    # Kdeconnect mode
    bindsym Shift+k mode "$mode_kdeconnect"
    # Reload mode (reload daemon)
    bindsym Shift+r mode "$mode_tool_reload"
    # Misc tool mode
    bindsym t mode "$mode_misc_tool"
    # Exit mode: "Enter", "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Return           mode "default"
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Capture mode (within toolkit mode)
# $mode_capture: label defined in sway_mode_name.config
mode "$mode_capture" {
    # Pickup color (requires xcolor or gpick, and xclip or xsel)
    bindsym --release 1 exec $SWAY_SCRIPT/sway_toolkit_operator.sh pickup_color; mode "default"
    # Extract context from screenshot and copy to clipboard (requires flameshot, tesseract, and xclip)
    bindsym 2 exec $SWAY_SCRIPT/sway_toolkit_operator.sh get_screenshot_text; mode "default"
    # Extract context from screenshot and copy to clipboard (requires flameshot, tesseract, and xclip)
    bindsym 3 exec $SWAY_SCRIPT/sway_toolkit_operator.sh get_screenshot_qr; mode "default"
    # Screenshot mode
    bindsym s mode "$mode_screenshot"
    # Recording mode (screen recording tool collection)
    bindsym r mode "$mode_recording"
    # Back to tookit mode: "Enter"
    bindsym Return mode "$mode_toolkit"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Screenshot mode (within toolkit mode)
# $mode_screenshot: label defined in sway_mode_name.config
mode "$mode_screenshot" {
    # Show titlebar/border (NOTE: --release waits for the bar to return to hidden_state)
    bindsym --release 0 exec $SWAY_SCRIPT/sway_screenshot_operator.sh GUI keep; mode "default"
    bindsym --release 1 exec $SWAY_SCRIPT/sway_screenshot_operator.sh select_window keep; mode "default"
    bindsym --release 2 exec $SWAY_SCRIPT/sway_screenshot_operator.sh active_window keep; mode "default"
    bindsym --release 3 exec $SWAY_SCRIPT/sway_screenshot_operator.sh current_screen keep; mode "default"
    bindsym --release 4 exec $SWAY_SCRIPT/sway_screenshot_operator.sh full keep; mode "default"
    # Hide titlebar/border
    bindsym --release Shift+0 exec $SWAY_SCRIPT/sway_screenshot_operator.sh GUI hide; mode "default"
    bindsym --release Shift+1 exec $SWAY_SCRIPT/sway_screenshot_operator.sh select_window hide; mode "default"
    bindsym --release Shift+2 exec $SWAY_SCRIPT/sway_screenshot_operator.sh active_window hide; mode "default"
    bindsym --release Shift+3 exec $SWAY_SCRIPT/sway_screenshot_operator.sh current_screen hide; mode "default"
    bindsym --release Shift+4 exec $SWAY_SCRIPT/sway_screenshot_operator.sh full hide; mode "default"
    # Back to tookit mode: "Enter"
    bindsym Return mode "$mode_toolkit"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Recording mode (within toolkit mode)
# $mode_recording: label defined in sway_mode_name.config
mode "$mode_recording" {
    # [SWAY] peek (X11 only, unmaintained) -> wf-recorder; screenkey (X11) -> showmethekey
    bindsym 1 exec $SWAY_SCRIPT/sway_recorder.sh toggle region; mode "default"
    bindsym 2 exec $SWAY_SCRIPT/sway_recorder.sh toggle output; mode "default"
    bindsym 3 exec showmethekey-gtk; mode "default"
    # Back to toolkit mode: "Enter"
    bindsym Return mode "$mode_toolkit"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Misc tool mode (within toolkit mode)
# $mode_misc_tool: label defined in sway_mode_name.config
mode "$mode_misc_tool" {
    # Translate selected item (w/ xclip and w/ trans), note that Network connection is required
    bindsym 1 exec $SWAY_SCRIPT/sway_toolkit_operator.sh translate_clip; mode "default"
    # Collect all instance of window
    bindsym 2 exec $SWAY_SCRIPT/sway_toolkit_operator.sh collect_all_instances; mode "default"
    # Test audio input/output
    bindsym 3 exec $SWAY_SCRIPT/sway_toolkit_operator.sh test_audio_IO; mode "default"
    # Click window to kill
    bindsym --release 4 exec $SWAY_SCRIPT/sway_toolkit_operator.sh kill_window; mode "default"
    # Show brave-browsers
    bindsym 5 exec $SWAY_SCRIPT/sway_toolkit_operator.sh show_brave_browser; mode "default"
    # Xzoom is X11-only -> woomer (Wayland zoomer) if installed
    bindsym 6 exec "command -v woomer >/dev/null && woomer || notify-send -u normal 'Magnifier' 'xzoom is X11-only. Install woomer (Wayland zoomer).'"; mode "default"
    # Back to toolkit mode: "Enter"
    bindsym Return mode "$mode_toolkit"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Caffeine mode (within toolkit mode)
# $mode_caffeine: label defined in sway_mode_name.config
mode "$mode_caffeine" {
    # Caffeine (disable/enable X window screen saver)
    bindsym 1 exec $SWAY_SCRIPT/sway_toolkit_operator.sh enable_caffeine; mode "default"
    bindsym 2 exec $SWAY_SCRIPT/sway_toolkit_operator.sh disable_caffeine; mode "default"
    bindsym s mode "$mode_set_default_caffeine"
    # Back to toolkit mode: "Enter"
    bindsym Return mode "$mode_toolkit"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Set default caffeine (within caffeine mode)
# $mode_set_default_caffeine: label defined in sway_mode_name.config
mode "$mode_set_default_caffeine" {
    bindsym 1 exec $SWAY_SCRIPT/sway_default_valuechanger.sh caffeine_startup enable; mode "default"
    bindsym 2 exec $SWAY_SCRIPT/sway_default_valuechanger.sh caffeine_startup disable; mode "default"
    # Back to caffeine mode: "Enter"
    bindsym Return mode "$mode_caffeine"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Keyboard mode (within toolkit mode)
# $mode_keyboard: label defined in sway_mode_name.config
mode "$mode_keyboard" {
    # Send Capslock key
    bindsym Ctrl+Mod1+l exec $SWAY_SCRIPT/sway_keyboard_operator.sh send_capslock_key
    bindsym Ctrl+Mod1+n exec $SWAY_SCRIPT/sway_keyboard_operator.sh send_numlock_key
    # Repeat key
    bindsym 1 exec $SWAY_SCRIPT/sway_keyboard_operator.sh speed_up_repeat_key_rate; mode "default"
    bindsym 2 exec $SWAY_SCRIPT/sway_keyboard_operator.sh restore_repeat_key_rate; mode "default"
    # Default: Speedup repeat key, map capslock key to ctrl, customize TEX shinobi keyboard, and etc.
    bindsym 0 exec $SWAY_SCRIPT/sway_keyboard_operator.sh default; mode "default"
    # Restore keyboard layout
    bindsym r exec $SWAY_SCRIPT/sway_keyboard_operator.sh restore_keyboard_layout; mode "default"
    # non-HHKB mode
    bindsym n mode "$mode_non_HHKB"
    # HHKB mode
    bindsym h mode "$mode_HHKB"
    # TEX mode
    bindsym t mode "$mode_TEX"
    # Back to toolkit mode: "Enter"
    bindsym Return mode "$mode_toolkit"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Tool reload mode (within toolkit mode)
# $mode_tool_reload: label defined in sway_mode_name.config
mode "$mode_tool_reload" {
    # Reload clipboard manager (parcellite is X11-only -> cliphist watcher on sway)
    bindsym 1 exec $SWAY_SCRIPT/sway_toolkit_operator.sh reload_parcellite; mode "default"
    # Reload ibus-daemon (input method manager)
    bindsym 2 exec $SWAY_SCRIPT/sway_toolkit_operator.sh reload_ibus_daemon; mode "default"
    # Reload libinput-gestures
    bindsym 3 exec $SWAY_SCRIPT/sway_toolkit_operator.sh reload_gestures; mode "default"
    # Back to toolkit mode: "Enter"
    bindsym Return mode "$mode_toolkit"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# non-HHKB mode (within keyboard mode)
# $mode_non_HHKB: label defined in sway_mode_name.config
mode "$mode_non_HHKB" {
    # Capslock key
    bindsym 0 exec $SWAY_SCRIPT/sway_keyboard_operator.sh restore_capslock; mode "default"
    bindsym 1 exec $SWAY_SCRIPT/sway_keyboard_operator.sh map_capslock_to_ctrl; mode "default"
    bindsym 2 exec $SWAY_SCRIPT/sway_keyboard_operator.sh swap_capslock_with_ctrl; mode "default"
    # Backspace key and Backslash key
    bindsym 3 exec $SWAY_SCRIPT/sway_keyboard_operator.sh swap_backslash_with_backspace; mode "default"
    bindsym 4 exec $SWAY_SCRIPT/sway_keyboard_operator.sh restore_backslash_and_backspace; mode "default"
    # Back to toolkit mode: "Enter"
    bindsym Return mode "$mode_keyboard"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# HHKB mode (within keyboard mode)
# $mode_HHKB: label defined in sway_mode_name.config
mode "$mode_HHKB" {
    bindsym 1 exec $SWAY_SCRIPT/sway_keyboard_operator.sh swap_escape_with_grave; mode "default"
    bindsym 2 exec $SWAY_SCRIPT/sway_keyboard_operator.sh restore_escape_and_grave; mode "default"
    bindsym 3 exec $SWAY_SCRIPT/sway_keyboard_operator.sh map_shift_escape_to_tilde; mode "default"
    # Swap Escape-related keybindings to grave-related keybindings for HHKB layout
    bindsym 0 exec $SWAY_SCRIPT/sway_keyboard_operator.sh swap_escape_keybinding_with_grave_keybinding; mode "default"
    # Back to toolkit mode: "Enter"
    bindsym Return mode "$mode_keyboard"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# TEX mode (within keyboard mode)
# $mode_TEX: label defined in sway_mode_name.config
mode "$mode_TEX" {
    # TEX Shinobi keyboard trackpoint
    bindsym 1 exec $SWAY_SCRIPT/sway_keyboard_operator.sh customize_tex_shinobi; mode "default"
    bindsym 2 exec $SWAY_SCRIPT/sway_keyboard_operator.sh restore_tex_shinobi; mode "default"
    bindsym 3 exec $SWAY_SCRIPT/sway_keyboard_operator.sh enable_tex_shinobi_trackpoint; mode "default"
    bindsym 4 exec $SWAY_SCRIPT/sway_keyboard_operator.sh disable_tex_shinobi_trackpoint; mode "default"
    # Back to toolkit mode: "Enter"
    bindsym Return mode "$mode_keyboard"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# KDE Connect mode (within toolkit mode)
# $mode_kdeconnect: label defined in sway_mode_name.config
mode "$mode_kdeconnect" {
    # KDE Connect pointer daemon
    bindsym 1 exec $SWAY_SCRIPT/sway_kdeconnect_operator.sh enable_pointer; mode "default"
    bindsym 2 exec $SWAY_SCRIPT/sway_kdeconnect_operator.sh disable_pointer; mode "default"
    bindsym 3 exec $SWAY_SCRIPT/sway_kdeconnect_operator.sh pointer_invert_on; mode "default"
    bindsym 4 exec $SWAY_SCRIPT/sway_kdeconnect_operator.sh pointer_invert_off; mode "default"
    bindsym 5 exec $SWAY_SCRIPT/sway_kdeconnect_operator.sh reload_kdeconnect; mode "default"
    # Back to toolkit mode: "Enter"
    bindsym Return mode "$mode_toolkit"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Display mode (xrandr -> swaymsg output; arandr -> wdisplays)
# $mode_display: label defined in sway_mode_name.config
bindsym Mod4+Shift+x mode "$mode_display"
mode "$mode_display" {
    # wdisplays (arandr-like GUI for wlroots output management)
    bindsym a exec wdisplays; mode "default"
    # Preset display
    bindsym p mode "$mode_display_preset"
    # Interactive select display to operate
    bindsym 1 exec $SWAY_SCRIPT/sway_display_operator.sh select_display_position
    bindsym 2 exec $SWAY_SCRIPT/sway_display_operator.sh select_display_mode
    bindsym 3 exec $SWAY_SCRIPT/sway_display_operator.sh select_display_as_primary
    bindsym 4 exec $SWAY_SCRIPT/sway_display_operator.sh select_display_orientation
    bindsym 5 exec $SWAY_SCRIPT/sway_display_operator.sh select_display_scale
    bindsym 6 exec $SWAY_SCRIPT/sway_display_operator.sh select_input_to_output
    # Show display layout
    bindsym x exec $SWAY_SCRIPT/sway_display_operator.sh show_display_layout
    bindsym d exec $SWAY_SCRIPT/sway_display_operator.sh show_display_layout
    # Dunst compatibility: notification actions
    bindsym Ctrl+space            exec dunstctl close
    bindsym Ctrl+Shift+space      exec dunstctl history-pop
    bindsym Mod1+space            exec dunstctl close
    bindsym Mod1+Shift+space      exec dunstctl history-pop
    bindsym Ctrl+Mod1+Shift+space exec dunstctl action
    # Exit mode: "Enter", "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Return           mode "default"
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Display preset mode (within display mode)
# -- https://thevaluable.dev/i3-config-mouseless/
# -- For my monitor physical setup: laptop [eDP1 13'] + external {[HDMI1 27'], [HDMI1 24']}
# $mode_display_preset: label defined in sway_mode_name.config
mode "$mode_display_preset" {
    # Monitor mode
    bindsym e mode "$mode_eDP1"
    bindsym h mode "$mode_HDMI1"
    # Preset
    bindsym 0 exec $SWAY_SCRIPT/sway_display_operator.sh auto $default_conky_startup; mode "default"
    bindsym 1 exec $SWAY_SCRIPT/sway_display_operator.sh auto_in_office $default_conky_startup; mode "default"
    bindsym 2 exec $SWAY_SCRIPT/sway_display_operator.sh auto_at_home $default_conky_startup; mode "default"
    # Joint, Mirror
    bindsym 3 exec $SWAY_SCRIPT/sway_display_operator.sh HDMI1_eDP1_joint $default_conky_startup; mode "default"
    bindsym 4 exec $SWAY_SCRIPT/sway_display_operator.sh eDP1_HDMI1_joint $default_conky_startup; mode "default"
    bindsym 5 exec $SWAY_SCRIPT/sway_display_operator.sh eDP1_HDMI1_mirror $default_conky_startup; mode "default"
    # Back to display mode: "Enter"
    bindsym Return mode "$mode_display"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# eDP1 mode (within display mode)
# $mode_eDP1: label defined in sway_mode_name.config
mode "$mode_eDP1" {
    # Resolution
    bindsym 1 exec $SWAY_SCRIPT/sway_display_operator.sh eDP1_1440x810_60 $default_conky_startup; mode "default"
    bindsym 2 exec $SWAY_SCRIPT/sway_display_operator.sh eDP1_1368x768_60 $default_conky_startup; mode "default"
    bindsym 0 exec $SWAY_SCRIPT/sway_display_operator.sh eDP1_default $default_conky_startup; mode "default"
    # Misc
    bindsym a exec $SWAY_SCRIPT/sway_display_operator.sh eDP1_auto disable; mode "default"
    bindsym o exec $SWAY_SCRIPT/sway_display_operator.sh eDP1_off disable; mode "default"
    bindsym p exec $SWAY_SCRIPT/sway_display_operator.sh eDP1_primary disable; mode "default"
    # Back to display mode: "Enter"
    bindsym Return mode "$mode_display_preset"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# HDMI1 mode (within display mode)
# $mode_HDMI1: label defined in sway_mode_name.config
mode "$mode_HDMI1" {
    # Resolution
    bindsym 1 exec $SWAY_SCRIPT/sway_display_operator.sh HDMI1_1912x960_60 $default_conky_startup; mode "default"
    bindsym 2 exec $SWAY_SCRIPT/sway_display_operator.sh HDMI1_1920x1200_50 $default_conky_startup; mode "default"
    bindsym 0 exec $SWAY_SCRIPT/sway_display_operator.sh HDMI1_default $default_conky_startup; mode "default"
    # Misc
    bindsym a exec $SWAY_SCRIPT/sway_display_operator.sh HDMI1_auto disable; mode "default"
    bindsym o exec $SWAY_SCRIPT/sway_display_operator.sh HDMI1_off disable; mode "default"
    bindsym p exec $SWAY_SCRIPT/sway_display_operator.sh HDMI1_primary disable; mode "default"
    # Back to display mode: "Enter"
    bindsym Return mode "$mode_display_preset"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Backlight mode
# NOTE: brightnessctl replaces xbacklight on sway (user must be in the 'video' group)
# $mode_backlight: label defined in sway_mode_name.config
bindsym Ctrl+Mod1+x mode "$mode_backlight"
mode "$mode_backlight" {
    # Redshift mode
    bindsym r mode "$mode_redshift"
    bindsym z mode "$mode_redshift"
    # Software brightness input (xrandr --brightness replacement, see sway_backlight_operator.sh)
    bindsym i       exec $SWAY_SCRIPT/sway_backlight_operator.sh set_focused_display_backlight_with_rofi
    bindsym Shift+i exec $SWAY_SCRIPT/sway_backlight_operator.sh set_all_connected_displays_backlight_with_rofi
    # brightnessctl
    bindsym x       exec $SWAY_SCRIPT/sway_backlight_operator.sh show_xbacklight
    bindsym Shift+x exec $SWAY_SCRIPT/sway_backlight_operator.sh set_xbacklight_with_rofi
    # Backlight (small/intermediate/large step)
    bindsym Ctrl+minus exec $SWAY_SCRIPT/sway_backlight_operator.sh dec_xbacklight 1
    bindsym Ctrl+equal  exec $SWAY_SCRIPT/sway_backlight_operator.sh inc_xbacklight 1
    bindsym minus      exec $SWAY_SCRIPT/sway_backlight_operator.sh dec_xbacklight 5
    bindsym equal       exec $SWAY_SCRIPT/sway_backlight_operator.sh inc_xbacklight 5
    bindsym Mod1+minus exec $SWAY_SCRIPT/sway_backlight_operator.sh dec_xbacklight 10
    bindsym Mod1+equal  exec $SWAY_SCRIPT/sway_backlight_operator.sh inc_xbacklight 10
    # Backlight (Min/Intermediate/Max)
    bindsym Ctrl+Shift+0      exec $SWAY_SCRIPT/sway_backlight_operator.sh set_xbacklight 0.1
    bindsym Ctrl+Mod1+Shift+0 exec $SWAY_SCRIPT/sway_backlight_operator.sh set_xbacklight 50.1
    bindsym Mod1+Shift+0      exec $SWAY_SCRIPT/sway_backlight_operator.sh set_xbacklight 100.0
    # Special key compatibility: backlight control
    bindsym Ctrl+XF86MonBrightnessDown exec $SWAY_SCRIPT/sway_backlight_operator.sh dec_xbacklight 1
    bindsym Ctrl+XF86MonBrightnessUp   exec $SWAY_SCRIPT/sway_backlight_operator.sh inc_xbacklight 1
    bindsym XF86MonBrightnessDown      exec $SWAY_SCRIPT/sway_backlight_operator.sh dec_xbacklight 5
    bindsym XF86MonBrightnessUp        exec $SWAY_SCRIPT/sway_backlight_operator.sh inc_xbacklight 5
    bindsym Mod1+XF86MonBrightnessDown exec $SWAY_SCRIPT/sway_backlight_operator.sh dec_xbacklight 10
    bindsym Mod1+XF86MonBrightnessUp   exec $SWAY_SCRIPT/sway_backlight_operator.sh inc_xbacklight 10
    # Dunst compatibility: notification actions
    bindsym Ctrl+space            exec dunstctl close
    bindsym Ctrl+Shift+space      exec dunstctl history-pop
    bindsym Mod1+space            exec dunstctl close
    bindsym Mod1+Shift+space      exec dunstctl history-pop
    bindsym Ctrl+Mod1+Shift+space exec dunstctl action
    # Compatibility: Move focus between output monitors (,/[/]/.)
    bindsym Mod4+comma        focus output left
    bindsym Mod4+bracketleft  focus output down
    bindsym Mod4+bracketright focus output up
    bindsym Mod4+period       focus output right
    # Exit mode: "Enter", "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Return           mode "default"
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Redshift mode (bluelight filter within backlight mode)
# [SWAY] redshift -m randr is X11-only -> gammastep (wlr-gamma-control). On Wayland the gamma
#        ramp is reset when the client exits, so sway_nightlight.sh keeps one gammastep
#        process running per temperature instead of redshift's one-shot -P -O.
# $mode_redshift: label defined in sway_mode_name.config
mode "$mode_redshift" {
    bindsym 1 exec $SWAY_SCRIPT/sway_nightlight.sh set 2000
    bindsym 2 exec $SWAY_SCRIPT/sway_nightlight.sh set 2500
    bindsym 3 exec $SWAY_SCRIPT/sway_nightlight.sh set 3000
    bindsym 4 exec $SWAY_SCRIPT/sway_nightlight.sh set 3500
    bindsym 5 exec $SWAY_SCRIPT/sway_nightlight.sh set 4000
    bindsym 6 exec $SWAY_SCRIPT/sway_nightlight.sh set 4500
    bindsym 7 exec $SWAY_SCRIPT/sway_nightlight.sh set 5000
    bindsym 8 exec $SWAY_SCRIPT/sway_nightlight.sh set 5500
    bindsym 9 exec $SWAY_SCRIPT/sway_nightlight.sh set 6000
    # Input
    bindsym i exec $SWAY_SCRIPT/sway_nightlight.sh set "$(rofi -dmenu -p 'Set color_temperature to')"
    # Disable redshift
    bindsym 0 exec $SWAY_SCRIPT/sway_nightlight.sh off; mode "default"
    # Go to backlight mode: "Enter"
    bindsym Return mode "$mode_backlight"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Dunst mode (notification daemon)
# NOTE: dunst must be installed
# $mode_dunst: label defined in sway_mode_name.config
bindsym Ctrl+Mod1+n mode "$mode_dunst"
mode "$mode_dunst" {
    # Dunst logger mode
    bindsym l mode "$mode_dunst_logger"
    # Dunst operation
    bindsym s       exec notify-send "Dunst" "Dunst is running"
    bindsym a       exec dunstctl action
    bindsym c       exec dunstctl close
    bindsym o       exec dunstctl context
    bindsym h       exec dunstctl history-pop
    bindsym Shift+c exec dunstctl close-all
    bindsym p       exec dunstctl set-paused true; mode "default"
    bindsym r       exec dunstctl set-paused false; mode "default"
    bindsym Shift+r exec $SWAY_SCRIPT/sway_dunst_operator.sh reload
    # Dunst compatibility: notification actions
    bindsym Ctrl+space            exec dunstctl close
    bindsym Ctrl+Shift+space      exec dunstctl history-pop
    bindsym Mod1+space            exec dunstctl close
    bindsym Mod1+Shift+space      exec dunstctl history-pop
    bindsym Ctrl+Mod1+Shift+space exec dunstctl action
    # Exit mode: "Enter", "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Return           mode "default"
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Dunst logger mode (within dunst mode)
# $mode_dunst_logger: label defined in sway_mode_name.config
mode "$mode_dunst_logger" {
    bindsym s exec $SWAY_SCRIPT/sway_dunst_operator.sh show_dunst_logger_status
    bindsym h exec $SWAY_SCRIPT/sway_dunst_operator.sh show_dunst_logger_history
    bindsym e exec $SWAY_SCRIPT/sway_dunst_operator.sh enable_dunst_logger; mode "default"
    bindsym d exec $SWAY_SCRIPT/sway_dunst_operator.sh disable_dunst_logger; mode "default"
    # Go back to dunst mode: "Enter"
    bindsym Return mode "$mode_dunst"
    # "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# --------------------------------------------------------------------------------------
# 3. Multimedia-related Modes
# --------------------------------------------------------------------------------------

# Player mode with youtube-like player control (j/k/l: previous/play-pause/next)
# NOTE: spotifyd, spt, mpv must be installed. Also need mpv-mpris to control mpv with playerctl
bindsym Ctrl+Mod1+p mode "$mode_player"
# $mode_player: label defined in sway_mode_name.config
mode "$mode_player" {
    # Audio input mode (with pulsemixer)
    bindsym i mode "$mode_audio_input"
    # Audio output mode (with pulsemixer)
    bindsym o mode "$mode_audio_output"
    # Spotifyd mode
    bindsym s mode "$mode_spotifyd"
    # Mpv mode (provides function like selecting playlist interactively )
    bindsym Shift+m mode "$mode_mpv"
    # Cava (output visualizer)
    bindsym c exec $SWAY_SCRIPT/sway_run.sh $terminal --class floating_terminal -- cava
    # Show playing information
    bindsym p       exec $I3_SCRIPT/i3_MPRIS_notification.sh playing
    bindsym Shift+p exec $I3_SCRIPT/i3_MPRIS_notification.sh playing_all
    bindsym Mod1+p  exec $I3_SCRIPT/i3_MPRIS_notification.sh read_playing
    # Spt (spotify TUI front-end)
    bindsym Ctrl+j       exec spt playback --seek -10
    bindsym Ctrl+k       exec spt playback --toggle
    bindsym Ctrl+l       exec spt playback --seek +10
    bindsym Ctrl+Shift+j exec playerctl -p $(spt playback -f %d) previous
    bindsym Ctrl+Shift+k exec playerctl -p $(spt playback -f %d) stop
    bindsym Ctrl+Shift+l exec playerctl -p $(spt playback -f %d) next
    # Media player control
    bindsym j       exec playerctl position 10-
    bindsym k       exec playerctl play-pause && $I3_SCRIPT/i3_MPRIS_notification.sh playing
    bindsym l       exec playerctl position 10+
    bindsym Shift+j exec playerctl previous && sleep 1.5 && $I3_SCRIPT/i3_MPRIS_notification.sh playing
    bindsym Shift+k exec playerctl stop
    bindsym Shift+l exec playerctl next && sleep 1.5 && $I3_SCRIPT/i3_MPRIS_notification.sh playing
    # MPV/VLC (multimedia player), where mpv has higher priority
    bindsym Mod1+j       exec playerctl -p "$(playerctl -l | grep -q mpv && echo mpv || echo vlc)" position 10-
    bindsym Mod1+k       exec playerctl -p "$(playerctl -l | grep -q mpv && echo mpv || echo vlc)" play-pause
    bindsym Mod1+l       exec playerctl -p "$(playerctl -l | grep -q mpv && echo mpv || echo vlc)" position 10+
    bindsym Mod1+Shift+j exec playerctl -p "$(playerctl -l | grep -q mpv && echo mpv || echo vlc)" previous
    bindsym Mod1+Shift+k exec playerctl -p "$(playerctl -l | grep -q mpv && echo mpv || echo vlc)" stop
    bindsym Mod1+Shift+l exec playerctl -p "$(playerctl -l | grep -q mpv && echo mpv || echo vlc)" next
    # Interactive media player control
    bindsym Ctrl+Mod1+j       exec $I3_SCRIPT/i3_MPRIS_operator.sh rewind
    bindsym Ctrl+Mod1+k       exec $I3_SCRIPT/i3_MPRIS_operator.sh play-pause
    bindsym Ctrl+Mod1+l       exec $I3_SCRIPT/i3_MPRIS_operator.sh fast-forward
    bindsym Ctrl+Mod1+Shift+j exec $I3_SCRIPT/i3_MPRIS_operator.sh prev
    bindsym Ctrl+Mod1+Shift+k exec $I3_SCRIPT/i3_MPRIS_operator.sh stop
    bindsym Ctrl+Mod1+Shift+l exec $I3_SCRIPT/i3_MPRIS_operator.sh next
    # Stop all media players
    bindsym Ctrl+Mod1+Shift+space exec playerctl stop --all-players
    # Specital key compatibility: media player control
    bindsym XF86AudioPlay        exec playerctl play-pause && $I3_SCRIPT/i3_MPRIS_notification.sh
    bindsym XF86AudioPause       exec playerctl play-pause && $I3_SCRIPT/i3_MPRIS_notification.sh
    bindsym Shift+XF86AudioPause exec playerctl stop
    bindsym XF86AudioStop        exec playerctl stop
    bindsym XF86AudioNext        exec playerctl next && sleep 1.5 && $I3_SCRIPT/i3_MPRIS_notification.sh
    bindsym XF86AudioPrev        exec playerctl previous && sleep 1.5 && $I3_SCRIPT/i3_MPRIS_notification.sh
    # Specital key compatibility: media player control for spotify (requires spt)
    bindsym Ctrl+XF86AudioPlay  exec playerctl -p $(spt playback -f %d) play-pause
    bindsym Ctrl+XF86AudioPause exec playerctl -p $(spt playback -f %d) play-pause
    bindsym Ctrl+XF86AudioStop  exec playerctl -p $(spt playback -f %d) stop
    bindsym Ctrl+XF86AudioNext  exec playerctl -p $(spt playback -f %d) next
    bindsym Ctrl+XF86AudioPrev  exec playerctl -p $(spt playback -f %d) previous
    # Specital key compatibility: media player control for MPV/VLC (requires mpv/vlc)
    bindsym Mod1+XF86AudioPlay  exec playerctl -p "$(playerctl -l | grep -q mpv && echo mpv || echo vlc)" play-pause
    bindsym Mod1+XF86AudioPause exec playerctl -p "$(playerctl -l | grep -q mpv && echo mpv || echo vlc)" play-pause
    bindsym Mod1+XF86AudioStop  exec playerctl -p "$(playerctl -l | grep -q mpv && echo mpv || echo vlc)" stop
    bindsym Mod1+XF86AudioNext  exec playerctl -p "$(playerctl -l | grep -q mpv && echo mpv || echo vlc)" next
    bindsym Mod1+XF86AudioPrev  exec playerctl -p "$(playerctl -l | grep -q mpv && echo mpv || echo vlc)" previous
    # Specital key compatibility: media player control for all players
    bindsym Ctrl+Mod1+XF86AudioPlay       exec playerctl -a play-pause
    bindsym Ctrl+Mod1+Shift+XF86AudioPlay exec playerctl -a stop
    bindsym Ctrl+Mod1+XF86AudioStop       exec playerctl -a stop
    # Special key compatibility: volume adjustment
    bindsym XF86AudioMicMute          exec pactl set-source-mute @DEFAULT_SOURCE@ toggle && $I3_SCRIPT/i3_pulseaudio_notification.sh source
    bindsym XF86AudioMute             exec pactl set-sink-mute @DEFAULT_SINK@ toggle && $I3_SCRIPT/i3_pulseaudio_notification.sh
    bindsym Ctrl+XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +1% && $I3_SCRIPT/i3_pulseaudio_notification.sh
    bindsym Ctrl+XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -1% && $I3_SCRIPT/i3_pulseaudio_notification.sh
    bindsym XF86AudioRaiseVolume      exec pactl set-sink-volume @DEFAULT_SINK@ +5% && $I3_SCRIPT/i3_pulseaudio_notification.sh
    bindsym XF86AudioLowerVolume      exec pactl set-sink-volume @DEFAULT_SINK@ -5% && $I3_SCRIPT/i3_pulseaudio_notification.sh
    bindsym Mod1+XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +10% && $I3_SCRIPT/i3_pulseaudio_notification.sh
    bindsym Mod1+XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -10% && $I3_SCRIPT/i3_pulseaudio_notification.sh
    # i3 keybindings compatibility: kill focused window
    bindsym Mod4+Shift+q kill
    # Dunst compatibility: notification actions
    bindsym Ctrl+space            exec dunstctl close
    bindsym Ctrl+Shift+space      exec dunstctl history-pop
    bindsym Mod1+space            exec dunstctl close
    bindsym Mod1+Shift+space      exec dunstctl history-pop
    #bindsym Ctrl+Mod1+Shift+space exec dunstctl action
    # Exit mode: "Enter", "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Return           mode "default"
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Spotifyd mode (within player mode)
# NOTE: spotifyd must be installed
# $mode_spotifyd: label defined in sway_mode_name.config
mode "$mode_spotifyd" {
    bindsym p       exec $I3_SCRIPT/i3_spotifyd_operator.sh playing
    bindsym s       exec $I3_SCRIPT/i3_spotifyd_operator.sh status
    bindsym e       exec $I3_SCRIPT/i3_spotifyd_operator.sh enable
    bindsym d       exec $I3_SCRIPT/i3_spotifyd_operator.sh disable
    bindsym a       exec $I3_SCRIPT/i3_spotifyd_operator.sh attach
    bindsym r       exec $I3_SCRIPT/i3_spotifyd_operator.sh reload
    bindsym Shift+r exec $I3_SCRIPT/i3_spotifyd_operator.sh reload_and_attach
    # Track repeat with spt
    bindsym 1 exec $I3_SCRIPT/i3_spotifyd_operator.sh enable_track_repeat
    bindsym 2 exec $I3_SCRIPT/i3_spotifyd_operator.sh disable_track_repeat
    # Go to player mode: "Enter"
    bindsym Return mode "$mode_player"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Mpv mode (within player mode)
# NOTE: mpv must be installed
# $mode_mpv: label defined in sway_mode_name.config
mode "$mode_mpv" {
    bindsym p exec find ~/.config/mpv/playlists -type f | rofi -dmenu | xargs -I {} mpv --playlist="{}"; mode "default"
    # Go to player mode: "Enter"
    bindsym Return mode "$mode_player"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Audio output mode (within player mode; for speaker, earphones and etc.)
# NOTE: pulsemixer, alsa-utils must be installed
# $mode_audio_output: label defined in sway_mode_name.config
mode "$mode_audio_output" {
    # Set volume
    bindsym s exec pulsemixer --set-volume $(rofi -dmenu -p "Set output volume to") && $I3_SCRIPT/i3_pulseaudio_notification.sh
    # Show volume
    bindsym v exec $I3_SCRIPT/i3_pulseaudio_notification.sh
    # Pulsemixer (CLI and curses mixer for PulseAudio)
    bindsym p exec kitty --class floating_terminal -e pulsemixer; mode "default"
    # Alsamixer (soundcard mixer for ALSA soundcard driver)
    bindsym a exec kitty --class floating_terminal -e alsamixer; mode "default"
    # Stereo channel check (default: 2 channels)
    bindsym c exec kitty --class floating_terminal -e speaker-test -t wav -c 2
    # Toggle mute
    bindsym m exec pulsemixer --toggle-mute && $I3_SCRIPT/i3_pulseaudio_notification.sh
    # Volume (small/intermediate/large step)
    bindsym Ctrl+minus exec pulsemixer --change-volume -1 && $I3_SCRIPT/i3_pulseaudio_notification.sh
    bindsym Ctrl+equal  exec pulsemixer --change-volume +1 && $I3_SCRIPT/i3_pulseaudio_notification.sh
    bindsym minus      exec pulsemixer --change-volume -5 && $I3_SCRIPT/i3_pulseaudio_notification.sh
    bindsym equal       exec pulsemixer --change-volume +5 && $I3_SCRIPT/i3_pulseaudio_notification.sh
    bindsym Mod1+minus exec pulsemixer --change-volume -10 && $I3_SCRIPT/i3_pulseaudio_notification.sh
    bindsym Mod1+equal  exec pulsemixer --change-volume +10 && $I3_SCRIPT/i3_pulseaudio_notification.sh
    # Special key compatibility: volume adjustment
    bindsym XF86AudioMicMute          exec pactl set-source-mute @DEFAULT_SOURCE@ toggle && $I3_SCRIPT/i3_pulseaudio_notification.sh source
    bindsym XF86AudioMute             exec pactl set-sink-mute @DEFAULT_SINK@ toggle && $I3_SCRIPT/i3_pulseaudio_notification.sh
    bindsym Ctrl+XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +1% && $I3_SCRIPT/i3_pulseaudio_notification.sh
    bindsym Ctrl+XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -1% && $I3_SCRIPT/i3_pulseaudio_notification.sh
    bindsym XF86AudioRaiseVolume      exec pactl set-sink-volume @DEFAULT_SINK@ +5% && $I3_SCRIPT/i3_pulseaudio_notification.sh
    bindsym XF86AudioLowerVolume      exec pactl set-sink-volume @DEFAULT_SINK@ -5% && $I3_SCRIPT/i3_pulseaudio_notification.sh
    bindsym Mod1+XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +10% && $I3_SCRIPT/i3_pulseaudio_notification.sh
    bindsym Mod1+XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -10% && $I3_SCRIPT/i3_pulseaudio_notification.sh
    # Dunst compatibility: notification actions
    bindsym Ctrl+space            exec dunstctl close
    bindsym Ctrl+Shift+space      exec dunstctl history-pop
    bindsym Mod1+space            exec dunstctl close
    bindsym Mod1+Shift+space      exec dunstctl history-pop
    bindsym Ctrl+Mod1+Shift+space exec dunstctl action
    # Go to audio input mode
    bindsym i mode "$mode_audio_input"
    # Go to player mode: "Enter"
    bindsym Return mode "$mode_player"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Audio input mode (within player mode; for microphone and etc.)
# NOTE: pulsemixer, alsa-utils must be installed
# $mode_audio_input: label defined in sway_mode_name.config
mode "$mode_audio_input" {
    # Set volume
    bindsym s exec pactl set-source-volume @DEFAULT_SOURCE@ $(rofi -dmenu -p "Set input volume to")% && $I3_SCRIPT/i3_pulseaudio_notification.sh source
    # Show volume
    bindsym v exec $I3_SCRIPT/i3_pulseaudio_notification.sh source
    # Pulsemixer (CLI and curses mixer for PulseAudio)
    bindsym p exec kitty --class floating_terminal -e pulsemixer; mode "default"
    # Alsamixer (soundcard mixer for ALSA soundcard driver)
    bindsym a exec kitty --class floating_terminal -e alsamixer; mode "default"
    # Microphone test
    bindsym c exec kitty --class floating_terminal -e arecord -vv -f dat /dev/null
    # Record audio with microphone
    bindsym r exec kitty --class floating_terminal -e arecord -f S16_LE $(date +'%Y-%m-%d-%H-%M-%S').wav
    # Test audio I/O
    bindsym t exec $SWAY_SCRIPT/sway_toolkit_operator.sh test_audio_IO; mode "default"
    # Toggle mute
    bindsym m exec pactl set-source-mute @DEFAULT_SOURCE@ toggle && $I3_SCRIPT/i3_pulseaudio_notification.sh source
    # Volume (small/intermediate/large step)
    bindsym Ctrl+minus exec pactl set-source-volume @DEFAULT_SOURCE@ -1% && $I3_SCRIPT/i3_pulseaudio_notification.sh source
    bindsym Ctrl+equal  exec pactl set-source-volume @DEFAULT_SOURCE@ +1% && $I3_SCRIPT/i3_pulseaudio_notification.sh source
    bindsym minus      exec pactl set-source-volume @DEFAULT_SOURCE@ -5% && $I3_SCRIPT/i3_pulseaudio_notification.sh source
    bindsym equal       exec pactl set-source-volume @DEFAULT_SOURCE@ +5% && $I3_SCRIPT/i3_pulseaudio_notification.sh source
    bindsym Mod1+minus exec pactl set-source-volume @DEFAULT_SOURCE@ -10% && $I3_SCRIPT/i3_pulseaudio_notification.sh source
    bindsym Mod1+equal  exec pactl set-source-volume @DEFAULT_SOURCE@ +10% && $I3_SCRIPT/i3_pulseaudio_notification.sh source
    # Special key compatibility: volume adjustment
    bindsym XF86AudioMicMute          exec pactl set-source-mute @DEFAULT_SOURCE@ toggle && $I3_SCRIPT/i3_pulseaudio_notification.sh source
    bindsym XF86AudioMute             exec pactl set-sink-mute @DEFAULT_SINK@ toggle && $I3_SCRIPT/i3_pulseaudio_notification.sh
    bindsym Ctrl+XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +1% && $I3_SCRIPT/i3_pulseaudio_notification.sh
    bindsym Ctrl+XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -1% && $I3_SCRIPT/i3_pulseaudio_notification.sh
    bindsym XF86AudioRaiseVolume      exec pactl set-sink-volume @DEFAULT_SINK@ +5% && $I3_SCRIPT/i3_pulseaudio_notification.sh
    bindsym XF86AudioLowerVolume      exec pactl set-sink-volume @DEFAULT_SINK@ -5% && $I3_SCRIPT/i3_pulseaudio_notification.sh
    bindsym Mod1+XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +10% && $I3_SCRIPT/i3_pulseaudio_notification.sh
    bindsym Mod1+XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -10% && $I3_SCRIPT/i3_pulseaudio_notification.sh
    # Dunst compatibility: notification actions
    bindsym Ctrl+space            exec dunstctl close
    bindsym Ctrl+Shift+space      exec dunstctl history-pop
    bindsym Mod1+space            exec dunstctl close
    bindsym Mod1+Shift+space      exec dunstctl history-pop
    bindsym Ctrl+Mod1+Shift+space exec dunstctl action
    # Go to audio output mode
    bindsym o mode "$mode_audio_output"
    # Go to player mode: "Enter"
    bindsym Return mode "$mode_player"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# --------------------------------------------------------------------------------------
# 4. Window/Workspace-related Modes
# --------------------------------------------------------------------------------------

# Resize window (you can also use the mouse for that)
# $mode_resize: label defined in sway_mode_name.config
bindsym Ctrl+Mod1+r mode "$mode_resize"
mode "$mode_resize" {
    # Window layout mode
    bindsym w mode "$mode_window_layout"
    # Resize window to input height/width
    bindsym i       exec $SWAY_SCRIPT/sway_window_operator.sh resize_to_input_and_move_floating_to_input
    bindsym Shift+i exec $SWAY_SCRIPT/sway_window_operator.sh resize_to_input_and_move_floating_to_input_in_one
    # Resize in small step
    bindsym Ctrl+h resize shrink width 1 px or 1 ppt
    bindsym Ctrl+j resize grow height 1 px or 1 ppt
    bindsym Ctrl+k resize shrink height 1 px or 1 ppt
    bindsym Ctrl+l resize grow width 1 px or 1 ppt
    # Resize in intermediate step
    bindsym h resize shrink width 5 px or 5 ppt
    bindsym j resize grow height 5 px or 5 ppt
    bindsym k resize shrink height 5 px or 5 ppt
    bindsym l resize grow width 5 px or 5 ppt
    # Resize in large step
    bindsym Mod1+h resize shrink width 10 px or 10 ppt
    bindsym Mod1+j resize grow height 10 px or 10 ppt
    bindsym Mod1+k resize shrink height 10 px or 10 ppt
    bindsym Mod1+l resize grow width 10 px or 10 ppt
    # i3 keybindings compatibility: change focus and move cursor to the center of focus window
    bindsym Mod4+h focus left, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window
    bindsym Mod4+j focus down, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window
    bindsym Mod4+k focus up, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window
    bindsym Mod4+l focus right, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window
    # i3 keybindings compatibility: move focused window
    bindsym Mod4+Shift+h move left, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window
    bindsym Mod4+Shift+j move down, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window
    bindsym Mod4+Shift+k move up, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window
    bindsym Mod4+Shift+l move right, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window
    # i3 keybindings compatibility: move focus between output monitors (,/[/]/.)
    bindsym Mod4+comma        focus output left
    bindsym Mod4+bracketleft  focus output down
    bindsym Mod4+bracketright focus output up
    bindsym Mod4+period       focus output right
    # i3 keybindings compatibility: move window and focus between output monitors (</{/}/>)
    bindsym Mod4+Shift+comma        move container to output left; focus output left
    bindsym Mod4+Shift+bracketleft  move container to output down; focus output down
    bindsym Mod4+Shift+bracketright move container to output up; focus output up
    bindsym Mod4+Shift+period       move container to output right; focus output right
    # i3 keybindings compatibility: change focus between tiling/floating windows
    bindsym Mod4+space focus mode_toggle
    # Exit mode: "Enter", "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Return           mode "default"
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Titlebar mode
# $mode_titlebar: label defined in sway_mode_name.config
bindsym Mod4+Shift+t mode "$mode_titlebar"
mode "$mode_titlebar" {
    bindsym n exec swaymsg title_format "$(rofi -dmenu -l 0 -p 'New title name')"
    bindsym r title_format "%title"; exec notify-send -u low "Titlebar Mode" "Restore Default Title Name"
    bindsym s [all] border normal $default_border_width; exec notify-send -u low "Titlebar Mode" "Show All Titlebars"
    bindsym h [all] border pixel $default_border_width; exec notify-send -u low "Titlebar Mode" "Hide All Titlebars"
    bindsym t [all] border toggle $default_border_width; exec notify-send -u low "Titlebar Mode" "Toggle All Titlebars"
    # Fontsize mode, titlebar_style mnode
    bindsym f       mode "$mode_titlebar_fontsize"
    bindsym Shift+t mode "$mode_titlebar_style"
    # Exit mode: "Enter", "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Return           mode "default"
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Titlebar fontsize mode (within titlebar mode)
# $mode_titlebar_fontsize: label defined in sway_mode_name.config
mode "$mode_titlebar_fontsize" {
    bindsym 1 exec $SWAY_SCRIPT/sway_default_valuechanger.sh titlebar_fontsize 8; mode "default"
    bindsym 2 exec $SWAY_SCRIPT/sway_default_valuechanger.sh titlebar_fontsize 9; mode "default"
    bindsym 3 exec $SWAY_SCRIPT/sway_default_valuechanger.sh titlebar_fontsize 10; mode "default"
    bindsym 4 exec $SWAY_SCRIPT/sway_default_valuechanger.sh titlebar_fontsize 11; mode "default"
    bindsym 5 exec $SWAY_SCRIPT/sway_default_valuechanger.sh titlebar_fontsize 12; mode "default"
    bindsym 6 exec $SWAY_SCRIPT/sway_default_valuechanger.sh titlebar_fontsize 13; mode "default"
    bindsym 7 exec $SWAY_SCRIPT/sway_default_valuechanger.sh titlebar_fontsize 14; mode "default"
    bindsym 8 exec $SWAY_SCRIPT/sway_default_valuechanger.sh titlebar_fontsize 15; mode "default"
    bindsym 9 exec $SWAY_SCRIPT/sway_default_valuechanger.sh titlebar_fontsize 16; mode "default"
    bindsym 0 exec $SWAY_SCRIPT/sway_default_valuechanger.sh titlebar_fontsize 0; mode "default"
    bindsym i exec $SWAY_SCRIPT/sway_default_valuechanger.sh titlebar_fontsize input; mode "default"
    # Back to titlebar mode: "Enter"
    bindsym Return mode "$mode_titlebar"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Titlebar style mode (within titlebar mode)
# $mode_titlebar_style: label defined in sway_mode_name.config
mode "$mode_titlebar_style" {
    bindsym 1 exec $SWAY_SCRIPT/sway_default_valuechanger.sh titlebar_style normal; mode "default"
    bindsym 2 exec $SWAY_SCRIPT/sway_default_valuechanger.sh titlebar_style pixel; mode "default"
    bindsym 3 exec $SWAY_SCRIPT/sway_default_valuechanger.sh floating_titlebar_style normal; mode "default"
    bindsym 4 exec $SWAY_SCRIPT/sway_default_valuechanger.sh floating_titlebar_style pixel; mode "default"
    # Back to titlebar mode: "Enter"
    bindsym Return mode "$mode_titlebar"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Mark mode [use rofi as input]
# Automark windows [https://github.com/lincheney/i3-automark] is required
# $mode_mark: label defined in sway_mode_name.config
bindsym Mod4+Shift+m mode "$mode_mark"
mode "$mode_mark" {
    # Automark mode
    bindsym a mode "$mode_automark"
    # Mark operation
    bindsym m                exec $SWAY_SCRIPT/sway_mark_operator.sh mark rofi none title_on; mode "default"
    bindsym u                exec $SWAY_SCRIPT/sway_mark_operator.sh unmark rofi none title_on; mode "default"
    bindsym apostrophe       exec $SWAY_SCRIPT/sway_mark_operator.sh show_then_goto rofi none title_on; mode "default"
    bindsym Shift+apostrophe exec $SWAY_SCRIPT/sway_mark_operator.sh show_then_goto rofi none title_off; mode "default"
    bindsym semicolon        exec $SWAY_SCRIPT/sway_mark_operator.sh show_then_swap rofi none title_on; mode "default"
    bindsym Shift+semicolon  exec $SWAY_SCRIPT/sway_mark_operator.sh show_then_swap rofi none title_off; mode "default"
    # Exit mode: "Enter", "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Return           mode "default"
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Automark mode (within mark mode)
# $mode_automark: label defined in sway_mode_name.config
mode "$mode_automark" {
    # Automark daemon
    bindsym e exec $SWAY_SCRIPT/sway_automark_operator.sh enable; mode "default"
    bindsym d exec $SWAY_SCRIPT/sway_automark_operator.sh disable; mode "default"
    bindsym r exec $SWAY_SCRIPT/sway_automark_operator.sh reload; mode "default"
    # Unmark automark
    bindsym u       exec $SWAY_SCRIPT/sway_mark_operator.sh unmark_all_automark
    bindsym Shift+u exec $SWAY_SCRIPT/sway_mark_operator.sh unmark_all_automark_and_remark
    # Back to mark mode: "Enter"
    bindsym Return mode "$mode_mark"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Window layout mode
# $mode_window_layout: label defined in sway_mode_name.config
bindsym Mod4+Shift+w mode "$mode_window_layout"
mode "$mode_window_layout" {
    # Autotiling mode
    bindsym a mode "$mode_autotiling"
    # Float current window and move it to center (and 4 corner)
    bindsym c exec $SWAY_SCRIPT/sway_window_operator.sh center_current
    bindsym u exec $SWAY_SCRIPT/sway_window_operator.sh move_floating_to_corner top_left
    bindsym i exec $SWAY_SCRIPT/sway_window_operator.sh move_floating_to_corner top_right
    bindsym j exec $SWAY_SCRIPT/sway_window_operator.sh move_floating_to_corner bottom_left
    bindsym k exec $SWAY_SCRIPT/sway_window_operator.sh move_floating_to_corner bottom_right
    # Show current window geometry
    bindsym w exec $SWAY_SCRIPT/sway_window_operator.sh show_geometry
    # Swap with master window (swap with biggest window or last slave window)
    bindsym p exec $I3_SCRIPT/i3_swap_master_window.py
    # Float/Tile window
    bindsym f floating enable
    bindsym t floating disable
    # Float/Tile all windows in current workspace
    bindsym Shift+f exec $SWAY_SCRIPT/sway_window_operator.sh float_all
    bindsym Shift+t exec $SWAY_SCRIPT/sway_window_operator.sh tile_all
    # Hide/Show window
    bindsym h move scratchpad
    bindsym s scratchpad show
    # Hide/Show all windows to/from scratchpad
    bindsym Shift+h exec $SWAY_SCRIPT/sway_window_operator.sh hide_all
    bindsym Shift+s exec $SWAY_SCRIPT/sway_window_operator.sh show_all_scratchpad
    # i3 keybindings compatibility: change layout
    bindsym Mod4+Shift+e layout toggle splitv splith tabbed stacking; exec "pgrep flashfocus && flash_window"
    # i3 keybindings compatibility: change layout
    bindsym Mod4+s layout stacking; exec "pgrep flashfocus && flash_window"
    bindsym Mod4+w layout tabbed; exec "pgrep flashfocus && flash_window"
    bindsym Mod4+e layout toggle splitv splith; exec "pgrep flashfocus && flash_window"
    # i3 keybindings compatibility: change split direction
    bindsym Mod4+v         split vertical; exec "pgrep flashfocus && flash_window"
    bindsym Mod4+Shift+v   split horizontal; exec "pgrep flashfocus && flash_window"
    bindsym Mod4+q         split toggle; exec "pgrep flashfocus && flash_window"
    bindsym Mod4+backslash split toggle; exec "pgrep flashfocus && flash_window"
    # i3 keybindings compatibility: fullscreen
    bindsym Mod4+f       fullscreen toggle
    bindsym Mod4+Shift+f fullscreen toggle global
    # i3 keybindings compatibility: floating and fulfill workspace
    bindsym Ctrl+Mod1+f exec $SWAY_SCRIPT/sway_window_operator.sh float_then_fulfill_workspace
    # i3 keybindings compatibility: move focused window
    bindsym Mod4+h focus left, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window
    bindsym Mod4+j focus down, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window
    bindsym Mod4+k focus up, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window
    bindsym Mod4+l focus right, exec $SWAY_SCRIPT/sway_cursor_operator.sh move_cursor_inside_window
    # i3 keybindings compatibility: move focus between output monitors (,/[/]/.)
    bindsym Mod4+comma        focus output left
    bindsym Mod4+bracketleft  focus output down
    bindsym Mod4+bracketright focus output up
    bindsym Mod4+period       focus output right
    # i3 keybindings compatibility: move window and focus between output monitors (</{/}/>)
    bindsym Mod4+Shift+comma        move container to output left; focus output left
    bindsym Mod4+Shift+bracketleft  move container to output down; focus output down
    bindsym Mod4+Shift+bracketright move container to output up; focus output up
    bindsym Mod4+Shift+period       move container to output right; focus output right
    # i3 keybindings compatibility: change focus between tiling/floating windows
    bindsym Mod4+space focus mode_toggle
    # i3 keybindings compatibility: toggle tiling/floating modes
    bindsym Mod4+Shift+space floating toggle
    # i3 keybinding compatibility: scratchpad
    bindsym Mod4+minus move scratchpad
    bindsym Mod4+equal  scratchpad show
    # i3 keybinding compatibility: scratchpad
    bindsym Mod4+Shift+minus [floating] move scratchpad
    bindsym Mod4+Shift+equal  [all] scratchpad show
    # i3 keybinding compatibility: Scratchpad
    bindsym Mod4+z move scratchpad
    bindsym Mod4+g scratchpad show
    # i3 keybinding compatibility: scratchpad
    bindsym Mod4+Shift+z [floating] move scratchpad
    bindsym Mod4+Shift+g [all] scratchpad show
    # i3 keybinding compatibility: kill window
    bindsym Mod4+Shift+q kill
    # Dunst compatibility: notification actions
    bindsym Ctrl+space            exec dunstctl close
    bindsym Ctrl+Shift+space      exec dunstctl history-pop
    bindsym Mod1+space            exec dunstctl close
    bindsym Mod1+Shift+space      exec dunstctl history-pop
    bindsym Ctrl+Mod1+Shift+space exec dunstctl action
    # Exit mode: "Enter", "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Return           mode "default"
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Autotiling mode (within window layout mode)
# -- Autotiling Script [https://github.com/nwg-piotr/autotiling]
# -- Installation: pip install autotiling
# $mode_autotiling: label defined in sway_mode_name.config
mode "$mode_autotiling" {
    # Autotiling - Dwindling
    bindsym 1 exec $SWAY_SCRIPT/sway_autotiling_operator.sh enable_dwindling; mode "default"
    # Autotiling - Master-stack (autotiling >= 1.8 is required)
    bindsym 2 exec $SWAY_SCRIPT/sway_autotiling_operator.sh enable_master_stack; mode "default"
    # Disable autotiling
    bindsym 0 exec $SWAY_SCRIPT/sway_autotiling_operator.sh disable_autotiling; mode "default"
    # Set default autotiling
    bindsym s mode "$mode_set_default_autotiling"
    # Back to window layout mode: "Enter"
    bindsym Return mode "$mode_window_layout"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Set default autotiling mode (within autotiling mode)
# $mode_set_default_autotiling: label defined in sway_mode_name.config
mode "$mode_set_default_autotiling" {
    bindsym 1 exec $SWAY_SCRIPT/sway_autotiling_operator.sh set_dwindling_as_default; exec $SWAY_SCRIPT/sway_autotiling_operator.sh enable_dwindling; mode "default"
    bindsym 2 exec $SWAY_SCRIPT/sway_autotiling_operator.sh set_master_stack_as_default; exec $SWAY_SCRIPT/sway_autotiling_operator.sh enable_master_stack; mode "default"
    bindsym 0 exec $SWAY_SCRIPT/sway_autotiling_operator.sh set_no_autotiling_as_default; exec $SWAY_SCRIPT/sway_autotiling_operator.sh disable_autotiling; mode "default"
    # Back to autotiling mode: "Enter"
    bindsym Return mode "$mode_autotiling"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Workspace mode
# $mode_workspace: label defined in sway_mode_name.config
bindsym Mod4+Shift+p mode "$mode_workspace"
mode "$mode_workspace" {
    # Save/Restore mode
    bindsym r mode "$mode_restore_workspace"
    bindsym s mode "$mode_save_workspace"
    # Current workspace operation
    bindsym n exec $SWAY_SCRIPT/sway_workspace_operator.sh rename_current; mode "default"
    bindsym k exec $SWAY_SCRIPT/sway_workspace_operator.sh kill_current; mode "default"
    # Input/Selected workspace operation
    bindsym Shift+k          exec $SWAY_SCRIPT/sway_workspace_operator.sh kill; mode "default"
    bindsym apostrophe       exec $SWAY_SCRIPT/sway_workspace_operator.sh goto; mode "default"
    bindsym Shift+apostrophe exec $SWAY_SCRIPT/sway_workspace_operator.sh goto_with_input; mode "default"
    #bindsym Escape           exec $SWAY_SCRIPT/sway_workspace_operator.sh move_container; mode "default"
    bindsym grave            exec $SWAY_SCRIPT/sway_workspace_operator.sh move_container; mode "default"
    bindsym Shift+grave      exec $SWAY_SCRIPT/sway_workspace_operator.sh move_container_with_input; mode "default"
    bindsym semicolon        exec $SWAY_SCRIPT/sway_workspace_operator.sh swap; mode "default"
    bindsym Shift+semicolon  exec $SWAY_SCRIPT/sway_workspace_operator.sh swap_with_input; mode "default"
    # Generate workspace name list for rofi selector
    bindsym Shift+r exec $SWAY_SCRIPT/sway_genereate_workspace_name_list.sh; reload
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Return           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Swap workspace mode (integrated with workspace mode)
# $mode_swap_workspace: label defined in sway_mode_name.config
bindsym Mod4+p mode "$mode_swap_workspace"
mode "$mode_swap_workspace" {
    # Swap interactively
    bindsym i       exec $SWAY_SCRIPT/sway_workspace_operator.sh swap; mode "default"
    bindsym Shift+i exec $SWAY_SCRIPT/sway_workspace_operator.sh swap_with_input; mode "default"
    # Swap first 40 workspaces with index
    bindsym Mod4+1   exec $SWAY_SCRIPT/sway_workspace_operator.sh swap_with_index 1; mode "default"
    bindsym Mod4+2   exec $SWAY_SCRIPT/sway_workspace_operator.sh swap_with_index 2; mode "default"
    bindsym Mod4+3   exec $SWAY_SCRIPT/sway_workspace_operator.sh swap_with_index 3; mode "default"
    bindsym Mod4+4   exec $SWAY_SCRIPT/sway_workspace_operator.sh swap_with_index 4; mode "default"
    bindsym Mod4+5   exec $SWAY_SCRIPT/sway_workspace_operator.sh swap_with_index 5; mode "default"
    bindsym Mod4+6   exec $SWAY_SCRIPT/sway_workspace_operator.sh swap_with_index 6; mode "default"
    bindsym Mod4+7   exec $SWAY_SCRIPT/sway_workspace_operator.sh swap_with_index 7; mode "default"
    bindsym Mod4+8   exec $SWAY_SCRIPT/sway_workspace_operator.sh swap_with_index 8; mode "default"
    bindsym Mod4+9   exec $SWAY_SCRIPT/sway_workspace_operator.sh swap_with_index 9; mode "default"
    bindsym Mod4+0   exec $SWAY_SCRIPT/sway_workspace_operator.sh swap_with_index 10; mode "default"
    bindsym Mod4+F1  exec $SWAY_SCRIPT/sway_workspace_operator.sh swap_with_index 11; mode "default"
    bindsym Mod4+F2  exec $SWAY_SCRIPT/sway_workspace_operator.sh swap_with_index 12; mode "default"
    bindsym Mod4+F3  exec $SWAY_SCRIPT/sway_workspace_operator.sh swap_with_index 13; mode "default"
    bindsym Mod4+F4  exec $SWAY_SCRIPT/sway_workspace_operator.sh swap_with_index 14; mode "default"
    bindsym Mod4+F5  exec $SWAY_SCRIPT/sway_workspace_operator.sh swap_with_index 15; mode "default"
    bindsym Mod4+F6  exec $SWAY_SCRIPT/sway_workspace_operator.sh swap_with_index 16; mode "default"
    bindsym Mod4+F7  exec $SWAY_SCRIPT/sway_workspace_operator.sh swap_with_index 17; mode "default"
    bindsym Mod4+F8  exec $SWAY_SCRIPT/sway_workspace_operator.sh swap_with_index 18; mode "default"
    bindsym Mod4+F9  exec $SWAY_SCRIPT/sway_workspace_operator.sh swap_with_index 19; mode "default"
    bindsym Mod4+F10 exec $SWAY_SCRIPT/sway_workspace_operator.sh swap_with_index 20; mode "default"
    bindsym Ctrl+F1  exec $SWAY_SCRIPT/sway_workspace_operator.sh swap_with_index 21; mode "default"
    bindsym Ctrl+F2  exec $SWAY_SCRIPT/sway_workspace_operator.sh swap_with_index 22; mode "default"
    bindsym Ctrl+F3  exec $SWAY_SCRIPT/sway_workspace_operator.sh swap_with_index 23; mode "default"
    bindsym Ctrl+F4  exec $SWAY_SCRIPT/sway_workspace_operator.sh swap_with_index 24; mode "default"
    bindsym Ctrl+F5  exec $SWAY_SCRIPT/sway_workspace_operator.sh swap_with_index 25; mode "default"
    bindsym Ctrl+F6  exec $SWAY_SCRIPT/sway_workspace_operator.sh swap_with_index 26; mode "default"
    bindsym Ctrl+F7  exec $SWAY_SCRIPT/sway_workspace_operator.sh swap_with_index 27; mode "default"
    bindsym Ctrl+F8  exec $SWAY_SCRIPT/sway_workspace_operator.sh swap_with_index 28; mode "default"
    bindsym Ctrl+F9  exec $SWAY_SCRIPT/sway_workspace_operator.sh swap_with_index 29; mode "default"
    bindsym Ctrl+F10 exec $SWAY_SCRIPT/sway_workspace_operator.sh swap_with_index 30; mode "default"
    bindsym Mod1+F1  exec $SWAY_SCRIPT/sway_workspace_operator.sh swap_with_index 31; mode "default"
    bindsym Mod1+F2  exec $SWAY_SCRIPT/sway_workspace_operator.sh swap_with_index 32; mode "default"
    bindsym Mod1+F3  exec $SWAY_SCRIPT/sway_workspace_operator.sh swap_with_index 33; mode "default"
    bindsym Mod1+F4  exec $SWAY_SCRIPT/sway_workspace_operator.sh swap_with_index 34; mode "default"
    bindsym Mod1+F5  exec $SWAY_SCRIPT/sway_workspace_operator.sh swap_with_index 35; mode "default"
    bindsym Mod1+F6  exec $SWAY_SCRIPT/sway_workspace_operator.sh swap_with_index 36; mode "default"
    bindsym Mod1+F7  exec $SWAY_SCRIPT/sway_workspace_operator.sh swap_with_index 37; mode "default"
    bindsym Mod1+F8  exec $SWAY_SCRIPT/sway_workspace_operator.sh swap_with_index 38; mode "default"
    bindsym Mod1+F9  exec $SWAY_SCRIPT/sway_workspace_operator.sh swap_with_index 39; mode "default"
    bindsym Mod1+F10 exec $SWAY_SCRIPT/sway_workspace_operator.sh swap_with_index 40; mode "default"
    # Back to workspace mode: "Enter"
    bindsym Return mode "$mode_workspace"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Save workspace mode (within workspace mode)
# $mode_save_workspace: label defined in sway_mode_name.config
mode "$mode_save_workspace" {
    # Save interactively (batch-open mode)
    bindsym i exec $SWAY_SCRIPT/sway_workspace_operator.sh save
    # Save current workspace
    bindsym s exec $SWAY_SCRIPT/sway_workspace_operator.sh save_current; mode "$mode_workspace"
    # Save all workspaces
    bindsym Shift+s exec $SWAY_SCRIPT/sway_workspace_operator.sh save_all; mode "$mode_workspace"
    # Back to workspace mode: "Enter"
    bindsym Return mode "$mode_workspace"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Restore workspace mode (within workspace mode)
# $mode_restore_workspace: label defined in sway_mode_name.config
mode "$mode_restore_workspace" {
    # Restore interactively
    bindsym i exec $SWAY_SCRIPT/sway_workspace_operator.sh restore
    # Restore current workspace
    bindsym r exec $SWAY_SCRIPT/sway_workspace_operator.sh restore_current; mode "$mode_workspace"
    # Restore all workspaces
    bindsym Shift+r exec $SWAY_SCRIPT/sway_workspace_operator.sh restore_all; mode "$mode_workspace"
    # Back to workspace mode: "Enter"
    bindsym Return mode "$mode_workspace"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# Open URL mode
# $mode_open_url: label defined in sway_mode_name.config
bindsym Ctrl+Mod1+o mode "$mode_open_url"
mode "$mode_open_url" {
    # Open bookmarks in new window
    bindsym 1 exec $BROWSER --new-window outlook.com
    bindsym 2 exec $BROWSER --new-window discord.com
    bindsym 3 exec $BROWSER --new-window notion.so
    #bindsym 4 exec $BROWSER --new-window chatgpt.com
    #bindsym 4 exec $BROWSER --new-window teams.microsoft.com/v2
    bindsym 4 exec firefox --new-window teams.microsoft.com/v2
    bindsym 5 exec $BROWSER --new-window github.com
    bindsym 6 exec $BROWSER --new-window youtube.com
    bindsym 7 exec $BROWSER --new-window new.reddit.com
    bindsym 8 exec $BROWSER --new-window open.spotify.com
    bindsym 9 exec $BROWSER --new-window netflix.com/browse
    # Open bookmark 1~3 in new window
    #bindsym 0 exec $BROWSER --new-window outlook.com discord.com teams.microsoft.com/v2 notebooklm.google.com
    bindsym 0 exec firefox outlook.com discord.com teams.microsoft.com/v2 notebooklm.google.com
    # Open bookmarks in new incognito window
    bindsym Shift+1 exec $BROWSER --incognito --new-window outlook.com
    bindsym Shift+2 exec $BROWSER --incognito --new-window discord.com
    bindsym Shift+3 exec $BROWSER --incognito --new-window notion.so
    #bindsym Shift+4 exec $BROWSER --incognito --new-window chatgpt.com
    #bindsym Shift+4 exec $BROWSER --incognito --new-window teams.microsoft.com/v2
    bindsym Shift+4 exec firefox --private-window --new-window teams.microsoft.com/v2
    bindsym Shift+5 exec $BROWSER --incognito --new-window github.com
    bindsym Shift+6 exec $BROWSER --incognito --new-window youtube.com
    bindsym Shift+7 exec $BROWSER --incognito --new-window new.reddit.com
    bindsym Shift+8 exec $BROWSER --incognito --new-window open.spotify.com
    bindsym Shift+9 exec $BROWSER --incognito --new-window netflix.com/browse
    # Open URL in new window
    bindsym o exec $BROWSER --new-window $(rofi -dmenu -p "Open URL")
    # Open URL in new incognito window
    bindsym Shift+o exec $BROWSER --incognito --new-window $(rofi -dmenu -p "Open URL in incognito mode")
    # AI Assistant Mode
    bindsym a mode "$mode_ai"
    # Research Mode
    bindsym r mode "$mode_research"
    # C-LINK Mode
    # [SWAY] Disabled: $mode_clink is never defined in the i3 config either (pre-existing bug,
    #        see i3/doc/workflow/I3_WORKFLOW_FSM.md). Define the mode, then re-enable.
    #bindsym c mode "$mode_clink"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Return           mode "default"
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# $mode_ai: label defined in sway_mode_name.config
mode "$mode_ai" {
    bindsym 1 exec $BROWSER --new-window chatgpt.com
    bindsym 2 exec $BROWSER --new-window claude.ai
    bindsym 3 exec $BROWSER --new-window gemini.google.com
    bindsym 4 exec $BROWSER --new-window perplexity.ai
    bindsym 5 exec $BROWSER --new-window grok.com
    #bindsym 6 exec $BROWSER --new-window chat.deepseek.com
    bindsym 6 exec $BROWSER --new-window deepwiki.org
    bindsym 7 exec $BROWSER --new-window notebooklm.google.com
    bindsym 8 exec $BROWSER --new-window aistudio.google.com
    # Open 1~3 in new window
    bindsym 0 exec $BROWSER --new-window chatgpt.com claude.ai gemini.google.com
    # Back to URL mode: "Enter"
    bindsym Return mode "$mode_open_url"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}

# $mode_research: label defined in sway_mode_name.config
mode "$mode_research" {
    # Website
    #bindsym 1 exec $BROWSER --new-window mendeley.com
    bindsym 1 exec $BROWSER --new-window connectedpapers.com
    bindsym 2 exec $BROWSER --new-window scholar.google.com
    bindsym 3 exec $BROWSER --new-window arxiv.org
    bindsym 4 exec $BROWSER --new-window sci-hub.se
    bindsym 5 exec $BROWSER --new-window huggingface.co/papers
    bindsym 6 exec $BROWSER --new-window kaggle.com
    bindsym 7 exec $BROWSER --new-window researchgate.net
    bindsym 8 exec $BROWSER --new-window paperswithcode.com
    bindsym 9 exec $BROWSER --new-window deeplearn.org
    bindsym 0 exec $BROWSER --new-window ollama.com
    # Back to URL mode: "Enter"
    bindsym Return mode "$mode_open_url"
    # Exit mode: "Escape" or "Ctrl"+"[" (vim-like Escape)
    bindsym Escape           mode "default"
    bindsym Ctrl+bracketleft mode "default"
}
