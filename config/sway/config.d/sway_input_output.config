# ~/.config/sway/config.d/sway_input_output.config
# vim: ft=swayconfig ff=unix
# ======================================================================================
# All About Input/Output Settings  [SWAY-only section]
# ======================================================================================
# Under X11 these settings were done by separate tools started from i3_startup.config.
# sway configures inputs/outputs itself, so they become declarative config here:
#
#   X11 tool                              sway equivalent
#   ------------------------------------  ------------------------------------------------
#   xrandr / arandr / autorandr           output <name> {...}, wdisplays, kanshi
#   setxkbmap -option ctrl:nocaps         input type:keyboard xkb_options ctrl:nocaps
#   xset r rate 220 50                    input type:keyboard repeat_delay/repeat_rate
#   numlockx on                           input type:keyboard xkb_numlock enabled
#   xset m 2/1 4 (pointer acceleration)   input type:pointer accel_profile/pointer_accel
#   imwheel -b 45 (wheel speed)           input type:pointer scroll_factor
#   unclutter --timeout 3                 seat * hide_cursor 3000
#   libinput-gestures + xdotool           bindgesture (native, sway >= 1.8)
#   xinput map-to-output                  input <id> map_to_output <output>
#
# Inspect devices:  swaymsg -t get_inputs   |  swaymsg -t get_outputs

# --------------------------------------------------------------------------------------
# Outputs
# --------------------------------------------------------------------------------------
# Unconfigured outputs are enabled automatically at their preferred mode, left-to-right.
# Example (uncomment and adapt; names from `swaymsg -t get_outputs`):
#output eDP-1 {
#    mode 1920x1080@60Hz
#    position 0 0
#    scale 1
#}
#output HDMI-A-1 {
#    mode 1920x1080@60Hz
#    position 1920 0
#}
# Laptop lid: disable the internal panel while the lid is closed (clamshell)
bindswitch --reload --locked lid:on  output eDP-1 disable
bindswitch --reload --locked lid:off output eDP-1 enable
# Automatic per-location layouts (i3_display_operator.sh auto_in_office/auto_at_home)
# are best done with kanshi: see doc/03_X11_TO_WAYLAND_CHANGES.md (kanshi section).

# --------------------------------------------------------------------------------------
# Keyboard (equivalent of i3_keyboard_operator.sh default + numlockx)
# --------------------------------------------------------------------------------------
input type:keyboard {
    xkb_layout us
    xkb_options ctrl:nocaps
    repeat_delay 220
    repeat_rate 50
    xkb_numlock enabled
}
# NOTE: "Shift+Escape -> asciitilde" (xmodmap keycode 9 = Escape asciitilde) has no xkb
#       option; sway_keyboard_operator.sh default applies it at startup.

# --------------------------------------------------------------------------------------
# Pointer / touchpad (equivalent of xset m 2/1 4, imwheel -b 45, xserver libinput)
# --------------------------------------------------------------------------------------
input type:pointer {
    accel_profile adaptive
    pointer_accel 0.3
    scroll_factor 1.5
}
input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt enabled
    middle_emulation enabled
    scroll_factor 1.0
}

# --------------------------------------------------------------------------------------
# Cursor
# --------------------------------------------------------------------------------------
# unclutter --timeout 3 --start-hidden  ->  native cursor hiding
# (sway_cursor_operator.sh set_unclutter_as_default / set_no_unclutter_as_default edit
#  the next line: 3000 = enabled, 0 = disabled)
seat * hide_cursor 3000
seat * hide_cursor when-typing enable
# Cursor theme for Wayland clients (X11 used Xresources/xsettingsd for this)
seat * xcursor_theme default 24

# --------------------------------------------------------------------------------------
# Touchpad gestures (replaces config/libinput-gestures.conf, which used xdotool)
# --------------------------------------------------------------------------------------
# Same actions as the libinput-gestures config, called directly instead of faking keys.
# 3 fingers
bindgesture swipe:3:left  exec $SWAY_SCRIPT/sway_automark_operator.sh cycle_focus_dec
bindgesture swipe:3:right exec $SWAY_SCRIPT/sway_automark_operator.sh cycle_focus_inc
bindgesture swipe:3:up    fullscreen toggle
bindgesture swipe:3:down  floating toggle
bindgesture swipe:3:left+up    exec wtype -M ctrl -M shift -k Tab -m shift -m ctrl
bindgesture swipe:3:left+down  exec wtype -M ctrl -M shift -k Tab -m shift -m ctrl
bindgesture swipe:3:right+up   exec wtype -M ctrl -k Tab -m ctrl
bindgesture swipe:3:right+down exec wtype -M ctrl -k Tab -m ctrl
# 4 fingers
bindgesture swipe:4:left  exec $I3_SCRIPT/i3_new_workspace.sh move_focus prev
bindgesture swipe:4:right exec $I3_SCRIPT/i3_new_workspace.sh move_focus next
bindgesture swipe:4:up    scratchpad show
bindgesture swipe:4:down  move scratchpad
bindgesture swipe:4:left+up    workspace prev
bindgesture swipe:4:left+down  workspace prev
bindgesture swipe:4:right+up   workspace next
bindgesture swipe:4:right+down workspace next
# Hold
bindgesture hold:3 exec $SWAY_SCRIPT/sway_window_operator.sh toggle_sticky_current
bindgesture hold:4 bar hidden_state toggle bar_status
# NOTE: the 2-finger pinch -> Ctrl+minus/equal rules are intentionally NOT bound: on Wayland,
#       browsers and viewers receive pinch gestures natively (smooth zoom), and binding
#       pinch:2 in sway would steal them from every application.
