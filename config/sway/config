# ~/.config/sway/config
# vim: ft=swayconfig ff=unix
# ======================================================================================
# SwayWM configuration (converted from ~/.config/i3/config)
# ======================================================================================
# This configuration mirrors the i3 configuration in ../i3 section by section.
# Every place where sway differs from i3 is marked with a "[SWAY]" comment, and the full
# conversion record lives in ./doc/ (start with doc/00_MIGRATION_OVERVIEW.md).
#
# Please see `man 5 sway`, `man 5 sway-input`, `man 5 sway-output`, `man 5 sway-bar`.
#
# --------------------------------------------------------------------------------------
# Author: Jordan Kuan-Hsien Wu
# Email:  jordankhwu@gmail.com
# Date:   2021/12/24 (i3), migrated to sway 2026/11/07
# --------------------------------------------------------------------------------------

# ======================================================================================
# All About Variables
# ======================================================================================
# Set variables
# PLEASE DO NOT MOVE/REMOVE LINES IN THIS SECTION UNLESS YOU KNOW WHAT YOU ARE DOING !!!
# (sway_default_valuechanger.sh edits the `set $default_*` lines below in place)

# Script directories
# [SWAY] i3 relied on $I3_SCRIPT exported from ~/.profile. Display managers start sway
#        without a login shell (and fish never reads ~/.profile), so both paths are also
#        defined here. Scripts that only talk i3 IPC are shared from the i3 directory
#        (sway exports I3SOCK, so i3-msg/i3ipc work unchanged); X11-dependent ones have
#        Wayland ports in the sway directory.
set $I3_SCRIPT   $HOME/.config/i3/script
set $SWAY_SCRIPT $HOME/.config/sway/script

# Set monitor order according to frequent-usage priority
# If the monitor does not exist, workspaces will just spawn in current monitor
# [SWAY] Output names come from DRM, not from the X driver:
#        X (nvidia) HDMI-0 -> HDMI-A-1, X DP-1 -> DP-1, eDP1 -> eDP-1, VIRTUAL1 -> HEADLESS-1.
#        List yours with: swaymsg -t get_outputs
set $monitor1 DP-1
set $monitor2 HDMI-A-1
set $monitor3 DP-2
set $monitor4 HEADLESS-1
set $monitor5 HEADLESS-2

# Set font (RECOMMENDED: DroidSansMono Nerd Font Bold)
set $default_font Operator-caska

# Set terminal (RECOMMENDED: kitty)
# kitty runs natively on Wayland; `--class X` sets the Wayland app_id to X.
set $terminal kitty

# Set i3bar fontsize (RECOMMENDED: 12)  [SWAY] applies to swaybar
set $default_i3bar_fontsize 14

# Set i3bar height (RECOMMENDED: 25)  [SWAY] applies to swaybar
set $default_i3bar_height 30

# Set i3bar show-up mode (RECOMMENDED: dock, AVAIL: dock/hdie)
set $default_i3bar_mode dock

# Set i3bar position (RECOMMENDED: top, AVAIL: top/bottom)
set $default_i3bar_position top

# Set titlebar fontsize (RECOMMENDED: 12)
set $default_titlebar_fontsize 15

# Set window titlebar style (set normal/pixel to show/hide titlebar)
set $default_titlebar_style pixel
set $default_floating_titlebar_style pixel

# Set border width (set pixel number of border width)
set $default_border_width 5

# Set gap width
set $default_inner_gap 0
set $default_outer_gap 10

# Set default conky startup (enable/disable)
set $default_conky_startup disable

# Set default conky location (for both system monitor and bindkey cheatsheet)
set $default_conky_system_alignment top_right
set $default_conky_bindkey_alignment bottom_left

# Set default conky gap_y to avoid being blocked by swaybar (RECOMMEMDED: 30)
set $default_conky_gap_y 30

# Set default conky gap opacity (RECOMMENDED: 64, AVAIL: 0-256)
set $default_conky_opacity 64

# [SWAY] Set input method framework (RECOMMENDED on sway: fcitx5, AVAIL: ibus/fcitx5)
# -- Switch with: sway_input_method.sh use ibus|fcitx5  (rewrites this line and
#    ~/.config/environment.d/60-sway-input-method.conf; log out and back in afterwards)
set $default_input_method fcitx5

# [SWAY] Set screenshot tool for PrtScn (RECOMMENDED on sway: grim, AVAIL: grim/flameshot)
# -- grim = grim + slurp + swappy/satty (wlroots-native); flameshot = flameshot daemon + gui
set $default_screenshot_tool grim

# ======================================================================================
# All About Color Template
# ======================================================================================
# [SWAY] sway has no `set_from_resource` (no X resource database). Colors come from:
#   1. ./share/colors-sway-fallback  - the same fallback values the i3 config used
#   2. ~/.cache/wal/colors-sway-i3   - generated by pywal from the user template
#                                      ./share/wal_templates/colors-sway-i3 (installed to
#                                      ~/.config/wal/templates/ by the install script).
#      Later `set` lines win, so pywal colors override the fallback when present.
#      A missing file is silently skipped by sway's `include`.
# NOTE: like i3, colors are read when the config is parsed. After wal generates a new
#       palette, run `swaymsg reload` (sway_wal_operator.sh does this for you).

# Startup-Wal (DO NOT MOVE current and following line unless you know what you are doing)
# [SWAY] -n: do not let wal set the wallpaper with feh; sway sets it below via swaybg.
exec wal --nine -n -s -t -i $HOME/.config/i3/share/default_wallpaper

# Default wallpaper (feh -> swaybg, managed by sway itself)
output * bg $HOME/.config/i3/share/default_wallpaper fill
# Re-apply the wallpaper chosen at runtime (swaybg cannot be queried; `reload` would
# otherwise reset it to the default above). State: ~/.cache/sway_wallpaper
exec_always $SWAY_SCRIPT/sway_wallpaper_operator.sh feh restore_last

include ./share/colors-sway-fallback
include ~/.cache/wal/colors-sway-i3

# Set transparency mannually
set $transp #00000000

# ======================================================================================
# All About Input/Output Settings
# ======================================================================================
# [SWAY] New section: replaces xrandr, setxkbmap, xset, xinput, numlockx, imwheel,
#        unclutter and libinput-gestures, all of which are X11 tools.

include ./config.d/sway_input_output.config

