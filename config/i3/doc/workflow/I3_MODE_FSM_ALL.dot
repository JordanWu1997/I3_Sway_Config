digraph I3ModeFSM {
graph [label="i3 mode state machine — all 103 defined modes (generated by tools/gen_mode_fsm.py)",labelloc=t,fontsize=30,fontname="DejaVu Sans",rankdir=LR,ranksep=0.8,nodesep=0.25,splines=polyline,pad=0.25];
node [shape=box,style="rounded,filled",fontname="DejaVu Sans",fontsize=14,margin="0.12,0.08",color="#64748b"];
edge [fontname="DejaVu Sans",fontsize=12,color="#2563eb"];
default [label="default\nnormal i3 bindings",shape=oval,fillcolor="#bfdbfe",penwidth=2];
rofi [label="Rofi dialog\nEsc: close/back\nOmnisearch Alt+B: Search",shape=note,fillcolor="#e9d5ff"];
