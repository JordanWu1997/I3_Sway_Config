# ~/.config/sway/config.d/sway_mode_name.config
# vim: ft=swayconfig ff=unix
# ======================================================================================
# All About Mode Names  [SWAY-only file]
# ======================================================================================
# [SWAY] i3 substitutes $variables in a pre-pass over the whole config, so a binding may
#        reference a mode variable that is `set` further down. sway substitutes line by
#        line, using the LONGEST variable defined SO FAR: `mode "$mode_gaps_outer"` read
#        before `set $mode_gaps_outer` would expand `$mode_gaps` + "_outer" and bind a
#        non-existent mode. All mode names are therefore defined here, before any binding.
# The mode blocks keep a comment pointing here. Edit the label text in this file.

# --------------------------------------------------------------------------------------
# from sway_gap.config
# --------------------------------------------------------------------------------------
set $mode_gaps Gaps: [o]uter [i]nner [h]orizontal [v]ertical [t]op [r]ight [b]ottom [l]eft [s]et_default_inner_gap [S]et_default_outer_gap [g]ap_option
set $mode_gaps_inner Inner Gaps (add [Shift] prefix for global): [+/-]:increase/decrease 5 pix [0]:set to 0 pix [d]:set to default
set $mode_gaps_outer Outer Gaps (add [Shift] prefix for global): [+/-]:increase/decrease 5 pix [0]:set to 0 pix [d]:set to default
set $mode_gaps_horiz Horizontal (left and right) Gaps: (add [Shift] prefix for global): [+/-]:increase/decrease 5 pix [0]:set to 0 pix [d]:set to default
set $mode_gaps_verti Vertical (top and bottom) Gaps: (add [Shift] prefix for global): [+/-]:increase/decrease 5 pix [0]:set to 0 pix [d]:set to default
set $mode_gaps_top Top Gaps (add [Shift] prefix for global): [+/-]:increase/decrease 5 pix [0]:set to 0 pix [d]:set to default
set $mode_gaps_right Right Gaps (add [Shift] prefix for global): [+/-]:increase/decrease 5 pix [0]:set to 0 pix [d]:set to default
set $mode_gaps_bottom Bottom Gaps (add [Shift] prefix for global): [+/-]:increase/decrease 5 pix [0]:set to 0 pix [d]:set to default
set $mode_gaps_left Left Gaps (add [Shift] prefix for global): [+/-]:increase/decrease 5 pix [0]:set to 0 pix [d]:set to default
set $mode_set_outer_gap Set outer gap width pixel value (add [Shift] prefix for negative value): [1]:5pix [2]:10pix [3]:15pix [4]:20pix [5]:25pix [6]:30pix [7]:35pix [8]:40pix [9]:45pix [0]:0pix [i]nput
set $mode_set_inner_gap Set inner gap width pixel value (add [Shift] prefix for negative value): [1]:5pix [2]:10pix [3]:15pix [4]:20pix [5]:25pix [6]:30pix [7]:35pix [8]:40pix [9]:45pix [0]:0pix [i]nput
set $mode_gap_option Gap option: [1]:smart_gaps_on [2]:smart_gaps_inverse_outer [3]:smart_gaps_off

# --------------------------------------------------------------------------------------
# from sway_mode.config
# --------------------------------------------------------------------------------------
set $mode_insert Insert: i3 keys off, all keys go to the app · Back to i3: Ctrl+Alt+i, Super+Ctrl+i or Ctrl+[
set $mode_vim_keybinding Vim keybindings: [h/j/k/l]:L/D/U/R [g/G]:Home/End [Ctrl+d/u]:PageDown/PageUp [d/i]:Delete/Insert [Ctrl+[]:Escape keybinding mode
set $mode_mouse Mouse: [p]reference [m]agnifier [Ctrl/NONE/Alt/(Ctrl+Alt)+{h/j/k/l}/{[/,/./]}]:S/M/L/(XS/XL) {Move/Scroll L/D/U/R} [g/y]:Thumb 1/2 [Ctrl/NONE/Alt+u/i/o]:click&hold/click/release L/M/R
set $mode_cursor_preference Cursor: [1/2]:auto-hiding (unclutter) on/off [3/4]:set auto-hiding/no-auto-hiding_as_default [5/6]:focus_follows_mouse on/off [7/8]:mouse_follows_focus on/off
set $mode_system System: [b]luetooth [n]etwork [r]adio_blocks [d]isplay [t]erminal [k]ill [s]tatus [R]eboot [P]oweroff [S]uspend [H]ibernate [E]xit [(Shift)+l]:lock (and_screen_off)
set $mode_RF_device Radio blocks: [1]:clear soft block [2]:set soft block
set $mode_network Network: [1/2]:activate/disconnect saved connection (Ethernet/Wi-Fi/VPN) [3/4]:enable/disable Wi-Fi [5/6]:enable/disable all networking [r]eload_nm-applet
set $mode_bluetooth Bluetooth: [1/2/3]:connect/disconnect/reconnect device [4/5]:discoverable on/off [6/7]:power on/off [0]:blueman-manager
set $mode_terminal Terminal: [1]:gnome-terminal [2]:kitty [3]:alacritty [4]:rxvt-unicode (XWayland) [5]:xterm (XWayland) [6]:foot [0]:i3-sensible-terminal [s]et_default_terminal
set $mode_toolkit Toolkit: [c]apture [s]creenshot [r]ecording [k]eyboard [l]ocalSend [C]affeine [K]deconnect [R]eload [t]ool (miscellaneous)
set $mode_capture Capture: [1]:pickup_color [2]:get_screenshot_text [3]:get_screenshot_qrcode [s]creenshot [r]ecording
set $mode_screenshot Screenshot (prepend [Shift] to hide titlebar/border): [1]:select_window [2]:active_window [3]:current_screen [4]:full (all screens) [0]:GUI (grim+slurp+satty/swappy, or flameshot if selected)
set $mode_recording Recording Tool: [1]:wf-recorder region start/stop [2]:wf-recorder output start/stop [3]:showmethekey (screenkey)
set $mode_misc_tool Misc Tool: [1]:translate_clip [2]:collect_all_instances [3]:test_audio_I/O [4]:kill_window [5]:show_brave_browser [6]:zoom (woomer)
set $mode_caffeine Caffeine: [1]:enable_caffeine [2]:disable_caffeine [s]et_default_caffeine
set $mode_set_default_caffeine Set default caffeine [1]:enable_at_startup [2]:disable_at_startup
set $mode_keyboard Keyboard: [n]on-hhkb [h]hkb [t]ex [r]estore_keyboard_layout [Ctrl+Alt+l/n]:Send CapsLock/NumLock [1/2]:Speed-up/Reset repeat key rate [0]:default
set $mode_tool_reload Reload: [1]:reload_clipboard_manager (cliphist) [2]:reload_ibus_daemon [3]:reload_libinput_gestures (sway: native bindgesture)
set $mode_non_HHKB non-HHKB: [1/2]:Map/Swap Capslock to/with Ctrl [3/4]:Swap/Restore Backslash with/and Backspace [0]:Restore Capslock
set $mode_HHKB HHKB: [1/2]:Swap/Restore Esc with/and Grave [3]:Map Shift+Esc to Tilde (Shift+Grave) [0]:Swap ^Esc KBs with ^Grave KBs
set $mode_TEX TEX: [1/2]:Customize/Restore TEX Shinobi [3/4]:Enable/Disable Trackpoint
set $mode_kdeconnect KDE Connect: [1/2]:kdeconnect_pointer_daemon on/off [3/4]:invert_pointer_color on/off [5]:reload_kdeconnect
set $mode_display Display: [a]:wdisplays [p]reset [d]isplay_layout [1]:position [2]:mode [3]:primary [4]:orientation [5]:scale [6]:map_input_to_output
set $mode_display_preset Display Preset: [e]:eDP1 [h]:HDMI1 [1]:auto_in_office [2]:auto_at_home [3/4]:Joint (HDMI1+eDP1/eDP1+HDMI1) [5]:Mirror (eDP1&HDMI) [0]:auto
set $mode_eDP1 eDP1: [a]uto [o]ff [p]rimary [1]:1440x810 [2]:1368x768 [0]:1920x1080
set $mode_HDMI1 HDMI1: [a]uto [o]ff [p]rimary [1]:1912x960 [2]:1920x1200 [0]:1920x1080
set $mode_backlight Backlight: [r/z]:night_light (gammastep) [(Shift)+i]:input [(Shift)+x]:brightnessctl [Ctrl/NONE/Alt+-/+]:1%/5%/10% decrease/increase [Ctrl/(Ctrl+Alt)/Alt+Shift+0]:set to 0.1%/50%/100%
set $mode_redshift Night light (gammastep): [i]nput [1]:2000K [2]:2500K [3]:3000K [4]:3500K [5]:4000K [6]:4500K [7]:5000K [8]:5500K [9]:6000K [0]:off
set $mode_dunst Dunst (notification daemon): [l]ogger [(Shift)+c]:close (all) notification [o]pen_context [h]istory-pop [s]tatus [p]ause_dunst [r]esume_dunst [R]eload_dunst
set $mode_dunst_logger Logger: [s]tatus [h]istory [e]nable_logger [d]isable_logger
set $mode_player Player: [i]nput [o]utput [s]potifyd [M]pv [P/p]laying [{Ctrl+Alt}/Ctrl/NONE/Alt+(Shift)+j/k/l]:{selector}/spotify/current/mpv|vlc (prev)/-10s/(stop)/play-pause/(next)/+10s [Ctrl+Alt+Shift+Space]:stop all
set $mode_spotifyd Spotifyd: [p]laying [s]tatus [e]nable [d]isable [a]ttach_spotifyd_to_spt [r]eload [R]eload_attach_spotifyd_to_spt [1/2]:repeat track/all
set $mode_mpv Mpv: [p]laylist
set $mode_audio_output Audio Output: [s]et_volume [v]olume [p]ulsemixer [a]lsamixer [c]heck_speaker [m]ute_toggle [Ctrl/NONE/Alt+-/+]:1%/5%/10% decrease/increase
set $mode_audio_input Audio Input: [s]et_volume [v]olume [p]ulsemixer [a]lsamixer [c]heck_microphone [r]ecord [t]est_IO [m]ute_toggle [Ctrl/NONE/Alt+-/+]:1%/5%/10% decrease/increase
set $mode_resize Resize: [w]indow_layout [i/I]nput [Ctrl/NONE/Alt+(vim-key)]:S/M/L step (left/down/up/right) [Win+Shift+(vim-key)]:move (left/down/up/right)
set $mode_titlebar Titlebar: [n]ew_name [r]estore_default_title [s]how_all_titles [h]ide_all_titles [t]oggle_all_titles [f]ontsize [T]itlebar_style
set $mode_titlebar_fontsize Titlebar fontsize: [1]:8pix [2]:9pix [3]:10pix [4]:11pix [5]:12pix [6]:13pix [7]:14pix [8]:15pix [9]:16pix [0]:0pix [i]nput
set $mode_titlebar_style Titlebar style: [1/2]:tiling_window normal/pixel (enable/disable titlebar) [3/4]:floating_window normal/pixel (enable/disable titlebar)
set $mode_mark Mark: [a]utomark [m]ark [u]nmark [(Shift)+single-quote/semicolumn]:(do not show titlebar but) go_to/swap_with marked window
set $mode_automark Automark: [e]nable_automark_daemon [d]isable_automark_daemon [r]eload_automark_daemon [(Shift)+u]:unmark_all_automark (and remark)
set $mode_window_layout Window layout: [a]utotiling [w]indow_geometry [c/u/i/j/k]:floating_location [p]:swap_with_master_window [(Shift)+f/t]:float/tile (all) window [(Shift)+h/s]:hide/show (all) window
set $mode_autotiling Autotiling: [1]:enable_dwindling_layout [2]:enable_master-stack_layout [0]:disable_autotiling [s]et_default_autotiling
set $mode_set_default_autotiling Set default autotiling [1]:dwindling_layout [2]:master-stack_layout [0]:no_autotiling
set $mode_workspace Workspace: [s]ave [r]estore [n]ew_name [(Shift)+k]:(save_and) kill [(Shift)+single-quote/grave/semicolon]:go_to/move_window_to/swap_with [R]eload_name_for_rofi
set $mode_swap_workspace Swap workspace: [(Shift)+i]:interactive [Win+1~0]:A1~A0 (1~10) [Win+F1~F10]:B1~B0 (11~20) [Ctrl+F1~F10]:C1~C0 (21~30) [Alt+F1~F10]:D1~D0 (31~40) [Enter]:workspace_mode
set $mode_save_workspace Save workspace: [i]nteractively_select_workspace [s]ave_current_workspace [S]ave_all_workspaces
set $mode_restore_workspace Restore workspace: [i]nteractively_select_workspace [r]estore_current_workspace [R]estore_all_workspaces
set $mode_open_url Open [batch, Enter/Esc exit, Shift private]: [1]:outlook [2]:discord [3]:notion [4]:teams [5]:github [6]:youtube [7]:reddit [8]:spotify [9]:netflix [o]pen_URL [a]i [r]esearch [c]link
set $mode_ai AI [batch, Enter back, Esc exit]: [1]:chatGPT [2]:claude [3]:gemini [4]:perplexity [5]:grok [6]:deepwiki [7]:notebooklm [8]:aistudio
set $mode_research Research [batch, Enter back, Esc exit]: [1]:connected_papers [2]:google_scholar [3]:arXiv [4]:sci-hub [5]:hugging_face [6]:kaggle [7]:research_gate [8]:paper_with_code [9]:deeplearn.org [0]:ollama

# --------------------------------------------------------------------------------------
